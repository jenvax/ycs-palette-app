  "sections": {
    "cutom_html_Vdiah7": {
      "type": "cutom-HTML",
      "name": "Custom HTML",
      "settings": {
        "title": "",
        "custom_HTML": "<section class=\"ycs-cert-page\">\n  <style>\n    .ycs-cert-page {\n      --navy: #12253f;\n      --text: #222;\n      --muted: #666;\n      --line: #e9e9e9;\n      --soft: #f7f7f7;\n      --pink: #ef4f78;\n      --teal: #68a9b8;\n      --cream: #fafafa;\n      --max: 1280px;\n      font-family: \"Helvetica Neue\", Arial, sans-serif;\n      color: var(--text);\n      background: #fff;\n    }\n\n    .ycs-cert-page * {\n      box-sizing: border-box;\n    }\n\n    .ycs-cert-wrap {\n      max-width: var(--max);\n      margin: 0 auto;\n      padding: 0 24px;\n    }\n\n    .ycs-cert-section {\n      padding: 88px 0;\n      border-top: 1px solid var(--line);\n    }\n\n    .ycs-cert-hero {\n      padding: 42px 0 74px;\n      border-top: 0;\n    }\n\n    .ycs-cert-soft {\n      background: var(--soft);\n    }\n\n    .ycs-cert-cream {\n      background: var(--cream);\n    }\n\n    .ycs-cert-grid,\n    .ycs-cert-two {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 52px;\n      align-items: center;\n    }\n\n    .ycs-cert-eyebrow {\n      display: inline-block;\n      margin-bottom: 12px;\n      color: var(--pink);\n      font-size: .78rem;\n      font-weight: 800;\n      letter-spacing: .17em;\n      text-transform: uppercase;\n    }\n\n    .ycs-cert-page h1,\n    .ycs-cert-page h2,\n    .ycs-cert-page h3 {\n      margin: 0 0 18px;\n      color: var(--navy);\n      font-family: Georgia, \"Times New Roman\", serif;\n      line-height: 1.04;\n      letter-spacing: -.02em;\n    }\n\n    .ycs-cert-page h1 {\n      font-size: clamp(2.7rem, 5vw, 5.4rem);\n      line-height: .98;\n      letter-spacing: -.04em;\n    }\n\n    .ycs-cert-page h2 {\n      font-size: clamp(2rem, 4vw, 3.2rem);\n    }\n\n    .ycs-cert-page h3 {\n      font-size: clamp(1.35rem, 2vw, 1.75rem);\n    }\n\n    .ycs-cert-page p {\n      margin: 0 0 18px;\n      font-size: 1.08rem;\n      line-height: 1.7;\n    }\n\n    .ycs-muted {\n      color: var(--muted);\n    }\n\n    .ycs-cert-badges {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 10px;\n      margin-bottom: 22px;\n    }\n\n    .ycs-cert-badge {\n      padding: 8px 14px;\n      border-radius: 999px;\n      background: #fcf0f4;\n      color: var(--navy);\n      font-size: .82rem;\n      font-weight: 800;\n    }\n\n    .ycs-cert-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 14px;\n      margin-top: 28px;\n    }\n\n    .ycs-btn {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 58px;\n      padding: 0 26px;\n      border-radius: 999px;\n      text-decoration: none;\n      font-size: .92rem;\n      font-weight: 800;\n      letter-spacing: .08em;\n      text-transform: uppercase;\n      text-align: center;\n      transition: transform .18s ease, box-shadow .18s ease;\n    }\n\n    .ycs-btn:hover {\n      transform: translateY(-2px);\n    }\n\n    .ycs-btn-primary {\n      background: var(--pink);\n      color: #fff;\n      border: 2px solid var(--pink);\n      box-shadow: 0 14px 30px rgba(239, 79, 120, .18);\n    }\n\n    .ycs-btn-secondary {\n      background: var(--teal);\n      color: #fff;\n      border: 2px solid var(--teal);\n      box-shadow: 0 14px 30px rgba(104, 169, 184, .18);\n    }\n\n    .ycs-btn-outline {\n      background: #fff;\n      color: var(--navy);\n      border: 2px solid var(--navy);\n    }\n\n    .ycs-cert-hero-img,\n    .ycs-cert-shot img {\n      width: 100%;\n      height: auto;\n      display: block;\n      border-radius: 24px;\n      box-shadow: 0 18px 52px rgba(18, 37, 63, .08);\n    }\n\n    .ycs-cert-card,\n    .ycs-cert-panel,\n    .ycs-cert-quote,\n    .ycs-cert-shot {\n      background: #fff;\n      border: 1px solid var(--line);\n      border-radius: 26px;\n      padding: 30px;\n      box-shadow: 0 12px 32px rgba(18, 37, 63, .035);\n    }\n\n    .ycs-cert-cards-3 {\n      display: grid;\n      grid-template-columns: repeat(3, 1fr);\n      gap: 18px;\n      margin-top: 34px;\n    }\n\n    .ycs-cert-card strong {\n      display: block;\n      margin-bottom: 10px;\n      color: var(--navy);\n      font-size: 1.05rem;\n    }\n\n    .ycs-cert-center {\n      text-align: center;\n    }\n\n    .ycs-cert-center p {\n      max-width: 850px;\n      margin-left: auto;\n      margin-right: auto;\n    }\n\n    .ycs-cert-list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n    }\n\n    .ycs-cert-list li {\n      position: relative;\n      padding-left: 28px;\n      margin-bottom: 15px;\n      line-height: 1.6;\n    }\n\n    .ycs-cert-list li:before {\n      content: \"•\";\n      position: absolute;\n      left: 8px;\n      color: var(--pink);\n      font-weight: 800;\n    }\n\n    .ycs-cert-note {\n      margin-top: 18px;\n      padding: 18px 20px;\n      border-left: 3px solid var(--pink);\n      background: #fcf7f9;\n      line-height: 1.65;\n    }\n\n    .ycs-cert-video {\n      margin-top: 32px;\n      border-radius: 26px;\n      overflow: hidden;\n      background: #000;\n      box-shadow: 0 18px 44px rgba(18, 37, 63, .08);\n    }\n\n    .ycs-cert-video iframe {\n      width: 100%;\n      aspect-ratio: 16 / 9;\n      display: block;\n      border: 0;\n    }\n\n    .ycs-cert-quote p {\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: 1.28rem;\n      line-height: 1.65;\n      color: var(--navy);\n    }\n\n    .ycs-cert-quote cite {\n      display: block;\n      margin-top: 18px;\n      color: var(--pink);\n      font-style: normal;\n      font-weight: 800;\n    }\n\n    .ycs-cert-alert {\n      padding: 22px;\n      border-radius: 22px;\n      background: #fff8e5;\n      border: 1px solid #f2df9a;\n      color: var(--navy);\n      font-weight: 700;\n      line-height: 1.6;\n    }\n\n    .ycs-cert-faqs-list {\n      display: grid;\n      gap: 14px;\n      margin-top: 34px;\n    }\n\n    .ycs-cert-faq {\n      border: 1px solid var(--line);\n      border-radius: 22px;\n      background: #fff;\n      overflow: hidden;\n    }\n\n    .ycs-cert-faq summary {\n      list-style: none;\n      cursor: pointer;\n      display: flex;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 24px 26px;\n      color: var(--navy);\n      font-weight: 800;\n      line-height: 1.45;\n    }\n\n    .ycs-cert-faq summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .ycs-cert-faq-icon {\n      width: 34px;\n      height: 34px;\n      border-radius: 999px;\n      border: 1px solid var(--line);\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      color: var(--pink);\n      flex: 0 0 auto;\n      transition: transform .18s ease;\n    }\n\n    .ycs-cert-faq[open] .ycs-cert-faq-icon {\n      transform: rotate(45deg);\n    }\n\n    .ycs-cert-faq-answer {\n      padding: 0 26px 24px;\n    }\n\n    @media (max-width: 1000px) {\n      .ycs-cert-grid,\n      .ycs-cert-two,\n      .ycs-cert-cards-3 {\n        grid-template-columns: 1fr;\n      }\n    }\n\n    @media (max-width: 767px) {\n      .ycs-cert-wrap {\n        padding: 0 18px;\n      }\n\n      .ycs-cert-section {\n        padding: 64px 0;\n      }\n\n      .ycs-cert-hero {\n        padding: 28px 0 56px;\n      }\n\n      .ycs-cert-actions {\n        flex-direction: column;\n      }\n\n      .ycs-btn {\n        width: 100%;\n      }\n    }\n  </style>\n\n  <section class=\"ycs-cert-hero\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-grid\">\n        <div>\n          <span class=\"ycs-cert-eyebrow\">\n            Your Color Style Certification\n          </span>\n\n          <div class=\"ycs-cert-badges\">\n            <span class=\"ycs-cert-badge\">Year-Long Access</span>\n            <span class=\"ycs-cert-badge\">Color Analysis Tool Included</span>\n            <span class=\"ycs-cert-badge\">Mentorship + Feedback</span>\n          </div>\n\n          <h1>\n            Become a Certified Color Analyst with a modern color system.\n          </h1>\n\n          <p>\n            Learn how to analyze real clients using the Your Color Style method—a color theory-based system built around depth, undertone, and chroma.\n          </p>\n\n          <p>\n            This certification program gives you the training, practice, tool access, assignments, feedback, and support you need to become confident analyzing color online or in person.\n          </p>\n\n          <div class=\"ycs-cert-actions\">\n            <a href=\"#order\" class=\"ycs-btn ycs-btn-primary\">\n              Enroll in Certification\n            </a>\n\n            <a href=\"#program-video\" class=\"ycs-btn ycs-btn-secondary\">\n              Watch the Walkthrough\n            </a>\n          </div>\n        </div>\n\n        <div>\n          <img class=\"ycs-cert-hero-img\" src=\"https://cdn.shopify.com/s/files/1/0623/6284/5408/files/color-analysis-tool-hero.png?v=1776625160\" alt=\"Your Color Style Color Analysis Tool shown on a laptop\">\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section ycs-cert-soft\">\n    <div class=\"ycs-cert-wrap ycs-cert-center\">\n      <span class=\"ycs-cert-eyebrow\">\n        A Different Kind of Color Analysis\n      </span>\n\n      <h2>Go beyond seasonal color typing.</h2>\n\n      <p class=\"ycs-muted\">\n        Seasonal systems can be limiting. Your Color Style teaches you how to see color through depth, undertone, and chroma so you can work with gray hair, olive undertones, changing contrast, and real-life coloring with more confidence.\n      </p>\n\n      <div class=\"ycs-cert-cards-3\">\n        <div class=\"ycs-cert-card\">\n          <strong>Learn the method</strong>\n\n          <p class=\"ycs-muted\">\n            Understand how to evaluate depth, undertone, chroma, harmony, and contrast.\n          </p>\n        </div>\n\n        <div class=\"ycs-cert-card\">\n          <strong>Practice with real photos</strong>\n\n          <p class=\"ycs-muted\">\n            Use virtual draping and comparison tools to train your eye.\n          </p>\n        </div>\n\n        <div class=\"ycs-cert-card\">\n          <strong>Get supported</strong>\n\n          <p class=\"ycs-muted\">\n            Submit assignments, receive feedback, and learn inside a consultant community.\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"program-video\" class=\"ycs-cert-section\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-center\">\n        <span class=\"ycs-cert-eyebrow\">\n          Watch the Program Walkthrough\n        </span>\n\n        <h2>See what to expect when you join.</h2>\n\n        <p class=\"ycs-muted\">\n          In this video, Jen walks you through the training experience, the assignments, and how the Color Analysis Tool supports your learning.\n        </p>\n      </div>\n\n      <div class=\"ycs-cert-video\">\n        <iframe src=\"https://www.youtube.com/embed/h3Saj-Aon4M\" title=\"Your Color Style Color Analysis Training Walkthrough\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section ycs-cert-soft\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-two\">\n        <div>\n          <span class=\"ycs-cert-eyebrow\">The Method</span>\n\n          <h2>The Your Color Style 3-step framework</h2>\n\n          <p>\n            You’ll learn how to make clear, confident color decisions using a repeatable framework instead of memorizing seasonal labels.\n          </p>\n\n          <ul class=\"ycs-cert-list\">\n            <li>\n              <strong>Depth:</strong> light, medium, or deep coloring.\n            </li>\n\n            <li>\n              <strong>Undertone:</strong> warm, cool, or olive color harmony.\n            </li>\n\n            <li>\n              <strong>Chroma:</strong> bright/clear or soft/muted color intensity.\n            </li>\n\n            <li>\n              <strong>Application:</strong> draping, comparison, palettes, and client-ready recommendations.\n            </li>\n          </ul>\n        </div>\n\n        <div class=\"ycs-cert-panel\">\n          <span class=\"ycs-cert-eyebrow\">What You’ll Learn</span>\n\n          <h3>Built for real women</h3>\n\n          <ul class=\"ycs-cert-list\">\n            <li>How gray hair changes contrast and color harmony</li>\n            <li>How to recognize olive undertones</li>\n            <li>How to compare warm vs. cool colors</li>\n            <li>How to identify brightness vs. softness</li>\n            <li>How to create useful color recommendations clients can actually wear</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-two\">\n        <div class=\"ycs-cert-shot\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0623/6284/5408/files/color-analysis-tool-undertones.png?v=1776430694\" alt=\"Undertone comparison view inside the Your Color Style Color Analysis Tool\">\n        </div>\n\n        <div>\n          <span class=\"ycs-cert-eyebrow\">Tool Access Included</span>\n\n          <h2>The tool helps you practice what you’re learning.</h2>\n\n          <p>\n            The Color Analysis Tool does not replace your judgment. It helps you visually compare drapes, test undertones, adjust photos, and see color harmony more clearly.\n          </p>\n\n          <ul class=\"ycs-cert-list\">\n            <li>Upload and work with client photos</li>\n            <li>Compare draping colors visually</li>\n            <li>Test warm, cool, soft, bright, light, and deep colors</li>\n            <li>Practice your eye before working with paying clients</li>\n          </ul>\n\n          <div class=\"ycs-cert-note\">\n            The course teaches you how to analyze. The tool helps you apply the method with more confidence.\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section ycs-cert-cream\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-quote\">\n        <p>\n          “When I decided to become a Color analyst, I found that there were many providers in the online space offering seasonal digital color consultation courses however, I was looking for something that was unique and different. Jen Vax and Your Color Style offer a revolutionary system of color typing that is leading-edge and inclusive for everyone. Jen Vax's mentorship and the supportive community of consultants made learning to become a YCS Certified Color Consultant fun and exciting. The course was streamlined, simple, and easy to learn. This is the best investment that I have made and I can't wait to transform women's confidence and self-image through color analysis and coaching.”\n        </p>\n\n        <cite>— Leanne</cite>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section ycs-cert-soft\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-two\">\n        <div>\n          <span class=\"ycs-cert-eyebrow\">Certification Program</span>\n\n          <h2>For the woman who wants to become client-ready.</h2>\n\n          <p>\n            This is the year-long certification path for learning the Your Color Style method, practicing with the tool, completing assignments, receiving feedback, and earning your certification.\n          </p>\n\n          <ul class=\"ycs-cert-list\">\n            <li>Full Your Color Style certification training</li>\n            <li>One full year of access</li>\n            <li>Color Analysis Tool access</li>\n            <li>Digital color palettes for practice and draping</li>\n            <li>Assignments and feedback</li>\n            <li>Private community support</li>\n            <li>1:1 coaching session with Jen</li>\n            <li>Digital certification upon completion</li>\n          </ul>\n\n          <div class=\"ycs-cert-actions\">\n            <a href=\"#order\" class=\"ycs-btn ycs-btn-primary\">\n              Enroll Now\n            </a>\n\n            <a href=\"https://scheduler.zoom.us/jennifer-vax/info-call\" target=\"_blank\" rel=\"noopener\" class=\"ycs-btn ycs-btn-outline\">\n              Schedule an Info Call\n            </a>\n          </div>\n        </div>\n\n        <div class=\"ycs-cert-panel\">\n          <span class=\"ycs-cert-eyebrow\">\n            Not Ready for Certification?\n          </span>\n\n          <h3>Join the live September training instead.</h3>\n\n          <p>\n            If you’re interested in learning color analysis but you’re not ready to commit to the full year-long certification program, the September Live Color Analysis Intensive is a strong first step.\n          </p>\n\n          <p>\n            You’ll receive 6 weeks of live instruction with Jen, guided assignments, personal feedback, and temporary access to the Color Analysis Tool and digital color palettes without jumping straight into full certification.\n          </p>\n\n          <div class=\"ycs-cert-alert\">\n            The live intensive begins Tuesday, September 8 at 8pm ET. Tuition is $597, and the full value of the intensive may be applied toward the certification program if you decide to continue.\n          </div>\n\n          <div class=\"ycs-cert-actions\">\n            <a href=\"/products/live-color-analyst-cohort-september-8\" class=\"ycs-btn ycs-btn-secondary\">\n              View September Live Training\n            </a>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section\">\n    <div class=\"ycs-cert-wrap\">\n      <div class=\"ycs-cert-center\">\n        <span class=\"ycs-cert-eyebrow\">FAQs</span>\n\n        <h2>Frequently Asked Questions</h2>\n\n        <p class=\"ycs-muted\">\n          Here are the answers to the questions most people ask before joining the Your Color Style certification program.\n        </p>\n      </div>\n\n      <div class=\"ycs-cert-faqs-list\">\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>What makes this certification different from other color analysis programs?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Most programs teach seasonal color analysis and stop there.\n            </p>\n\n            <p>\n              The Your Color Style certification teaches a <strong>modern 3-step system based on color theory</strong>—depth, undertone, and chroma—so you can analyze real people more accurately.\n            </p>\n\n            <p>\n              It also includes the <strong>Color Analysis Tool</strong>, which allows you to visually compare drapes and practice on real photos.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Do I need any experience to get started?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              No. This program is designed for complete beginners, stylists, makeup artists, and anyone who wants to learn color analysis correctly.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Does the Color Analysis Tool teach me how to do color analysis?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              No. The <strong>training teaches you how to analyze color</strong>. The <strong>tool helps you apply what you’re learning</strong>.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>How does the Color Analysis Tool help me?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              The tool lets you compare draping colors, test warm vs. cool, work on real client photos, and visually see what works instead of guessing.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Will I learn how to work with gray hair and olive skin tones?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Yes. You’ll learn how gray hair affects contrast and color harmony, and how to evaluate olive undertones more accurately.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>How long does the certification take?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              You can complete the program at your own pace. Most students finish in a few weeks to a few months. You’ll have access for one full year.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>What do I need to do to get certified?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              You’ll complete the training, practice with the method and tool, submit assignments, receive feedback, and refine your work.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Will I be able to work with real clients after this?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Yes. The goal is to help you build a clear, repeatable method and the confidence to analyze clients online or in person.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Do I get support during the program?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Yes. You’ll have access to a private community, guidance and feedback on assignments, and a 1:1 coaching session with Jen.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>Can I turn this into a business?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Yes. Many students go on to offer color analysis services, add it to an existing beauty or styling business, or create a side income.\n            </p>\n          </div>\n        </details>\n\n        <details class=\"ycs-cert-faq\">\n          <summary>\n            <span>What if I’m not ready for full certification yet?</span>\n            <span class=\"ycs-cert-faq-icon\">+</span>\n          </summary>\n\n          <div class=\"ycs-cert-faq-answer\">\n            <p>\n              Start with the September Live Color Analysis Intensive. It begins September 8 and gives you 6 weeks of live instruction, guided practice, feedback, and temporary access to the Color Analysis Tool and digital palettes without committing to the full year-long certification program.\n            </p>\n\n            <p>\n              Tuition is $597, and the full value of the intensive may be applied toward the certification program if you decide to continue.\n            </p>\n\n            <p>\n              <a href=\"/products/live-color-analyst-cohort-september-8\">\n                Learn more about the September live training.\n              </a>\n            </p>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"ycs-cert-section ycs-cert-soft\">\n    <div class=\"ycs-cert-wrap ycs-cert-center\">\n      <span class=\"ycs-cert-eyebrow\">Ready to Begin?</span>\n\n      <h2>\n        Become a Your Color Style Certified Color Analyst.\n      </h2>\n\n      <p class=\"ycs-muted\">\n        Learn the method, practice with the tool, get feedback, and build the confidence to analyze real clients with a modern color analysis system.\n      </p>\n\n      <div class=\"ycs-cert-actions\" style=\"justify-content:center;\">\n        <a href=\"#order\" class=\"ycs-btn ycs-btn-primary\">\n          Enroll in Certification\n        </a>\n\n        <a href=\"https://scheduler.zoom.us/jennifer-vax/info-call\" target=\"_blank\" rel=\"noopener\" class=\"ycs-btn ycs-btn-outline\">\n          Schedule an Info Call\n        </a>\n      </div>\n    </div>\n  </section>\n</section>"
      }
    },
