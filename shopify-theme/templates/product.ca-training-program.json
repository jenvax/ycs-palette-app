    "cutom_html_iYtVhR": {
      "type": "cutom-HTML",
      "disabled": true,
      "name": "Custom HTML",
      "settings": {
        "title": "",
        "custom_HTML": "<section class=\"ycs-cert-faqs\">\n  <style>\n    .ycs-cert-faqs {\n      --ycs-navy: #12253f;\n      --ycs-text: #222222;\n      --ycs-muted: #666666;\n      --ycs-line: #e9e9e9;\n      --ycs-soft: #f7f7f7;\n      --ycs-pink: #ef4f78;\n      --ycs-max: 1280px;\n      background: #ffffff;\n      color: var(--ycs-text);\n      font-family: \"Helvetica Neue\", Arial, sans-serif;\n    }\n\n    .ycs-cert-faqs *,\n    .ycs-cert-faqs *::before,\n    .ycs-cert-faqs *::after {\n      box-sizing: border-box;\n    }\n\n    .ycs-cert-faqs-wrap {\n      max-width: var(--ycs-max);\n      margin: 0 auto;\n      padding: 88px 24px;\n    }\n\n    .ycs-cert-faqs-head {\n      text-align: center;\n      margin-bottom: 38px;\n    }\n\n    .ycs-cert-faqs-eyebrow {\n      display: inline-block;\n      margin-bottom: 10px;\n      font-size: 0.82rem;\n      font-weight: 700;\n      letter-spacing: 0.16em;\n      text-transform: uppercase;\n      color: var(--ycs-pink);\n    }\n\n    .ycs-cert-faqs-head h2 {\n      margin: 0 0 14px;\n      color: var(--ycs-navy);\n      font-family: Georgia, \"Times New Roman\", serif;\n      font-size: clamp(2rem, 4vw, 3.1rem);\n      line-height: 1.04;\n      letter-spacing: -0.02em;\n    }\n\n    .ycs-cert-faqs-head p {\n      max-width: 780px;\n      margin: 0 auto;\n      color: var(--ycs-muted);\n      font-size: 1.05rem;\n      line-height: 1.7;\n    }\n\n    .ycs-cert-faqs-list {\n      display: grid;\n      gap: 14px;\n    }\n\n    .ycs-cert-faq {\n      border: 1px solid var(--ycs-line);\n      border-radius: 22px;\n      background: #ffffff;\n      overflow: hidden;\n      transition: border-color 0.2s ease, box-shadow 0.2s ease;\n    }\n\n    .ycs-cert-faq[open] {\n      border-color: #e6d8de;\n      box-shadow: 0 8px 24px rgba(18, 37, 63, 0.04);\n    }\n\n    .ycs-cert-faq summary {\n      list-style: none;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 16px;\n      padding: 24px 26px;\n      font-size: 1.02rem;\n      font-weight: 700;\n      color: var(--ycs-navy);\n      line-height: 1.45;\n    }\n\n    .ycs-cert-faq summary::-webkit-details-marker {\n      display: none;\n    }\n\n    .ycs-cert-faq summary::marker {\n      display: none;\n    }\n\n    .ycs-cert-faq-icon {\n      flex: 0 0 auto;\n      width: 34px;\n      height: 34px;\n      border-radius: 999px;\n      border: 1px solid var(--ycs-line);\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      color: var(--ycs-pink);\n      font-size: 1.2rem;\n      line-height: 1;\n      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;\n      background: #ffffff;\n    }\n\n    .ycs-cert-faq[open] .ycs-cert-faq-icon {\n      transform: rotate(45deg);\n      background: #fcf7f9;\n      border-color: #f0dbe4;\n    }\n\n    .ycs-cert-faq-answer {\n      padding: 0 26px 24px;\n      color: var(--ycs-text);\n    }\n\n    .ycs-cert-faq-answer p {\n      margin: 0 0 14px;\n      font-size: 1rem;\n      line-height: 1.72;\n    }\n\n    .ycs-cert-faq-answer p:last-child {\n      margin-bottom: 0;\n    }\n\n    .ycs-cert-faq-answer ul,\n    .ycs-cert-faq-answer ol {\n      margin: 0 0 14px 0;\n      padding: 0;\n      list-style: none;\n    }\n\n    .ycs-cert-faq-answer li {\n      position: relative;\n      padding-left: 26px;\n      margin-bottom: 12px;\n      line-height: 1.68;\n    }\n\n    .ycs-cert-faq-answer li::before {\n      content: \"•\";\n      position: absolute;\n      left: 8px;\n      top: 0;\n      color: var(--ycs-pink);\n      font-weight: 700;\n    }\n\n    .ycs-cert-faq-answer strong {\n      color: var(--ycs-navy);\n    }\n\n    @media (max-width: 767px) {\n      .ycs-cert-faqs-wrap {\n        padding: 64px 18px;\n      }\n\n      .ycs-cert-faq summary {\n        padding: 20px 20px;\n        font-size: 0.98rem;\n      }\n\n      .ycs-cert-faq-answer {\n        padding: 0 20px 20px;\n      }\n\n      .ycs-cert-faq {\n        border-radius: 18px;\n      }\n    }\n  </style>\n\n  <div class=\"ycs-cert-faqs-wrap\">\n    <div class=\"ycs-cert-faqs-head\">\n      <span class=\"ycs-cert-faqs-eyebrow\">FAQs</span>\n      <h2>Frequently Asked Questions</h2>\n      <p>\n        Here are the answers to the questions most people ask before joining the Your Color Style certification program.\n      </p>\n    </div>\n\n    <div class=\"ycs-cert-faqs-list\">\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>What makes this certification different from other color analysis programs?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>\n            Most programs teach seasonal color analysis and stop there.\n          </p>\n          <p>\n            The Your Color Style certification teaches a <strong>modern 3-step system based on color theory</strong> — depth, undertone, and chroma — so you can analyze real people more accurately.\n          </p>\n          <p>\n            It also includes the <strong>Color Analysis Tool</strong>, which allows you to visually compare drapes and practice on real photos, making the learning process faster and more intuitive.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Do I need any experience to get started?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>No.</p>\n          <p>This program is designed for:</p>\n          <ul>\n            <li>complete beginners</li>\n            <li>stylists and makeup artists</li>\n            <li>anyone who wants to learn color analysis correctly</li>\n          </ul>\n          <p>\n            You’ll learn the method step-by-step and build confidence as you go.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Does the Color Analysis Tool teach me how to do color analysis?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>No — and that’s important.</p>\n          <p>\n            The <strong>training teaches you how to analyze color</strong>. The <strong>tool helps you apply what you’re learning</strong>.\n          </p>\n          <p>Think of it like this:</p>\n          <ul>\n            <li>The course = knowledge + method</li>\n            <li>The tool = practice + visual confirmation</li>\n          </ul>\n          <p>\n            Together, they make the process much easier to understand.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>How does the Color Analysis Tool help me?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>The tool allows you to:</p>\n          <ul>\n            <li>compare draping colors side by side</li>\n            <li>test warm vs cool within the same depth</li>\n            <li>work directly on real client photos</li>\n            <li>visually see what works instead of guessing</li>\n          </ul>\n          <p>\n            This helps you develop your eye faster and make more confident decisions.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Will I learn how to work with gray hair and olive skin tones?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>Yes.</p>\n          <p>\n            This is one of the biggest differences in this program.\n          </p>\n          <p>You’ll learn how to:</p>\n          <ul>\n            <li>analyze olive undertones correctly</li>\n            <li>understand how gray hair affects contrast and color harmony</li>\n            <li>adjust your analysis based on real-life variables</li>\n          </ul>\n          <p>\n            Most systems don’t teach this clearly. We do.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>How long does the certification take?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>\n            You can complete the program at your own pace.\n          </p>\n          <p>\n            Most students finish in a few weeks to a few months depending on how quickly they move through the material and assignments.\n          </p>\n          <p>\n            You’ll have access to the content for one full year.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>What do I need to do to get certified?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>To earn your certification, you will:</p>\n          <ul>\n            <li>Complete the training</li>\n            <li>Practice using the method and tool</li>\n            <li>Submit your assignments</li>\n            <li>Receive feedback and refine your work</li>\n          </ul>\n          <p>\n            Once completed, you’ll receive your <strong>digital certification</strong>.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Will I be able to work with real clients after this?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>Yes — that’s the goal.</p>\n          <p>You’ll leave this program with:</p>\n          <ul>\n            <li>a clear, repeatable method</li>\n            <li>hands-on practice</li>\n            <li>real-world application experience</li>\n          </ul>\n          <p>\n            You’ll feel confident analyzing clients either online or in person.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Do I get support during the program?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>Yes.</p>\n          <p>You’ll have access to:</p>\n          <ul>\n            <li>a private community of students and certified analysts</li>\n            <li>guidance and feedback on your assignments</li>\n            <li>a 1:1 coaching session with Jen</li>\n          </ul>\n          <p>You’re not doing this alone.</p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Can I turn this into a business?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>Yes.</p>\n          <p>Many students go on to:</p>\n          <ul>\n            <li>offer color analysis services</li>\n            <li>add it to existing styling or beauty businesses</li>\n            <li>create a side income</li>\n          </ul>\n          <p>\n            You’ll learn a skill you can monetize if you choose to.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>What if I’m not ready for full certification yet?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>That’s okay.</p>\n          <p>\n            You can start with <strong>Color Confidence for You and Your Customers</strong>.\n          </p>\n          <p>This is a great first step if you want to:</p>\n          <ul>\n            <li>understand color more deeply</li>\n            <li>build confidence</li>\n            <li>ease into the process</li>\n          </ul>\n          <p>\n            Then you can move into certification when you’re ready.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>How is this different from the Color Analysis Tool by itself?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>The tool is just one piece.</p>\n          <ul>\n            <li>The <strong>tool alone</strong> helps you test and visualize</li>\n            <li>The <strong>certification program</strong> teaches you how to interpret what you’re seeing</li>\n          </ul>\n          <p>\n            If you want real confidence and accuracy, you need both.\n          </p>\n        </div>\n      </details>\n\n      <details class=\"ycs-cert-faq\">\n        <summary>\n          <span>Do I need special equipment?</span>\n          <span class=\"ycs-cert-faq-icon\">+</span>\n        </summary>\n        <div class=\"ycs-cert-faq-answer\">\n          <p>No.</p>\n          <p>You can complete this program with:</p>\n          <ul>\n            <li>a computer or tablet</li>\n            <li>photos of yourself or clients</li>\n          </ul>\n          <p>\n            The Color Analysis Tool works on desktop, tablet, and mobile.\n          </p>\n        </div>\n      </details>\n    </div>\n  </div>\n</section>"
      }
    },
