        "custom_HTML": "<style>\n  /* =========================================================\n     THE POLISHED PROFESSIONAL FOR MEN\n     YOUR COLOR STYLE — 2026 DESIGN SYSTEM\n     ========================================================= */\n\n  .ycs-polished-men {\n    --bg-primary: #FAFAFA;\n    --bg-secondary: #FFFFFF;\n    --bg-soft: #F8F4F7;\n\n    --text-primary: #292832;\n    --text-secondary: #505868;\n    --headline-primary: #12253f;\n\n    --border-soft: #ECE8E3;\n    --border-violet: #DED5EA;\n\n    --violet: #7B5CFF;\n    --blue: #4DA1FF;\n    --gradient-primary: linear-gradient(90deg, #7B5CFF, #4DA1FF);\n\n    --shadow-soft: 0 18px 45px rgba(32, 28, 45, 0.08);\n\n    --radius-card: 28px;\n    --radius-image: 24px;\n    --container: 1220px;\n\n    background: var(--bg-primary);\n    color: var(--text-primary);\n    overflow: hidden;\n  }\n\n  .ycs-polished-men *,\n  .ycs-polished-men *::before,\n  .ycs-polished-men *::after {\n    box-sizing: border-box;\n  }\n\n  .ycs-polished-men img {\n    display: block;\n    max-width: 100%;\n  }\n\n  .ycs-polished-men a {\n    text-decoration: none;\n  }\n\n  .ycs-polished-men .ycs-container {\n    width: min(var(--container), calc(100% - 48px));\n    margin: 0 auto;\n  }\n\n  .ycs-polished-men .ycs-section {\n    padding: 68px 0;\n  }\n\n  .ycs-polished-men .ycs-section--white {\n    background: var(--bg-secondary);\n  }\n\n  .ycs-polished-men .ycs-section--soft {\n    background: var(--bg-soft);\n  }\n\n  /* TYPOGRAPHY */\n\n  .ycs-polished-men .ycs-eyebrow {\n    display: inline-block;\n    margin: 0 0 16px;\n    font-size: 12px;\n    line-height: 1.3;\n    font-weight: 700;\n    letter-spacing: .16em;\n    text-transform: uppercase;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-title {\n    margin: 0 0 20px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2.8rem, 5vw, 5.3rem);\n    font-weight: 400;\n    line-height: .96;\n    letter-spacing: -.045em;\n    color: var(--headline-primary);\n    text-wrap: balance;\n    -webkit-font-smoothing: antialiased;\n    text-rendering: optimizeLegibility;\n  }\n\n  .ycs-polished-men .ycs-h2 {\n    margin: 0 0 18px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2rem, 4vw, 3.4rem);\n    font-weight: 400;\n    line-height: 1.02;\n    letter-spacing: -.03em;\n    color: var(--headline-primary);\n    text-wrap: balance;\n  }\n\n  .ycs-polished-men .ycs-h3 {\n    margin: 0 0 12px;\n    font-size: 1.4rem;\n    line-height: 1.2;\n    font-weight: 700;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-body {\n    margin: 0;\n    font-size: 1.04rem;\n    line-height: 1.72;\n    font-weight: 400;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-body + .ycs-body {\n    margin-top: 16px;\n  }\n\n  .ycs-polished-men .ycs-intro {\n    max-width: 760px;\n    margin: 0 auto 40px;\n    text-align: center;\n  }\n\n  .ycs-polished-men .ycs-intro .ycs-body {\n    max-width: 690px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* BUTTONS */\n\n  .ycs-polished-men .ycs-btn-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    align-items: center;\n  }\n\n  .ycs-polished-men .ycs-btn {\n    display: inline-flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 56px;\n    padding: 15px 28px;\n    border-radius: 999px;\n    font-size: .82rem;\n    line-height: 1.2;\n    font-weight: 800;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n    transition:\n      transform .2s ease,\n      box-shadow .2s ease,\n      border-color .2s ease;\n  }\n\n  .ycs-polished-men .ycs-btn:hover {\n    transform: translateY(-2px);\n  }\n\n  .ycs-polished-men .ycs-btn--primary {\n    background: var(--gradient-primary);\n    color: #FFFFFF;\n    box-shadow: 0 10px 25px rgba(87, 94, 225, .18);\n  }\n\n  .ycs-polished-men .ycs-btn--primary:hover {\n    box-shadow: 0 14px 30px rgba(87, 94, 225, .24);\n  }\n\n  .ycs-polished-men .ycs-btn--secondary {\n    background: #FFFFFF;\n    color: var(--text-primary);\n    border: 2px solid var(--border-violet);\n  }\n\n  .ycs-polished-men .ycs-btn--secondary:hover {\n    border-color: #CFC3E3;\n  }\n\n  .ycs-polished-men .ycs-microcopy {\n    margin-top: 13px;\n    font-size: .86rem;\n    line-height: 1.5;\n    color: var(--text-secondary);\n  }\n\n  /* HERO */\n\n  .ycs-polished-men .ycs-hero {\n    padding: 52px 0 64px;\n    background:\n      radial-gradient(circle at 12% 15%, rgba(123, 92, 255, .07), transparent 33%),\n      var(--bg-primary);\n  }\n\n  .ycs-polished-men .ycs-hero-grid {\n    display: grid;\n    grid-template-columns: .95fr 1.05fr;\n    gap: 48px;\n    align-items: center;\n  }\n\n  .ycs-polished-men .ycs-hero-copy {\n    max-width: 620px;\n  }\n\n  .ycs-polished-men .ycs-hero-lead {\n    max-width: 590px;\n    margin: 0 0 24px;\n    font-size: 1.11rem;\n    line-height: 1.68;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-hero-lead strong {\n    color: var(--text-primary);\n  }\n\n  .ycs-polished-men .ycs-offer-line {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px 16px;\n    align-items: center;\n    margin: 0 0 27px;\n  }\n\n  .ycs-polished-men .ycs-price {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 2rem;\n    line-height: 1;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-offer-note {\n    font-size: .9rem;\n    line-height: 1.45;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-hero-visual {\n    position: relative;\n  }\n\n  .ycs-polished-men .ycs-hero-image {\n    width: 100%;\n    aspect-ratio: 1.08 / 1;\n    object-fit: cover;\n    border-radius: var(--radius-image);\n    border: 1px solid var(--border-soft);\n    box-shadow: var(--shadow-soft);\n    background: #EEE;\n  }\n\n  .ycs-polished-men .ycs-hero-note {\n    position: absolute;\n    left: -28px;\n    bottom: 28px;\n    width: min(340px, 72%);\n    padding: 20px 22px;\n    border-radius: 20px;\n    border: 1px solid rgba(236, 232, 227, .9);\n    background: rgba(255, 255, 255, .95);\n    box-shadow: var(--shadow-soft);\n    backdrop-filter: blur(10px);\n  }\n\n  .ycs-polished-men .ycs-hero-note strong {\n    display: block;\n    margin-bottom: 6px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.15rem;\n    font-weight: 400;\n    line-height: 1.25;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-hero-note span {\n    font-size: .85rem;\n    line-height: 1.5;\n    color: var(--text-secondary);\n  }\n\n  /* TRUST STRIP */\n\n  .ycs-polished-men .ycs-trust {\n    border-top: 1px solid var(--border-soft);\n    border-bottom: 1px solid var(--border-soft);\n    background: #FFFFFF;\n  }\n\n  .ycs-polished-men .ycs-trust-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n  }\n\n  .ycs-polished-men .ycs-trust-item {\n    padding: 22px 20px;\n    text-align: center;\n    border-right: 1px solid var(--border-soft);\n  }\n\n  .ycs-polished-men .ycs-trust-item:last-child {\n    border-right: 0;\n  }\n\n  .ycs-polished-men .ycs-trust-item strong {\n    display: block;\n    margin-bottom: 4px;\n    font-size: .93rem;\n    line-height: 1.35;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-trust-item span {\n    font-size: .82rem;\n    line-height: 1.45;\n    color: var(--text-secondary);\n  }\n\n  /* PROBLEM SECTION */\n\n  .ycs-polished-men .ycs-editorial-grid {\n    display: grid;\n    grid-template-columns: .92fr 1.08fr;\n    gap: 64px;\n    align-items: start;\n  }\n\n  .ycs-polished-men .ycs-sticky-copy {\n    position: sticky;\n    top: 32px;\n  }\n\n  .ycs-polished-men .ycs-signal-list {\n    display: grid;\n    gap: 14px;\n  }\n\n  .ycs-polished-men .ycs-signal {\n    display: flex;\n    gap: 15px;\n    align-items: flex-start;\n    padding: 20px 21px;\n    border: 1px solid var(--border-soft);\n    border-radius: 20px;\n    background: #FFFFFF;\n  }\n\n  .ycs-polished-men .ycs-signal-icon {\n    flex: 0 0 28px;\n    width: 28px;\n    height: 28px;\n    display: grid;\n    place-items: center;\n    margin-top: 1px;\n    border-radius: 50%;\n    background: #F1EEFF;\n    color: var(--violet);\n    font-size: .82rem;\n    font-weight: 800;\n  }\n\n  .ycs-polished-men .ycs-signal p {\n    margin: 0;\n    font-size: .98rem;\n    line-height: 1.58;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-signal strong {\n    color: var(--text-primary);\n  }\n\n  /* SERVICE CARDS */\n\n  .ycs-polished-men .ycs-offer-header {\n    max-width: 800px;\n    margin-bottom: 42px;\n  }\n\n  .ycs-polished-men .ycs-service-stack {\n    display: grid;\n    gap: 22px;\n  }\n\n  .ycs-polished-men .ycs-service-card {\n    display: grid;\n    grid-template-columns: 92px 1fr;\n    gap: 25px;\n    padding: 30px;\n    background: #FFFFFF;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--radius-card);\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-polished-men .ycs-service-number {\n    width: 72px;\n    height: 72px;\n    display: grid;\n    place-items: center;\n    border-radius: 22px;\n    background: #F3F0FF;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.65rem;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-service-kicker {\n    margin: 0 0 6px;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: .14em;\n    text-transform: uppercase;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-service-title {\n    margin: 0 0 6px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(1.55rem, 2.8vw, 2.25rem);\n    font-weight: 400;\n    line-height: 1.08;\n    letter-spacing: -.025em;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-service-byline {\n    margin: 0 0 15px;\n    font-size: .92rem;\n    font-weight: 700;\n    color: var(--text-primary);\n  }\n\n  .ycs-polished-men .ycs-service-copy {\n    margin: 0 0 18px;\n    font-size: .98rem;\n    line-height: 1.67;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-check-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px 22px;\n  }\n\n  .ycs-polished-men .ycs-check {\n    position: relative;\n    margin: 0;\n    padding-left: 24px;\n    font-size: .92rem;\n    line-height: 1.5;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-check::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    font-weight: 800;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-founder-note {\n    margin-top: 18px;\n    padding: 17px 19px;\n    border-radius: 16px;\n    background: var(--bg-soft);\n    font-size: .91rem;\n    line-height: 1.58;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-founder-note strong {\n    color: var(--headline-primary);\n  }\n\n  /* PROCESS */\n\n  .ycs-polished-men .ycs-process-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n  }\n\n  .ycs-polished-men .ycs-process-card {\n    min-height: 230px;\n    padding: 27px 25px;\n    background: #FFFFFF;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--radius-card);\n  }\n\n  .ycs-polished-men .ycs-process-step {\n    display: inline-block;\n    margin-bottom: 24px;\n    font-size: 11px;\n    line-height: 1;\n    font-weight: 800;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-process-card h3 {\n    margin: 0 0 10px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.55rem;\n    font-weight: 400;\n    line-height: 1.12;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-process-card p {\n    margin: 0;\n    font-size: .94rem;\n    line-height: 1.62;\n    color: var(--text-secondary);\n  }\n\n  /* EXPERTS */\n\n  .ycs-polished-men .ycs-expert-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 26px;\n  }\n\n  .ycs-polished-men .ycs-expert-card {\n    display: grid;\n    grid-template-columns: 180px 1fr;\n    min-height: 270px;\n    overflow: hidden;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--radius-card);\n    background: #FFFFFF;\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-polished-men .ycs-expert-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    background: #EEE;\n  }\n\n  .ycs-polished-men .ycs-expert-copy {\n    padding: 27px 26px;\n    align-self: center;\n  }\n\n  .ycs-polished-men .ycs-expert-role {\n    margin: 0 0 7px;\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: .13em;\n    text-transform: uppercase;\n    color: var(--violet);\n  }\n\n  .ycs-polished-men .ycs-expert-name {\n    margin: 0 0 10px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.85rem;\n    font-weight: 400;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-expert-copy p {\n    margin: 0;\n    font-size: .92rem;\n    line-height: 1.62;\n    color: var(--text-secondary);\n  }\n\n  /* OUTCOME */\n\n  .ycs-polished-men .ycs-outcome-grid {\n    display: grid;\n    grid-template-columns: 1.02fr .98fr;\n    gap: 50px;\n    align-items: center;\n  }\n\n  .ycs-polished-men .ycs-outcome-image {\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    object-fit: cover;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--radius-image);\n    box-shadow: var(--shadow-soft);\n    background: #EEE;\n  }\n\n  .ycs-polished-men .ycs-outcome-list {\n    display: grid;\n    gap: 13px;\n    margin: 25px 0 0;\n  }\n\n  .ycs-polished-men .ycs-outcome-item {\n    display: flex;\n    gap: 12px;\n    align-items: flex-start;\n  }\n\n  .ycs-polished-men .ycs-outcome-mark {\n    flex: 0 0 25px;\n    width: 25px;\n    height: 25px;\n    display: grid;\n    place-items: center;\n    border-radius: 50%;\n    background: #F1EEFF;\n    color: var(--violet);\n    font-size: .76rem;\n    font-weight: 800;\n  }\n\n  .ycs-polished-men .ycs-outcome-item p {\n    margin: 0;\n    font-size: .97rem;\n    line-height: 1.55;\n    color: var(--text-secondary);\n  }\n\n  /* INVESTMENT */\n\n  .ycs-polished-men .ycs-investment-card {\n    position: relative;\n    overflow: hidden;\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 48px;\n    border: 1px solid var(--border-soft);\n    border-radius: 34px;\n    background: #FFFFFF;\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-polished-men .ycs-investment-card::before {\n    content: \"\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 5px;\n    background: var(--gradient-primary);\n  }\n\n  .ycs-polished-men .ycs-investment-grid {\n    display: grid;\n    grid-template-columns: 1fr 310px;\n    gap: 50px;\n    align-items: center;\n  }\n\n  .ycs-polished-men .ycs-investment-price {\n    margin: 0 0 8px;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(3rem, 6vw, 4.5rem);\n    font-weight: 400;\n    line-height: 1;\n    letter-spacing: -.04em;\n    color: var(--headline-primary);\n  }\n\n  .ycs-polished-men .ycs-investment-label {\n    margin: 0 0 23px;\n    font-size: .88rem;\n    line-height: 1.5;\n    color: var(--text-secondary);\n  }\n\n  .ycs-polished-men .ycs-investment-actions {\n    display: grid;\n    gap: 11px;\n  }\n\n  .ycs-polished-men .ycs-investment-actions .ycs-btn {\n    width: 100%;\n  }\n\n  /* FIT */\n\n  .ycs-polished-men .ycs-fit-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 15px;\n    max-width: 900px;\n    margin: 34px auto 0;\n  }\n\n  .ycs-polished-men .ycs-fit-item {\n    padding: 20px 22px;\n    border-radius: 20px;\n    border: 1px solid var(--border-soft);\n    background: #FFFFFF;\n  }\n\n  .ycs-polished-men .ycs-fit-item strong {\n    display: block;\n  