<!-- breadcrumb -->
{% include 'breadcrumb' %}

<div class="my-ycs-account-navigation">
  {% render 'my-ycs-logo' %}
</div>

<div class="page-width">
  <h1 class="page-title">{{ 'customer.account.title' | t }}</h1>

 {% comment %}
Show Style Masters Hub button if:
- customer has VIP tag (active member), OR
- customer has a permanent Style Masters issue entitlement tag, OR
- customer has ever purchased Style Masters membership or issue products
{% endcomment %}

{% assign has_style_masters_access = false %}
{% assign sm_handles = 'style-masters,style-masters-magazine,style-masters-membership' | split: ',' %}

{% if customer %}
  {% assign account_tag_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}

  {% if account_tag_string contains ',VIP,' or account_tag_string contains ',STYLEMASTERS_' %}
    {% assign has_style_masters_access = true %}
  {% endif %}

  {% if has_style_masters_access == false %}
    {% for order in customer.orders %}
      {% if order.cancelled_at == nil and order.financial_status != 'void' %}
        {% for item in order.line_items %}
          {% if item.product %}
            {% assign item_handle = item.product.handle | downcase %}
            {% assign item_tags = item.product.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
            {% if sm_handles contains item_handle or item_handle contains 'style-masters-' or item_tags contains ',STYLE MASTERS ISSUE,' %}
              {% assign has_style_masters_access = true %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if has_style_masters_access %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
<h3 class="account-resources-title">Your Resources</h3>
<div class="account-quick-links">
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}

  {% assign has_trade_access = false %}
  {% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
  {% assign trade_sept_cohort_expires_at = '2026-10-20 00:00:00 -0400' | date: '%s' %}
  {% assign current_timestamp = 'now' | date: '%s' %}
  {% assign current_ymd = 'now' | date: '%Y%m%d' | plus: 0 %}
  {% if palette_access_string contains ',TRADE,' %}
    {% assign has_trade_access = true %}
  {% endif %}
  {% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
    {% assign has_trade_access = true %}
  {% endif %}

  {% assign has_color_analysis_tool = false %}
  {% if palette_access_string contains ',CATOOL,' or palette_access_string contains ',YCSPRO,' or palette_access_string contains ',DIYCATOOL,' or palette_access_string contains ',FREEDIYCATOOL,' or palette_access_string contains ',YCS_ADMIN,' %}
    {% assign has_color_analysis_tool = true %}
  {% endif %}
  {% if palette_access_string contains ',TRADESEPTCOHORT,' and current_timestamp < trade_sept_cohort_expires_at %}
    {% assign has_color_analysis_tool = true %}
  {% endif %}
  {% if palette_access_string contains ',GUIDED,' %}
    {% for ycs_customer_tag in customer.tags %}
      {% assign ycs_guided_tag = ycs_customer_tag | upcase | strip %}
      {% if ycs_guided_tag contains 'GUIDED_TOOL_EXPIRES_' %}
        {% assign ycs_guided_tool_expires = ycs_guided_tag | remove: 'GUIDED_TOOL_EXPIRES_' | plus: 0 %}
        {% if ycs_guided_tool_expires >= current_ymd %}
          {% assign has_color_analysis_tool = true %}
        {% endif %}
      {% endif %}
      {% if ycs_guided_tag contains 'GUIDED_TRAINING_EXPIRES_' %}
        {% assign ycs_guided_training_expires = ycs_guided_tag | remove: 'GUIDED_TRAINING_EXPIRES_' | plus: 0 %}
        {% if ycs_guided_training_expires >= current_ymd %}
          {% assign has_color_analysis_tool = true %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% unless palette_access_string contains ',TRADE,' %}
    {% if has_trade_access or has_color_analysis_tool %}
      <a href="/pages/my-palettes?view=catools" class="account-tool">
        Color Analysis Tools
      </a>
    {% endif %}
  {% endunless %}

  <a href="/pages/digital-downloads" class="account-tool">
    Downloads
  </a>

   <a href="/tools/memberships" class="account-tool">
    Manage Subscriptions
  </a>

  {% if has_style_masters_access %}
    
    <a href="/pages/style-masters-library" class="account-tool">
      Style Masters Hub
    </a>
  {% endif %}
</div>

{% if palette_access_string contains ',YCSMEMBER,' or palette_access_string contains ',YCS_ADMIN,' %}
  <section class="account-report-branding" data-report-branding>
    <div>
      <h2>Report Branding</h2>
      <p>Save the business name and logo that should appear automatically on your client reports.</p>
    </div>
    <form data-report-branding-form>
      <label>Business Name<input type="text" name="businessName" maxlength="160" autocomplete="organization"></label>
      <label>Business Logo<input type="file" name="logoFile" accept="image/png,image/jpeg,image/webp,image/gif"></label>
      <div class="account-report-branding__preview" data-branding-preview hidden>
        <img data-branding-logo width="140" height="80" alt="Business logo preview">
        <button type="button" class="btn btn--secondary btn--small" data-remove-branding-logo>Remove Logo</button>
      </div>
      <input type="hidden" name="logoUrl">
      <input type="hidden" name="logoPublicId">
      <div class="account-report-branding__actions">
        <button type="submit" class="btn">Save Report Branding</button>
        <span data-branding-status role="status" aria-live="polite"></span>
      </div>
    </form>
  </section>
{% endif %}


  <hr/>
  <div class="grid">
    <div class="grid__item medium-up--two-thirds">
      <h4>{{ 'customer.orders.title' | t }}</h4>

      {% paginate customer.orders by 20 %}
        {% if customer.orders.size != 0 %}

          <table class="responsive-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td data-label="{{ 'customer.orders.order_number' | t }}">
                    <a href="{{ order.customer_url }}" class="btn btn--secondary btn--small">{{ order.name }}</a>
                  </td>
                  <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | time_tag: format: 'date' }}</td>
                  <td data-label="{{ 'customer.orders.payment_status' | t }}">{{ order.financial_status_label }}</td>
                  <td data-label="{{ 'customer.orders.fulfillment_status' | t }}">{{ order.fulfillment_status_label }}</td>
                  <td data-label="{{ 'customer.orders.total' | t }}">{{ order.total_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>

        {% else %}

          <p>{{ 'customer.orders.none' | t }}</p>

        {% endif %}
        {% if paginate.pages > 1 %}
          {% include 'pagination' %}
        {% endif %}
      {% endpaginate %}
    </div>
    <div class="grid__item medium-up--one-third">
      <h4>{{ 'customer.account.details' | t }}</h4>

      {{ customer.default_address | format_address }}

      <p>
        <a href="{{ routes.account_addresses_url }}" class="btn btn--small">
          {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
        </a>
      </p>
    </div>
  </div>
</div>
<style>
  .shopify-section-header,
  #shopify-section-header,
  .site-header,
  .header-wrapper,
  .header,
  .breadcrumb,
  nav.breadcrumb {
    display: none !important;
  }

  .my-ycs-account-navigation {
    min-height: 76px;
  }

.account-resources-title {
  font-size: 16px;
  font-weight: 600;
  margin: 18px 0 8px;
  color: #333;
}
  .account-report-branding {
    display: grid;
    grid-template-columns: minmax(220px, .8fr) minmax(320px, 1.2fr);
    gap: 32px;
    margin: 28px 0 36px;
    padding: 28px;
    border: 1px solid #e4dff0;
    border-top: 5px solid #7657e8;
    border-radius: 8px;
    background: #fff;
  }
  .account-report-branding h2 { margin: 0 0 8px; color: #12253f; }
  .account-report-branding p { margin: 0; color: #626a79; }
  .account-report-branding form { display: grid; gap: 16px; }
  .account-report-branding label { display: grid; gap: 6px; font-weight: 700; color: #12253f; }
  .account-report-branding input[type="text"],
  .account-report-branding input[type="file"] { width: 100%; border: 1px solid #d9d5e2; border-radius: 6px; padding: 11px 12px; font: inherit; }
  .account-report-branding__preview { display: flex; align-items: center; gap: 16px; }
  .account-report-branding__preview[hidden] { display: none; }
  .account-report-branding__preview img { width: 140px; max-height: 80px; object-fit: contain; object-position: left center; }
  .account-report-branding__actions { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
  [data-branding-status] { color: #626a79; font-weight: 600; }
  @media (max-width: 749px) { .account-report-branding { grid-template-columns: 1fr; padding: 22px; } }
  .page-width .account-quick-links {
    margin: 16px 0 28px !important;
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 10px !important;
    align-items: center !important;
  }

  .page-width .account-quick-links .account-tool {
    display: inline-flex !important;
    width: auto !important;
    max-width: none !important;
    min-width: 0 !important;
    flex: 0 0 auto !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 10px 16px !important;
    margin: 0 !important;
    border-radius: 999px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    border: 1.5px solid #d94c6a !important;
    color: #d94c6a !important;
    background: #fff !important;
    box-shadow: none !important;
    transition: all 0.15s ease !important;
  }

  .page-width .account-quick-links .account-tool:hover {
    background: #d94c6a !important;
    color: #fff !important;
  }

  .page-width .account-quick-links .account-tool.account-tool--primary {
    background: #d94c6a !important;
    color: #fff !important;
  }

  .page-width .account-quick-links .account-tool.account-tool--primary:hover {
    background: #b93455 !important;
    border-color: #b93455 !important;
  }
</style>
{% if palette_access_string contains ',YCSMEMBER,' or palette_access_string contains ',YCS_ADMIN,' %}
<script>
(function () {
  const root = document.querySelector('[data-report-branding]');
  if (!root) return;
  const form = root.querySelector('[data-report-branding-form]');
  const status = root.querySelector('[data-branding-status]');
  const preview = root.querySelector('[data-branding-preview]');
  const image = root.querySelector('[data-branding-logo]');

  function setStatus(message) { status.textContent = message || ''; }
  function showLogo(url) {
    form.elements.logoUrl.value = url || '';
    image.src = url || '';
    preview.hidden = !url;
  }
  function proxyJson(url, options) {
    return fetch(url, Object.assign({ credentials: 'same-origin' }, options || {})).then(function (response) {
      return response.json().then(function (data) {
        if (!response.ok) throw new Error(data.error || 'Request failed');
        return data;
      });
    });
  }

  proxyJson('/apps/palette-data?action=reportBranding')
    .then(function (data) {
      form.elements.businessName.value = data.branding.businessName || '';
      form.elements.logoPublicId.value = data.branding.logoPublicId || '';
      showLogo(data.branding.logoUrl || '');
    })
    .catch(function (error) { setStatus(error.message || 'Unable to load report branding.'); });

  form.elements.logoFile.addEventListener('change', function () {
    const file = this.files && this.files[0];
    if (!file) return;
    const reader = new FileReader();
    const input = this;
    setStatus('Uploading logo...');
    input.disabled = true;
    reader.onload = function () {
      proxyJson('/apps/palette-data?action=reportBranding', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ operation: 'uploadLogo', imageBase64: reader.result })
      }).then(function (data) {
        showLogo(data.logoUrl);
        form.elements.logoPublicId.value = data.logoPublicId || '';
        setStatus('Logo uploaded. Save your branding to apply it to reports.');
      }).catch(function (error) {
        setStatus(error.message || 'Unable to upload logo.');
      }).finally(function () {
        input.disabled = false;
        input.value = '';
      });
    };
    reader.onerror = function () { input.disabled = false; setStatus('Unable to read that image.'); };
    reader.readAsDataURL(file);
  });

  root.querySelector('[data-remove-branding-logo]').addEventListener('click', function () {
    showLogo('');
    form.elements.logoPublicId.value = '';
    setStatus('Logo removed. Save your branding to confirm.');
  });

  form.addEventListener('submit', function (event) {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    button.textContent = 'Saving...';
    setStatus('Saving report branding...');
    proxyJson('/apps/palette-data?action=reportBranding', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        businessName: form.elements.businessName.value,
        logoUrl: form.elements.logoUrl.value,
        logoPublicId: form.elements.logoPublicId.value
      })
    }).then(function () {
      setStatus('Report branding saved.');
    }).catch(function (error) {
      setStatus(error.message || 'Unable to save report branding.');
    }).finally(function () {
      button.disabled = false;
      button.textContent = 'Save Report Branding';
    });
  });
})();
</script>
{% endif %}
