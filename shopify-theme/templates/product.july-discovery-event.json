        "custom_HTML": "<style>\n  :root {\n    --bg-primary: #FAFAFA;\n    --bg-secondary: #FFFFFF;\n    --bg-soft: #F8F4F7;\n\n    --text-primary: #292832;\n    --text-secondary: #505868;\n    --headline-primary: #12253F;\n\n    --border-soft: #ECE8E3;\n    --border-violet: #DED5EA;\n\n    --violet: #7B5CFF;\n    --blue: #4DA1FF;\n\n    --gradient-primary: linear-gradient(90deg, #7B5CFF, #4DA1FF);\n    --shadow-soft: 0 18px 45px rgba(32, 28, 45, 0.08);\n\n    --radius-card: 28px;\n    --container: 1180px;\n  }\n\n  html {\n    scroll-behavior: smooth;\n  }\n\n  .ycs-ended-page {\n    overflow: hidden;\n    background: var(--bg-primary);\n    color: var(--text-primary);\n    font-family: inherit;\n  }\n\n  .ycs-ended-page * {\n    box-sizing: border-box;\n  }\n\n  .ycs-ended-wrap {\n    width: 100%;\n    max-width: var(--container);\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  .ycs-ended-section {\n    padding: 72px 0;\n  }\n\n  .ycs-ended-section-white {\n    background: var(--bg-secondary);\n  }\n\n  .ycs-ended-section-soft {\n    background: var(--bg-soft);\n  }\n\n  .ycs-ended-eyebrow {\n    display: inline-block;\n    margin: 0 0 16px;\n    color: var(--violet);\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: .16em;\n    line-height: 1.4;\n    text-transform: uppercase;\n  }\n\n  .ycs-ended-title {\n    max-width: 850px;\n    margin: 0 0 22px;\n    color: var(--headline-primary);\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2.8rem, 5vw, 5.1rem);\n    font-weight: 400;\n    letter-spacing: -.045em;\n    line-height: .98;\n    text-wrap: balance;\n  }\n\n  .ycs-ended-h2 {\n    margin: 0 0 18px;\n    color: var(--headline-primary);\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2rem, 4vw, 3.35rem);\n    font-weight: 400;\n    letter-spacing: -.03em;\n    line-height: 1.04;\n    text-wrap: balance;\n  }\n\n  .ycs-ended-h3 {\n    margin: 0 0 12px;\n    color: var(--headline-primary);\n    font-size: 1.35rem;\n    font-weight: 800;\n    line-height: 1.25;\n  }\n\n  .ycs-ended-page p {\n    margin: 0 0 18px;\n    color: var(--text-secondary);\n    font-size: 1.05rem;\n    line-height: 1.72;\n  }\n\n  .ycs-ended-lede {\n    max-width: 760px;\n    font-size: 1.12rem !important;\n  }\n\n  .ycs-ended-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 58px;\n    padding: 15px 28px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--gradient-primary);\n    color: #FFFFFF;\n    font-size: .84rem;\n    font-weight: 800;\n    letter-spacing: .08em;\n    line-height: 1.2;\n    text-align: center;\n    text-decoration: none;\n    text-transform: uppercase;\n    transition:\n      opacity .18s ease,\n      transform .18s ease,\n      box-shadow .18s ease;\n    box-shadow: 0 16px 34px rgba(77, 95, 255, 0.20);\n  }\n\n  .ycs-ended-btn:hover {\n    color: #FFFFFF;\n    opacity: .94;\n    transform: translateY(-2px);\n  }\n\n  .ycs-ended-btn-secondary {\n    border: 2px solid var(--border-violet);\n    background: #FFFFFF;\n    color: var(--text-primary);\n    box-shadow: none;\n  }\n\n  .ycs-ended-btn-secondary:hover {\n    background: var(--bg-soft);\n    color: var(--text-primary);\n  }\n\n  .ycs-ended-btn-dark {\n    border: 2px solid var(--headline-primary);\n    background: var(--headline-primary);\n    color: #FFFFFF;\n    box-shadow: none;\n  }\n\n  .ycs-ended-btn-dark:hover {\n    color: #FFFFFF;\n  }\n\n  .ycs-ended-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    margin-top: 30px;\n  }\n\n  /* HERO */\n\n  .ycs-ended-hero {\n    position: relative;\n    padding: 80px 0 74px;\n    background:\n      radial-gradient(\n        circle at 88% 12%,\n        rgba(123, 92, 255, .12),\n        transparent 31%\n      ),\n      linear-gradient(180deg, #FFFFFF 0%, #FAFAFA 100%);\n  }\n\n  .ycs-ended-hero-grid {\n    display: grid;\n    grid-template-columns: 1.04fr .96fr;\n    gap: 52px;\n    align-items: center;\n  }\n\n  .ycs-ended-status {\n    display: inline-flex;\n    gap: 10px;\n    align-items: center;\n    margin: 0 0 22px;\n    padding: 10px 16px;\n    border: 1px solid var(--border-violet);\n    border-radius: 999px;\n    background: #F2EEFF;\n    color: #4E46A4;\n    font-size: .84rem;\n    font-weight: 800;\n    line-height: 1.4;\n  }\n\n  .ycs-ended-status-dot {\n    width: 9px;\n    height: 9px;\n    flex: 0 0 9px;\n    border-radius: 50%;\n    background: var(--violet);\n    box-shadow: 0 0 0 5px rgba(123, 92, 255, .10);\n  }\n\n  .ycs-ended-notice {\n    max-width: 650px;\n    margin-top: 24px;\n    padding: 18px 20px;\n    border-left: 3px solid var(--violet);\n    border-radius: 0 18px 18px 0;\n    background: rgba(255, 255, 255, .85);\n    color: var(--text-secondary);\n    font-size: .97rem;\n    line-height: 1.65;\n  }\n\n  .ycs-ended-notice strong {\n    color: var(--headline-primary);\n  }\n\n  .ycs-ended-visual {\n    position: relative;\n    min-height: 470px;\n    overflow: hidden;\n    border: 1px solid var(--border-soft);\n    border-radius: 32px;\n    background:\n      linear-gradient(\n        145deg,\n        rgba(18, 37, 63, .98),\n        rgba(57, 67, 104, .94)\n      );\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-ended-visual::before {\n    position: absolute;\n    top: -95px;\n    right: -80px;\n    width: 290px;\n    height: 290px;\n    border-radius: 50%;\n    background: rgba(123, 92, 255, .32);\n    content: \"\";\n  }\n\n  .ycs-ended-visual::after {\n    position: absolute;\n    bottom: -120px;\n    left: -95px;\n    width: 310px;\n    height: 310px;\n    border-radius: 50%;\n    background: rgba(77, 161, 255, .23);\n    content: \"\";\n  }\n\n  .ycs-ended-visual-content {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    min-height: 470px;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 36px;\n  }\n\n  .ycs-ended-visual-label {\n    color: rgba(255, 255, 255, .70);\n    font-size: .76rem;\n    font-weight: 800;\n    letter-spacing: .15em;\n    text-transform: uppercase;\n  }\n\n  .ycs-ended-visual-main {\n    max-width: 430px;\n  }\n\n  .ycs-ended-visual-main h2 {\n    margin: 0 0 16px;\n    color: #FFFFFF;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(2rem, 3.5vw, 3.2rem);\n    font-weight: 400;\n    letter-spacing: -.03em;\n    line-height: 1.04;\n  }\n\n  .ycs-ended-visual-main p {\n    margin: 0;\n    color: rgba(255, 255, 255, .76);\n    font-size: 1rem;\n    line-height: 1.65;\n  }\n\n  .ycs-ended-date-card {\n    display: grid;\n    grid-template-columns: 54px 1fr;\n    gap: 16px;\n    align-items: center;\n    padding: 18px;\n    border: 1px solid rgba(255, 255, 255, .15);\n    border-radius: 20px;\n    background: rgba(255, 255, 255, .09);\n    backdrop-filter: blur(8px);\n  }\n\n  .ycs-ended-date-icon {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 54px;\n    height: 54px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, .14);\n    color: #FFFFFF;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.2rem;\n  }\n\n  .ycs-ended-date-card strong {\n    display: block;\n    margin-bottom: 4px;\n    color: #FFFFFF;\n    font-size: 1rem;\n  }\n\n  .ycs-ended-date-card span {\n    color: rgba(255, 255, 255, .74);\n    font-size: .9rem;\n    line-height: 1.45;\n  }\n\n  /* NEXT STEP CARDS */\n\n  .ycs-ended-center {\n    text-align: center;\n  }\n\n  .ycs-ended-center p {\n    max-width: 790px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .ycs-ended-card-grid {\n    display: grid;\n    grid-template-columns: 1.08fr .92fr;\n    gap: 24px;\n    margin-top: 38px;\n    align-items: stretch;\n  }\n\n  .ycs-ended-card {\n    display: flex;\n    min-height: 100%;\n    flex-direction: column;\n    padding: 34px 30px;\n    border: 1px solid var(--border-soft);\n    border-radius: var(--radius-card);\n    background: #FFFFFF;\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-ended-card-featured {\n    border: 2px solid var(--violet);\n  }\n\n  .ycs-ended-card-tag {\n    align-self: flex-start;\n    margin-bottom: 22px;\n    padding: 8px 13px;\n    border: 1px solid var(--border-violet);\n    border-radius: 999px;\n    background: var(--bg-soft);\n    color: var(--headline-primary);\n    font-size: .72rem;\n    font-weight: 800;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .ycs-ended-price {\n    margin: 14px 0 18px;\n    color: var(--headline-primary);\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 3.1rem;\n    font-weight: 400;\n    line-height: 1;\n  }\n\n  .ycs-ended-feature-list {\n    display: grid;\n    gap: 13px;\n    margin: 6px 0 28px;\n    padding: 0;\n    list-style: none;\n  }\n\n  .ycs-ended-feature-list li {\n    display: grid;\n    grid-template-columns: 22px 1fr;\n    gap: 10px;\n    align-items: start;\n    color: var(--text-primary);\n    font-size: .97rem;\n    line-height: 1.52;\n  }\n\n  .ycs-ended-feature-list li::before {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 21px;\n    height: 21px;\n    margin-top: 1px;\n    border-radius: 50%;\n    background: var(--gradient-primary);\n    color: #FFFFFF;\n    content: \"✓\";\n    font-size: .68rem;\n    font-weight: 900;\n  }\n\n  .ycs-ended-card-actions {\n    display: grid;\n    gap: 13px;\n    margin-top: auto;\n  }\n\n  .ycs-ended-card-actions .ycs-ended-btn {\n    width: 100%;\n  }\n\n  .ycs-ended-small-note {\n    margin: 15px 0 0 !important;\n    color: var(--text-secondary);\n    font-size: .87rem !important;\n    line-height: 1.55 !important;\n  }\n\n  /* HOW TO CHOOSE */\n\n  .ycs-ended-guide-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 22px;\n    margin-top: 34px;\n  }\n\n  .ycs-ended-guide-card {\n    padding: 28px 26px;\n    border: 1px solid var(--border-soft);\n    border-radius: 26px;\n    background: #FFFFFF;\n    box-shadow: var(--shadow-soft);\n  }\n\n  .ycs-ended-guide-number {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 44px;\n    height: 44px;\n    margin-bottom: 20px;\n    border-radius: 50%;\n    background: var(--gradient-primary);\n    color: #FFFFFF;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 1.2rem;\n  }\n\n  .ycs-ended-guide-card p {\n    margin: 0;\n  }\n\n  /* FINAL */\n\n  .ycs-ended-final {\n    padding: 74px 0 80px;\n    background: var(--headline-primary);\n    text-align: center;\n  }\n\n  .ycs-ended-final-inner {\n    max-width: 850px;\n    margin: 0 auto;\n  }\n\n  .ycs-ended-final .ycs-ended-eyebrow {\n    color: #B7AAFF;\n  }\n\n  .ycs-ended-final .ycs-ended-h2 {\n    color: #FFFFFF;\n  }\n\n  .ycs-ended-final p {\n    color: rgba(255, 255, 255, .76);\n  }\n\n  .ycs-ended-final-actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 14px;\n    justify-content: center;\n    margin-top: 30px;\n  }\n\n  .ycs-ended-final .ycs-ended-btn-secondary {\n    border-color: rgba(255, 255, 255, .42);\n    background: transparent;\n    color: #FFFFFF;\n  }\n\n  .ycs-ended-final .ycs-ended-btn-secondary:hover {\n    background: rgba(255, 255, 255, .10);\n    color: #FFFFFF;\n  }\n\n  @media (max-width: 920px) {\n    .ycs-ended-hero-grid,\n    .ycs-ended-card-grid,\n    .ycs-ended-guide-grid {\n      grid-template-columns: 1fr;\n    }\n\n    .ycs-ended-hero-copy {\n      max-width: 820px;\n    }\n\n    .ycs-ended-visual,\n    .ycs-ended-visual-content {\n      min-height: 410px;\n    }\n\n    .ycs-ended-card {\n      width: 100%;\n      max-width: 760px;\n      margin: 0 auto;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .ycs-ended-hero,\n    .ycs-ended-section,\n    .ycs-ended-final {\n      padding: 54px 0;\n    }\n\n    .ycs-ended-wrap {\n      padding: 0 18px;\n    }\n\n    .ycs-ended-actions,\n    .ycs-ended-final-actions {\n      align-items: stretch;\n      flex-direction: column;\n    }\n\n    .ycs-ended-actions .ycs-ended-btn,\n    .ycs-ended-final-actions .ycs-ended-btn {\n      width: 100%;\n    }\n\n    .ycs-ended-status {\n      align-items: flex-start;\n      border-radius: 18px;\n    }\n\n    .ycs-ended-visual,\n    .ycs-ended-visual-content {\n      min-height: 430px;\n    }\n\n    .ycs-ended-visual-content {\n      padding: 26px 22px;\n    }\n\n    .ycs-ended-card,\n    .ycs-ended-guide-card {\n      padding: 26px 21px;\n    }\n  }\n</style>\n\n<div class=\"ycs-ended-page\">\n\n  <!-- HERO -->\n  <section class=\"ycs-ended-hero\">\n    <div class=\"ycs-ended-wrap ycs-ended-hero-grid\">\n\n      <div class=\"ycs-ended-hero-copy\">\n        <div class=\"ycs-ended-status\">\n          <span class=\"ycs-ended-status-dot\" aria-hidden=\"true\"></span>\n          The July Color Discovery Event has ended.\n        </div>\n\n        <div class=\"ycs-ended-eyebrow\">\n          Your Next Color Analysis Opportunity\n        </div>\n\n        <h1 class=\"ycs-ended-title\">\n          Ready to keep learning about color analysis?\n        </h1>\n\n        <p class=\"ycs-ended-lede\">\n          The special July event has ended, but you can still take the next\n          step toward understanding color analysis and developing your eye\n          for depth, undertone, chroma, harmony, and contrast.\n        </p>\n\n        <p>\n          The September Live Color Analysis Intensive is now open for\n          enrollment and begins September 8.\n        </p>\n\n        <div class=\"ycs-ended-actions\">\n          <a href=\"/products/live-color-analyst-cohort-september-8\" class=\"ycs-ended-btn\">\n            View the September Cohort\n          </a>\n\n          <a href=\"/pages/online-color-analysis-training\" class=\"ycs-ended-btn ycs-ended-btn-secondary\">\n            Explore All Training Options\n          </a>\n        </div>\n\n        <div class=\"ycs-ended-notice\">\n          <strong>Looking for one of the previous July offers?</strong>\n          The limited-time pricing and bonuses are no longer available.\n          Visit the Color Analysis Training page to see the learning options\n          currently available.\n        </div>\n      </div>\n\n      <div class=\"ycs-ended-visual\">\n        <div class=\"ycs-ended-visual-content\">\n\n          <div class=\"ycs-ended-visual-label\">\n            Enrollment Is Now Open\n          </div>\n\n          <div class=\"ycs-ended-visual-main\">\n            <h2>\n              Learn color analysis live with Jen.\n            </h2>\n\n            <p>\n              Build your knowledge through live instruction, guided\n              assignments, professional tools, practice, and personal\n              feedback.\n            </p>\n          </div>\n\n          <div class=\"ycs-ended-date-card\">\n            <div class=\"ycs-ended-date-icon\">8</div>\n\n            <div>\n              <strong>September Live Color Analysis Intensive</strong>\n              <span>\n                Begins Tuesday, September 8 at 8pm ET\n              </span>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- NEXT STEPS -->\n  <section class=\"ycs-ended-section ycs-ended-section-white\">\n    <div class=\"ycs-ended-wrap\">\n\n      <div class=\"ycs-ended-center\">\n        <div class=\"ycs-ended-eyebrow\">\n          Choose Your Next Step\n        </div>\n\n        <h2 class=\"ycs-ended-h2\">\n          Where would you like to go from here?\n        </h2>\n\n        <p>\n          Choose the September cohort when you are ready for live training,\n          practice, and feedback. Choose the training page when you want to\n          compare the different ways to learn color analysis.\n        </p>\n      </div>\n\n      <div class=\"ycs-ended-card-grid\">\n\n        <!-- SEPTEMBER COHORT -->\n        <article class=\"ycs-ended-card ycs-ended-card-featured\">\n          <div class=\"ycs-ended-card-tag\">\n            Recommended Next Step\n          </div>\n\n          <h3 class=\"ycs-ended-h3\">\n            September Live Color Analysis Intensive\n          </h3>\n\n          <div class=\"ycs-ended-price\">$597</div>\n\n          <p>\n            Learn the Your Color Style method during a focused six-week live\n            training experience with Jen.\n          </p>\n\n          <ul class=\"ycs-ended-feature-list\">\n            <li>Six live color analysis training sessions</li>\n            <li>Training begins September 8</li>\n            <li>Three guided assignments</li>\n            <li>Personal feedback and mentoring</li>\n            <li>Professional Color Analysis Tool access during training</li>\n            <li>Digital color palette access during training</li>\n            <li>Course materials and replays for 60 days</li>\n          </ul>\n\n          <div class=\"ycs-ended-card-actions\">\n            <a href=\"/products/live-color-analyst-cohort-september-8\" class=\"ycs-ended-btn\">\n              View the September Cohort\n            </a>\n          </div>\n\n          <p class=\"ycs-ended-small-note\">\n            This intensive does not include certification. The full $597\n            tuition may be applied toward the Your Color Style Certification\n            Program if you decide to continue.\n          </p>\n        </article>\n\n        <!-- ALL TRAINING -->\n        <article class=\"ycs-ended-card\">\n          <div class=\"ycs-ended-card-tag\">\n            Compare Your Options\n          </div>\n\n          <h3 class=\"ycs-ended-h3\">\n            Explore Color Analysis Training\n          </h3>\n\n          <p>\n            Not sure whether you want self-paced education, live training,\n            professional tools, or full certification?\n          </p>\n\n          <p>\n            Visit the main Color Analysis Training page to understand the\n            available learning paths and choose the experience that best\n            matches your goals.\n          </p>\n\n          <ul class=\"ycs-ended-feature-list\">\n            <li>Compare different training paths</li>\n            <li>Learn what each program includes</li>\n            <li>Understand the difference between training and certification</li>\n            <li>Find the best starting point for your goals</li>\n          </ul>\n\n          <div class=\"ycs-ended-card-actions\">\n            <a href=\"/pages/online-color-analysis-training\" class=\"ycs-ended-btn ycs-ended-btn-dark\">\n              Explore Color Analysis Training\n            </a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- GUIDANCE -->\n  <section class=\"ycs-ended-section ycs-ended-section-soft\">\n    <div class=\"ycs-ended-wrap\">\n\n      <div class=\"ycs-ended-eyebrow\">\n        A Simple Recommendation\n      </div>\n\n      <h2 class=\"ycs-ended-h2\">\n        Not sure which link to choose?\n      </h2>\n\n      <p class=\"ycs-ended-lede\">\n        Start with the outcome you want most.\n      </p>\n\n      <div class=\"ycs-ended-guide-grid\">\n\n        <article class=\"ycs-ended-guide-card\">\n          <div class=\"ycs-ended-guide-number\">1</div>\n\n          <h3 class=\"ycs-ended-h3\">\n            Choose the September Cohort\n          </h3>\n\n          <p>\n            Choose this path when you are serious about learning the process\n            and want live instruction, structured assignments, professional\n            tools, and personal feedback.\n          </p>\n        </article>\n\n        <article class=\"ycs-ended-guide-card\">\n          <div class=\"ycs-ended-guide-number\">2</div>\n\n          <h3 class=\"ycs-ended-h3\">\n            Visit the Training Page\n          </h3>\n\n          <p>\n            Choose this path when you are still exploring and want to compare\n            the available ways to learn color analysis before selecting a\n            program.\n          </p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- FINAL CTA -->\n  <section class=\"ycs-ended-final\">\n    <div class=\"ycs-ended-wrap ycs-ended-final-inner\">\n\n      <div class=\"ycs-ended-eyebrow\">\n        Continue Your Color Journey\n      </div>\n\n      <h2 class=\"ycs-ended-h2\">\n        The July event is over. Your opportunity to learn is not.\n      </h2>\n\n      <p>\n        Join Jen in September for six weeks of live color analysis training,\n        or explore the complete Your Color Style training options to find the\n        path that is right for you.\n      </p>\n\n      <div class=\"ycs-ended-final-actions\">\n        <a href=\"/products/live-color-analyst-cohort-september-8\" class=\"ycs-ended-btn\">\n          Join the September Cohort\n        </a>\n\n        <a href=\"/pages/online-color-analysis-training\" class=\"ycs-ended-btn ycs-ended-btn-secondary\">\n          View All Training Options\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n</div>"
      }
    },
