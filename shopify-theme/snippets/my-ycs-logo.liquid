{{ 'my-ycs.css' | asset_url | stylesheet_tag }}

{% assign ycs_menu_path = request.path %}
{% assign ycs_menu_section = 'my-ycs' %}
{% if ycs_menu_path == routes.account_url or ycs_menu_path == '/pages/digital-downloads' %}
  {% assign ycs_menu_section = 'account' %}
{% elsif page.template_suffix == 'ycs-learning-lesson' or ycs_menu_path contains '/learn' %}
  {% assign ycs_menu_section = 'learn' %}
{% elsif ycs_menu_path contains '/tools' or ycs_menu_path contains '/photo-prep' or ycs_menu_path contains '/my-photos' or ycs_menu_path contains '/draping-studio' %}
  {% assign ycs_menu_section = 'tools' %}
{% elsif ycs_menu_path == '/pages/my-palettes' %}
  {% assign ycs_menu_section = 'owned-palettes' %}
{% elsif ycs_menu_path contains 'palette' or ycs_menu_path contains '/member-color' %}
  {% assign ycs_menu_section = 'create' %}
{% elsif ycs_menu_path contains '/directory' %}
  {% assign ycs_menu_section = 'directory' %}
{% endif %}
{% assign ycs_submenu_section = '' %}
{% if ycs_menu_path contains '/tools-clients' %}
  {% assign ycs_submenu_section = 'clients' %}
{% elsif ycs_menu_path contains '/tools-photo-prep' or ycs_menu_path contains '/photo-prep' %}
  {% assign ycs_submenu_section = 'photo-prep' %}
{% elsif ycs_menu_path contains '/tools-lip-draping' %}
  {% assign ycs_submenu_section = 'lip-draping' %}
{% elsif ycs_menu_path contains '/tools-structured' %}
  {% assign ycs_submenu_section = 'structured' %}
{% elsif ycs_menu_path contains '/my-photos' %}
  {% assign ycs_submenu_section = 'my-photos' %}
{% elsif ycs_menu_path contains '/draping-studio' %}
  {% assign ycs_submenu_section = 'draping-studio' %}
{% elsif ycs_menu_path contains 'palette' or ycs_menu_path contains '/member-color' %}
  {% assign ycs_submenu_section = 'palettes' %}
{% elsif ycs_menu_path == '/pages/tools' %}
  {% assign ycs_submenu_section = 'tools' %}
{% endif %}
{% assign ycs_use_original_tool_nav = false %}
{% if ycs_menu_path contains '/tools-clients' or ycs_menu_path contains '/tools-photo-prep' or ycs_menu_path contains '/tools-lip-draping' or ycs_menu_path contains '/tools-structured' or ycs_menu_path contains '/my-photos' or ycs_menu_path contains '/draping-studio' %}
  {% assign ycs_use_original_tool_nav = true %}
{% endif %}
{% assign ycs_lesson_topic_title = '' %}
{% assign ycs_lesson_topic_index = '' %}
{% assign ycs_lesson_topic_size = 0 %}
{% assign ycs_lesson_is_diy = false %}
{% assign ycs_lesson_title_key = page.title | strip | downcase %}
{% if page.template_suffix == 'ycs-learning-lesson' %}
  {% assign ycs_learning_menu = linklists['ycs-learning-library'] %}
  {% for ycs_topic in ycs_learning_menu.links %}
    {% assign ycs_topic_index = forloop.index0 %}
    {% for ycs_lesson in ycs_topic.links %}
      {% if ycs_lesson.url == ycs_menu_path %}
        {% assign ycs_topic_parts = ycs_topic.title | split: '|' %}
        {% assign ycs_lesson_topic_title = ycs_topic_parts.first | strip %}
        {% assign ycs_lesson_topic_index = ycs_topic_index %}
        {% assign ycs_lesson_topic_size = ycs_topic.links.size %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  {% assign ycs_diy_menu = linklists['diy-color-analysis'] %}
  {% if ycs_diy_menu != blank %}
    {% for ycs_diy_lesson in ycs_diy_menu.links %}
      {% if ycs_diy_lesson.url == ycs_menu_path %}
        {% assign ycs_lesson_is_diy = true %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<header class="my-ycs-menu-shell" data-my-ycs-menu{% if ycs_use_original_tool_nav %} data-original-tools-nav{% endif %}>
  <div class="my-ycs-menu-shell__inner">
    <a class="my-ycs-menu-shell__logo" href="/" aria-label="Your Color Style home">
      <img src="https://yourcolorstyle.com/cdn/shop/files/your-color-style-logo-01_120x@2x.png?v=1645102456" width="120" height="38" alt="Your Color Style">
    </a>
    <button class="my-ycs-menu-shell__toggle" type="button" aria-expanded="false" aria-controls="my-ycs-member-menu">
      <span class="my-ycs-menu-shell__toggle-icon" aria-hidden="true"></span>
      <span data-menu-label>Menu</span>
    </button>
    <div class="my-ycs-menu-shell__drawer" id="my-ycs-member-menu">
      <nav class="my-ycs-menu-shell__primary" aria-label="My YCS navigation">
        <a href="/pages/my-ycs"{% if ycs_menu_section == 'my-ycs' %} class="is-active" aria-current="page"{% endif %}>My YCS</a>
        <a href="/pages/learn"{% if ycs_menu_section == 'learn' %} class="is-active" aria-current="page"{% endif %}>Learn</a>
        <a href="/pages/tools"{% if ycs_menu_section == 'tools' %} class="is-active" aria-current="page"{% endif %}>Tools</a>
        <a href="/pages/palettes"{% if ycs_menu_section == 'create' %} class="is-active" aria-current="page"{% endif %}>Palettes</a>
        <a href="/pages/directory"{% if ycs_menu_section == 'directory' %} class="is-active" aria-current="page"{% endif %}>Directory</a>
      </nav>
      <nav class="my-ycs-menu-shell__utility" aria-label="Account navigation">
        <a href="mailto:support@yourcolorstyle.com">Contact</a>
        <a href="{{ routes.account_url }}"{% if ycs_menu_section == 'account' %} class="is-active" aria-current="page"{% endif %}>My Account</a>
      </nav>
    </div>
  </div>
</header>

{% unless ycs_menu_section == 'account' or ycs_menu_path == '/pages/learn' or ycs_menu_path == '/pages/tools' or ycs_menu_path == '/pages/palettes' or ycs_menu_path == '/pages/my-palettes' or ycs_menu_path == '/pages/directory' or ycs_menu_path == '/pages/my-ycs' or ycs_use_original_tool_nav %}
  <nav class="my-ycs-submenu" aria-label="{% if page.template_suffix == 'ycs-learning-lesson' %}Lesson navigation{% elsif ycs_menu_section == 'create' %}Palette navigation{% else %}Professional tools navigation{% endif %}">
    <div class="my-ycs-submenu__inner">
      {% if page.template_suffix == 'ycs-learning-lesson' %}
        {% if ycs_lesson_is_diy %}
          <a href="/pages/diy-color-analysis">Back to DIY Color Analysis</a>
        {% else %}
          <a href="/pages/learn">Back to Learn</a>
          {% assign ycs_lesson_topic_key = ycs_lesson_topic_title | strip | downcase %}
          {% if ycs_lesson_topic_size > 1 and ycs_lesson_topic_title != blank and ycs_lesson_topic_key != ycs_lesson_title_key %}
            <a href="/pages/learn?topic={{ ycs_lesson_topic_index }}">{{ ycs_lesson_topic_title | escape }}</a>
          {% endif %}
        {% endif %}
        <a href="{{ request.path }}" class="is-active" aria-current="page">{{ page.title | escape }}</a>
      {% elsif ycs_menu_section == 'create' %}
        <span class="my-ycs-submenu__label">Palettes</span>
        <a href="/pages/ycs-color-palettes"{% if ycs_menu_path == '/pages/ycs-color-palettes' %} class="is-active" aria-current="page"{% endif %}>YCS Color Palettes</a>
        <a href="/pages/my-custom-palettes"{% if ycs_menu_path == '/pages/my-custom-palettes' %} class="is-active" aria-current="page"{% endif %}>My Custom Palettes</a>
      {% else %}
        <span class="my-ycs-submenu__label">Tools</span>
        <a href="/pages/tools-clients"{% if ycs_submenu_section == 'clients' %} class="is-active" aria-current="page"{% endif %}>My Clients</a>
        <a href="/pages/tools"{% if ycs_submenu_section == 'tools' %} class="is-active" aria-current="page"{% endif %}>Tools</a>
        <a href="/pages/palettes"{% if ycs_submenu_section == 'palettes' %} class="is-active" aria-current="page"{% endif %}>Palettes</a>
        <a href="/pages/tools-photo-prep?mode=trade&amp;workflow=color-analysis&amp;returnUrl=%2Fpages%2Ftools"{% if ycs_submenu_section == 'photo-prep' %} class="is-active" aria-current="page"{% endif %}>Photo Prep</a>
        <a href="/pages/tools-lip-draping"{% if ycs_submenu_section == 'lip-draping' %} class="is-active" aria-current="page"{% endif %}>Lip &amp; Draping Studio</a>
        <a href="/pages/tools-structured"{% if ycs_submenu_section == 'structured' %} class="is-active" aria-current="page"{% endif %}>Structured Analysis</a>
      {% endif %}
    </div>
  </nav>
{% endunless %}

<script>
  (function(){
    var menu=document.querySelector('[data-my-ycs-menu]');
    if(!menu||menu.dataset.ready==='true')return;
    menu.dataset.ready='true';
    var toggle=menu.querySelector('.my-ycs-menu-shell__toggle');
    var label=menu.querySelector('[data-menu-label]');
    toggle.addEventListener('click',function(){var open=menu.classList.toggle('is-open');toggle.setAttribute('aria-expanded',open?'true':'false');label.textContent=open?'Close':'Menu';});
    if(menu.hasAttribute('data-original-tools-nav')){
      var contextualNav=menu.parentElement;
      var globalLabels=['my ycs','tools','contact','my account'];
      var syncContextualNav=function(){
        var hasContextualLink=false;
        Array.prototype.forEach.call(contextualNav.children,function(child){
          if(child.tagName!=='A')return;
          var labelText=(child.textContent||'').trim().toLowerCase();
          var isGlobal=globalLabels.indexOf(labelText)!==-1;
          if(isGlobal)child.setAttribute('data-global-nav-duplicate','');else child.removeAttribute('data-global-nav-duplicate');
          if(!isGlobal&&!child.hidden)hasContextualLink=true;
        });
        contextualNav.classList.toggle('has-contextual-links',hasContextualLink);
      };
      new MutationObserver(syncContextualNav).observe(contextualNav,{childList:true,subtree:true,attributes:true,attributeFilter:['hidden']});
      if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',syncContextualNav);else syncContextualNav();
    }
  })();
</script>
