<section class="public-directory" data-directory data-url="/apps/palette-data?action=publicColorAnalystDirectory">
  <header><h1>Color Analyst Directory</h1><p>Find a Your Color Style color analyst for in-person or virtual services.</p></header>
  <div class="filters"><label>Search <input type="search" data-search placeholder="Name, business, or location"></label><label>Services <select data-service><option value="">All services</option><option>In-Person</option><option>Virtual</option><option>Both</option></select></label></div>
  <p data-status>Loading directory...</p><div class="directory-grid" data-grid></div>
</section>
<script>(function(){var a=document.querySelector('[data-directory]'),all=[],grid=a.querySelector('[data-grid]'),status=a.querySelector('[data-status]'),search=a.querySelector('[data-search]'),service=a.querySelector('[data-service]');function link(label,url){var x=document.createElement('a');x.textContent=label;x.href=url;x.target='_blank';x.rel='noopener';return x}function render(){var term=search.value.toLowerCase().trim(),wanted=service.value;var rows=all.filter(function(x){var hay=[x.name,x.businessName,x.city,x.stateProvince,x.country].join(' ').toLowerCase();var services=!wanted||x.services===wanted||x.services==='Both'&&(wanted==='In-Person'||wanted==='Virtual');return hay.includes(term)&&services});grid.replaceChildren();status.textContent=rows.length?'':(all.length?'No analysts match those filters.':'No directory listings are available yet.');rows.forEach(function(x){var c=document.createElement('article');c.className='analyst-card';var img=document.createElement('img');img.src=x.imageUrl;img.alt=x.businessName||x.name;c.appendChild(img);var b=document.createElement('div'),h=document.createElement('h2');h.textContent=x.businessName||x.name;b.appendChild(h);if(x.businessName){var n=document.createElement('p');n.className='name';n.textContent=x.name;b.appendChild(n)}var loc=document.createElement('p');loc.textContent=[x.city,x.stateProvince,x.country].filter(Boolean).join(', ');b.appendChild(loc);var s=document.createElement('p');s.className='services';s.textContent=x.services;b.appendChild(s);var bio=document.createElement('p');bio.textContent=x.bio;b.appendChild(bio);var links=document.createElement('div');links.className='links';links.appendChild(link('Website',x.websiteUrl));var email=document.createElement('a');email.href='mailto:'+x.contactEmail;email.textContent='Email';links.appendChild(email);if(x.socialUrl)links.appendChild(link('Social',x.socialUrl));b.appendChild(links);c.appendChild(b);grid.appendChild(c)})}fetch(a.dataset.url).then(function(r){return r.json().then(function(d){if(!r.ok)throw new Error(d.error);return d})}).then(function(d){all=d.listings||[];render()}).catch(function(){status.textContent='The directory could not be loaded. Please try again.'});search.oninput=render;service.onchange=render})();</script>
{% style %}.public-directory{max-width:1180px;margin:auto;padding:54px 24px 80px;color:#303137}.public-directory header{max-width:760px}.public-directory h1{font-size:46px;margin:0 0 12px}.public-directory header p{font-size:18px;color:#62646b}.filters{display:flex;gap:16px;margin:36px 0}.filters label{display:flex;flex-direction:column;gap:6px;font-weight:700}.filters input,.filters select{min-width:250px;border:1px solid #c9c4c6;border-radius:5px;padding:10px;font:inherit}.directory-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.analyst-card{display:grid;grid-template-columns:150px 1fr;gap:20px;border:1px solid #e1dadd;border-radius:8px;padding:20px}.analyst-card img{width:150px;aspect-ratio:4/5;object-fit:cover;border-radius:5px}.analyst-card h2{font-size:23px;margin:0 0 5px}.analyst-card p{line-height:1.5;color:#5f626a}.analyst-card .name,.analyst-card .services{font-weight:700}.analyst-card .services{color:#bd315b}.links{display:flex;gap:14px}.links a{color:#b93455;font-weight:700}@media(max-width:850px){.directory-grid{grid-template-columns:1fr}}@media(max-width:580px){.public-directory{padding:36px 16px}.public-directory h1{font-size:34px}.filters{display:block}.filters label{margin-bottom:14px}.filters input,.filters select{width:100%;min-width:0}.analyst-card{grid-template-columns:1fr}.analyst-card img{width:130px}}{% endstyle %}
{% schema %}{"name":"Color analyst directory","settings":[],"presets":[{"name":"Color analyst directory"}]}{% endschema %}
