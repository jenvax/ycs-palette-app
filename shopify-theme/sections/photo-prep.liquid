    state.selectedPersonalPhotoId = null;
    state.originalPhotoUrl = null;
    state.adjustedPhotoUrl = null;
    state.activePhotoUrl = null;
    state.currentBasePhotoUrl = null;
    state.justUploadedNewPhoto = true;
    state.workspaceOpen = true;

    resetPreviewOnly();
    resetControls();
    updateCustomerMeta();
    updateStartAnalysisLink();
    updateBackLink();
    syncVisibility();

    fileInput.value = '';
    fileInput.click();
  });
}
// replaceBtn handler

  if (replaceBtn) {
  replaceBtn.addEventListener('click', function () {
    if (IS_PERSONAL_MODE || IS_MEMBER_PHOTO_MODE) {
      return;
    }

    if (IS_DIY_MODE) {
      if (state.canUploadPhoto === false) {
        alert('You have used all uploads for this month.');
        return;
      }

      resetPreviewOnly();
      resetControls();
      state.customerId = VIEWER_CUSTOMER_ID;
      state.clientRecordId = null;
      updateStartAnalysisLink();
      updateBackLink();
      syncVisibility();
      fileInput.value = '';
      fileInput.click();
      return;
    }

    if (IS_SIMPLE_ANALYST) {
      resetPreviewOnly();
      resetControls();

      state.customerId = VIEWER_CUSTOMER_ID;
      state.clientRecordId = null;
      state.firstName = null;
      state.lastName = null;
      state.email = null;

      updateCustomerMeta();
      updateStartAnalysisLink();
      updateBackLink();
      syncVisibility();

      fileInput.value = '';
      fileInput.click();
      return;
    }

    if (IS_ADMIN && IS_MEMBER_PHOTO_MODE) {
  state.customerId = initialCustomerId;
  state.clientRecordId = null;
  state.firstName = initialFirstName || state.firstName;
  state.lastName = initialLastName || state.lastName;
  state.email = initialEmail || state.email;
	} else if (IS_ADMIN && state.clientRecordId) {
	  // Existing admin/consultant client already selected. Keep using clientRecordId.
	} else if (IS_ADMIN) {
	  alert('Create or open a client first.');
	  return;
	} else if (IS_TRADE_MODE && !IS_SIMPLE_ANALYST && !state.clientRecordId) {
	  alert('Create a client first.');
	  return;
}

    updateCustomerMeta();
    updateStartAnalysisLink();
    updateBackLink();
    syncVisibility();

    fileInput.value = '';
    fileInput.click();
  });
}

  if (createClientBtn) {
    createClientBtn.addEventListener('click', function () {
      createConsultantClient();
    });
  }

  if (editClientBtn) {
    editClientBtn.addEventListener('click', function () {
      openEditClientPanel();
    });
  }

  if (saveClientBtn) {
    saveClientBtn.addEventListener('click', function () {
      if (state.clientRecordId) {
        saveConsultantClientInfo();
      } else if (IS_ADMIN) {
        saveAdminClientInfo();
      } else {
        saveConsultantClientInfo();
      }
    });
  }

  if (cancelClientBtn) {
    cancelClientBtn.addEventListener('click', function () {
      closeEditClientPanel();
    });
  }

  if (refreshClientsBtn) {
    refreshClientsBtn.addEventListener('click', function () {
      loadRecentClients();
    });
  }

  document.addEventListener('click', function (event) {
  const deletePersonalBtn = event.target.closest('.ycs-prep-delete-personal-photo-btn');
  if (deletePersonalBtn) {
    event.preventDefault();
    event.stopPropagation();
    archivePersonalStudioPhoto(String(deletePersonalBtn.dataset.photoId || '').trim());
    return;
  }

  const drapingLink = event.target.closest('a');
  if (drapingLink && drapingLink.closest('.ycs-prep-open-personal-photo-btn')) {
    return;
  }

  const personalBtn = event.target.closest('.ycs-prep-open-personal-photo-btn');
  if (personalBtn) {
    openPersonalPhotoInPrep(personalBtn);
    return;
  }

  const openBtn = event.target.closest('.ycs-prep-open-client-btn');
  const demoBtn = event.target.closest('.ycs-prep-open-demo-client-btn');
  if (demoBtn) {
    const demoClientId = String(demoBtn.dataset.demoClientId || '').trim();
    if (demoClientId) openFreeTrialClient(demoClientId);
    return;
  }

  if (!openBtn) return;

  const clientRecordId = String(openBtn.dataset.clientRecordId || '').trim();
  if (!clientRecordId) return;

  state.firstName = String(openBtn.dataset.firstName || '').trim() || state.firstName;
  state.lastName = String(openBtn.dataset.lastName || '').trim() || state.lastName;
  state.email = String(openBtn.dataset.email || '').trim() || state.email;

  if (firstNameInput) firstNameInput.value = state.firstName || '';
  if (lastNameInput) lastNameInput.value = state.lastName || '';
  if (emailInput) emailInput.value = state.email || '';

  updateCustomerMeta();
  fetchPhoto(clientRecordId);
});

document.addEventListener('keydown', function (event) {
  if (event.target.closest('a, button')) return;

  const personalBtn = event.target.closest('.ycs-prep-open-personal-photo-btn');
  if (!personalBtn) return;

  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault();
    openPersonalPhotoInPrep(personalBtn);
  }
});

  if (fileInput) {
    fileInput.addEventListener('change', function (e) {
      const file = e.target.files[0];
      if (!file) return;

      if (!file.type.startsWith('image/')) {
        alert('Please upload a valid image.');
        fileInput.value = '';
        return;
      }

      uploadOriginalPhoto(file);
    });
  }

  if (CAN_USE_CLIENT_MANAGEMENT && !IS_MEMBER_PHOTO_MODE && !IS_CATOOL_FREE_TRIAL_FLOW) {
  loadRecentClients();
}

  updateStatus();
updateCustomerMeta();
updateStartAnalysisLink();
updateBackLink();
resetControls();
syncVisibility();
loadPhotoPrepUsage();


if (IS_CATOOL_FREE_TRIAL_FLOW) {
  initSimpleAnalystFlow();
  return;
}

if (IS_PERSONAL_MODE || IS_DIY_MODE) {
  state.customerId = VIEWER_CUSTOMER_ID;
  state.clientRecordId = null;

  showLoadingView(IS_DIY_MODE ? 'Loading your photo...' : 'Loading your photos...');

  loadPersonalStudioPhotos()
    .then(function (photos) {
      if (IS_PERSONAL_MODE) {
        renderPersonalStudioPhotos(photos);
      }

      if (photos.length) {
        const selectedPhoto = initialPhotoId
          ? photos.find(function (photo) {
              return String(photo.photoId || '').trim() === initialPhotoId;
            }) || photos[0]
          : photos[0];
        state.selectedPersonalPhotoId = selectedPhoto.photoId || null;
        state.selectedPhotoSource = 'PersonalStudioPhotos';
        state.originalPhotoUrl = selectedPhoto.originalPhotoUrl || selectedPhoto.activePhotoUrl || null;
        state.adjustedPhotoUrl = selectedPhoto.adjustedPhotoUrl || null;
        state.activePhotoUrl = selectedPhoto.activePhotoUrl || selectedPhoto.adjustedPhotoUrl || selectedPhoto.originalPhotoUrl || null;
        state.currentBasePhotoUrl = state.activePhotoUrl || state.originalPhotoUrl || null;

        updateStatus();
        updateStartAnalysisLink();
        syncVisibility();
        showOriginalPhoto(state.originalPhotoUrl);

        if (state.activePhotoUrl) {
          showWorkingPhoto(state.activePhotoUrl);
        }
      } else {
        state.selectedPersonalPhotoId = null;
        state.originalPhotoUrl = null;
        state.adjustedPhotoUrl = null;
        state.activePhotoUrl = null;
        state.currentBasePhotoUrl = null;

        updateStatus();
        updateStartAnalysisLink();
        syncVisibility();
      }

      hideLoadingView();
    })
    .catch(function (error) {
      console.error(error);
      hideLoadingView();
      syncVisibility();
    });

  return;
}
  if (IS_MEMBER_PHOTO_MODE && initialPhotoId) {
  state.customerId = initialCustomerId;
  state.clientRecordId = null;
  state.workspaceOpen = true;

  fetchPhoto(initialCustomerId, {
    silentIfMissing: false,
    photoId: initialPhotoId,
    photoSource: initialPhotoSource || 'PersonalStudioPhotos',
    forceCustomerRecord: true,
    fallbackToLatestOnMissing: true
  });

  return;
}

if (IS_MEMBER_PHOTO_MODE && initialCustomerId) {
  state.customerId = initialCustomerId;
  state.clientRecordId = null;
  state.workspaceOpen = true;

  showLoadingView('Loading saved photo…');
  fetchPhoto(initialCustomerId, { silentIfMissing: true }).then(function () {
    hideLoadingView();
  });
  return;
}

if (initialClientRecordId) {
  state.clientRecordId = initialClientRecordId;
  state.customerId = null;
  state.workspaceOpen = true;

  fetchPhoto(initialClientRecordId, { silentIfMissing: false });
  return;
}

if (initialCustomerId && !IS_PERSONAL_MODE && !IS_MEMBER_PHOTO_MODE) {
  state.customerId = initialCustomerId;
  state.clientRecordId = null;
  state.workspaceOpen = true;

  fetchPhoto(initialCustomerId, {
    silentIfMissing: true,
    forceCustomerRecord: true
  });
}
})();
</script>
