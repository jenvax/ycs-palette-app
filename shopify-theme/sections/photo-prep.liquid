function updateStatus() {
    if (originalStatusEl) originalStatusEl.textContent = state.originalPhotoUrl ? 'Saved' : 'Not saved';
    if (adjustedStatusEl) adjustedStatusEl.textContent = state.adjustedPhotoUrl ? 'Saved' : 'Not saved';

    if (!activeStatusEl) return;

    if (state.activePhotoUrl && state.adjustedPhotoUrl && state.activePhotoUrl === state.adjustedPhotoUrl) {
      activeStatusEl.textContent = 'Adjusted photo';
    } else if (state.activePhotoUrl && state.originalPhotoUrl && state.activePhotoUrl === state.originalPhotoUrl) {
      activeStatusEl.textContent = 'Original photo';
    } else if (state.activePhotoUrl) {
      activeStatusEl.textContent = 'Saved';
    } else {
      activeStatusEl.textContent = 'None';
    }
  }

  function applyPreviewZoom() {
  const zoom = state.previewZoom / 100;
  const transform =
    'translate(calc(-50% + ' + state.previewOffsetX + 'px), calc(-50% + ' + state.previewOffsetY + 'px)) scale(' + zoom + ')';

  if (workingImg) workingImg.style.transform = transform;
  if (originalImg) originalImg.style.transform = transform;
}

function escapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

