  async function fetchPhoto(recordId, options) {
  options = options || {};

  const silentIfMissing = !!options.silentIfMissing;
  const optionPhotoId = String(options.photoId || '').trim();
  const optionPhotoSource = String(options.photoSource || '').trim();
  const forceCustomerRecord = !!options.forceCustomerRecord;

  if (optionPhotoId) {
    state.selectedPersonalPhotoId = optionPhotoId;
  }

  if (optionPhotoSource) {
    state.selectedPhotoSource = optionPhotoSource;
  }

  if (!recordId) {
    if (!silentIfMissing) alert('Missing record ID.');
    return;
  }

  const shouldLoadAsClientRecord =
    !forceCustomerRecord &&
    !IS_MEMBER_PHOTO_MODE &&
    CAN_USE_CLIENT_MANAGEMENT &&
    String(recordId) !== String(VIEWER_CUSTOMER_ID);

  if (shouldLoadAsClientRecord) {
    state.clientRecordId = recordId;
    state.customerId = null;
  } else {
    state.customerId = recordId;
    state.clientRecordId = null;
  }

  state.workspaceOpen = true;

  if (createClientPanel) {
    createClientPanel.hidden = true;
  }

  closeEditClientPanel();
  showLoadingView('Loading saved photo…');
  showLoading('Loading saved photo…');

  try {
    const lookupParams = new URLSearchParams();

    if (shouldLoadAsClientRecord) {
      lookupParams.set('clientRecordId', recordId);
    } else {
      lookupParams.set('customerId', recordId);
    }

    if (optionPhotoId) {
      lookupParams.set('photoId', optionPhotoId);
    }

    if (optionPhotoSource) {
      lookupParams.set('photoSource', optionPhotoSource);
    }

    const lookupUrl = APP_BASE_URL + '/api/get-photo?' + lookupParams.toString();

    const res = await fetch(lookupUrl);
    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.error || 'Could not load photo');
    }

    state.originalPhotoUrl = data.originalPhotoUrl || null;
    state.adjustedPhotoUrl = data.adjustedPhotoUrl || null;
    state.activePhotoUrl = data.activePhotoUrl || data.photoUrl || null;
    state.currentBasePhotoUrl = state.activePhotoUrl || state.originalPhotoUrl || null;

    state.justUploadedNewPhoto = false;

    state.firstName = data.firstName || state.firstName || null;
