          '<span>Manual rating</span>' +
          '<select name="human_status" required>' +
            '<option value="">Select rating</option>' +
            '<option value="pass">Pass</option>' +
            '<option value="warning">Warning</option>' +
            '<option value="reject">Reject</option>' +
          '</select>' +
        '</label>' +
        '<label class="ycs-photo-prep-quality__field">' +
          '<span>AI feedback</span>' +
          '<select name="admin_feedback" required>' +
            '<option value="">Select feedback</option>' +
            feedbackOptions +
          '</select>' +
        '</label>' +
      '</div>' +
      '<label class="ycs-photo-prep-quality__field">' +
        '<span>Issue tags</span>' +
        '<div class="ycs-photo-prep-quality__tags">' + issueTags + '</div>' +
      '</label>' +
      '<label class="ycs-photo-prep-quality__field">' +
        '<span>Notes</span>' +
        '<textarea name="admin_notes" maxlength="1000" placeholder="Add your notes about this photo quality result."></textarea>' +
      '</label>' +
