async function loadSelectedPersonalStudioPhoto(photoId) {
  if (!photoId || !APP_BASE_URL) return null;

  try {
    showLoadingView('Loading selected photo…');

    const response = await fetch(
      APP_BASE_URL +
        '/api/get-personal-studio-photo?' +
        new URLSearchParams({
          photoId: photoId
        }).toString()
    );

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Could not load selected photo');
    }

    const photo = data.photo || null;
    if (!photo) {
      throw new Error('Selected photo was not found');
    }

    state.selectedPersonalPhotoId = photo.photoId || photoId;
    state.customerId = photo.customerId || state.customerId || initialCustomerId;
    state.clientRecordId = null;

    state.originalPhotoUrl = photo.originalPhotoUrl || null;
    state.adjustedPhotoUrl = photo.adjustedPhotoUrl || null;
    state.activePhotoUrl =
      photo.activePhotoUrl ||
      photo.adjustedPhotoUrl ||
      photo.originalPhotoUrl ||
      null;

    state.currentBasePhotoUrl = state.activePhotoUrl;
    state.justUploadedNewPhoto = false;
    state.hasLoadedPhoto = true;
    state.workspaceOpen = true;

    updateCustomerMeta();
    updateStatus();
    updateStartAnalysisLink();
    syncVisibility();

    showOriginalPhoto(state.originalPhotoUrl || state.activePhotoUrl);
    resetControls();
    showWorkingPhoto(state.activePhotoUrl);

    hideLoadingView();

    return photo;
  } catch (error) {
    console.error('Failed to load selected personal studio photo', error);
    hideLoadingView();
    alert(error.message || 'Could not load selected photo.');
    return null;
  }
}
async function loadPersonalStudioPhotos() {
  if (!(IS_PERSONAL_MODE || IS_DIY_MODE) || !VIEWER_CUSTOMER_ID || !APP_BASE_URL) return [];

  try {
    const response = await fetch(
      APP_BASE_URL +
        '/api/get-personal-studio-photos?' +
        new URLSearchParams({
          customerId: VIEWER_CUSTOMER_ID
        }).toString()
    );

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Could not load personal studio photos');
    }

    return Array.isArray(data.photos) ? data.photos : [];
  } catch (error) {
    console.error('Failed to load personal studio photos', error);
    return [];
  }
}

