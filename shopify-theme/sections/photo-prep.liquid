async function archivePersonalStudioPhoto(photoId) {
  if (!IS_PERSONAL_MODE || !photoId || !VIEWER_CUSTOMER_ID || !APP_BASE_URL) return;

  if (!confirm('Delete this photo from your gallery?')) {
    return;
  }

  try {
    showLoading('Deleting photo…');

    const response = await fetch(APP_BASE_URL + '/api/archive-personal-studio-photo', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        customerId: VIEWER_CUSTOMER_ID,
        photoId: photoId
      })
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.error || 'Could not delete photo');
    }

    clearSelectedPersonalPhoto(photoId);

    const photos = await loadPersonalStudioPhotos();
    renderPersonalStudioPhotos(photos);

    hideLoading();
  } catch (error) {
    hideLoading();
    console.error('Failed to delete personal studio photo', error);
    alert(error.message || 'Could not delete photo.');
  }
}

