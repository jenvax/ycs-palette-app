{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
{% assign ycs_page_url = ycs_header_content
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '\\u0026', '&'
  | replace: '%3F', '?'
  | replace: '%3D', '='
%}

{% assign is_personal_mode_request = false %}
{% if ycs_page_url contains 'mode=personal' %}
  {% assign is_personal_mode_request = true %}
{% endif %}

{% assign is_member_mode_request = false %}
{% if ycs_page_url contains 'mode=member' %}
  {% assign is_member_mode_request = true %}
{% endif %}

{% assign is_trade_mode_request = false %}
{% if ycs_page_url contains 'mode=trade' %}
  {% assign is_trade_mode_request = true %}
{% endif %}

{% assign is_sample_trial_request = false %}
{% if ycs_page_url contains 'trial=sample' %}
  {% assign is_sample_trial_request = true %}
{% endif %}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}

{% assign is_trade = false %}
{% if palette_access_string contains ',TRADE,' %}
  {% assign is_trade = true %}
{% endif %}

{% assign is_catool = false %}
{% if palette_access_string contains ',CATOOL,' %}
  {% assign is_catool = true %}
{% endif %}

{% assign is_catool_growth = false %}
{% if palette_access_string contains ',CATOOLGROWTH,' %}
  {% assign is_catool_growth = true %}
{% endif %}

{% assign is_catool_free = false %}
{% if palette_access_string contains ',CATOOLFREE,' %}
  {% assign is_catool_free = true %}
{% endif %}

{% assign is_diy_catool = false %}
{% if palette_access_string contains ',DIYCATOOL,' %}
  {% assign is_diy_catool = true %}
{% endif %}

{% assign is_vip = false %}
{% if palette_access_string contains ',VIP,' %}
  {% assign is_vip = true %}
{% endif %}

{% assign has_draping_studio_starter = false %}
{% if palette_access_string contains ',DRAPINGSTUDIOSTARTER,' %}
  {% assign has_draping_studio_starter = true %}
{% endif %}

{% assign has_draping_studio = false %}
{% if palette_access_string contains ',DRAPINGSTUDIO,' %}
  {% assign has_draping_studio = true %}
{% endif %}

{% assign has_draping_studio_access = false %}
{% if has_draping_studio_starter or has_draping_studio %}
  {% assign has_draping_studio_access = true %}
{% endif %}

{% assign is_sample_user = false %}
{% if palette_access_string contains ',SAMPLE,' %}
  {% assign is_sample_user = true %}
{% endif %}

{% assign can_use_personal_photo_prep = false %}
{% if is_admin or is_vip or has_draping_studio_access or is_sample_user or is_sample_trial_request %}
  {% assign can_use_personal_photo_prep = true %}
{% endif %}

{% assign is_simple_analyst = false %}
{% if is_catool or is_catool_growth or is_catool_free %}
  {% assign is_simple_analyst = true %}
{% endif %}

{% assign can_use_client_management = false %}
{% if is_admin or is_trade or is_simple_analyst %}
  {% assign can_use_client_management = true %}
{% endif %}

{% assign can_use_photo_prep = false %}
{% if is_admin or is_trade or is_simple_analyst or is_diy_catool or can_use_personal_photo_prep %}
  {% assign can_use_photo_prep = true %}
{% endif %}

<div
  class="ycs-photo-prep-app"
  data-is-sample-trial-request="{% if is_sample_trial_request %}true{% else %}false{% endif %}"
  data-is-admin="{% if is_admin %}true{% else %}false{% endif %}"
  data-is-trade="{% if is_trade %}true{% else %}false{% endif %}"
  data-is-catool="{% if is_catool %}true{% else %}false{% endif %}"
  data-is-catool-growth="{% if is_catool_growth %}true{% else %}false{% endif %}"
  data-is-catool-free="{% if is_catool_free %}true{% else %}false{% endif %}"
  data-is-diy-catool="{% if is_diy_catool %}true{% else %}false{% endif %}"
  data-is-simple-analyst="{% if is_simple_analyst %}true{% else %}false{% endif %}"
  data-can-use-photo-prep="{% if can_use_photo_prep %}true{% else %}false{% endif %}"
  data-is-vip="{% if is_vip %}true{% else %}false{% endif %}"
data-has-draping-studio="{% if has_draping_studio_access %}true{% else %}false{% endif %}"
data-has-draping-studio-starter="{% if has_draping_studio_starter %}true{% else %}false{% endif %}"
data-has-draping-studio-full="{% if has_draping_studio %}true{% else %}false{% endif %}"
data-is-sample-user="{% if is_sample_user %}true{% else %}false{% endif %}"
  data-customer-id="{{ customer.id }}"
  data-app-base-url="https://ycs-palette-app.vercel.app"
>
  {% if customer == nil %}
    <div class="ycs-photo-prep-card ycs-photo-prep-card--center">
      <h1>Sign in to access Photo Prep</h1>
      <a href="{{ routes.account_login_url }}" class="ycs-photo-prep-btn">Sign In</a>
    </div>

  {% elsif can_use_photo_prep != true %}
  <div class="ycs-photo-prep-card ycs-photo-prep-card--center">
    <h1>Photo Prep</h1>
    <p>This tool is not available for your account.</p>
  </div>

  {% else %}
    
    <div class="ycs-photo-prep-topbar">
      <a id="ycs-photo-prep-back-link" href="/pages/my-palettes" class="ycs-photo-prep-back">← Back</a>
    </div>

    <div class="ycs-photo-prep-header">
  <p class="ycs-photo-prep-kicker">Your Color Style</p>
  <h1 class="ycs-photo-prep-title">Photo Prep</h1>
  <p class="ycs-photo-prep-subtitle">
  {% if is_personal_mode_request %}
    Upload a photo, make adjustments, then continue to Draping Studio.
  {% else %}
    Load or upload a customer photo, make color adjustments, then continue to the Color Analysis Tool.
  {% endif %}
</p>
  <p id="ycs-photo-prep-usage-message" class="ycs-photo-prep-usage-message" hidden></p>
</div>

    <div id="ycs-prep-customer-meta" class="ycs-photo-prep-meta" hidden>
      <div class="ycs-photo-prep-meta-head">
        <div class="ycs-photo-prep-meta-copy">
          <p><strong>Customer:</strong> <span id="ycs-prep-customer-name">—</span></p>
          <p><strong>Email:</strong> <span id="ycs-prep-customer-email">—</span></p>
        </div>

        <div class="ycs-photo-prep-meta-actions">
          <button type="button" id="ycs-prep-show-client-list-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
  Manage Clients
</button>

          <button type="button" id="ycs-prep-edit-client-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
            Edit Client Info
          </button>
        </div>
      </div>

      <div id="ycs-prep-edit-client-panel" class="ycs-photo-prep-edit-panel" hidden>
        <div class="ycs-photo-prep-customer-details">
          <input type="text" id="ycs-prep-edit-first-name" class="ycs-photo-prep-input" placeholder="First name" />
          <input type="text" id="ycs-prep-edit-last-name" class="ycs-photo-prep-input" placeholder="Last name" />
          <input type="email" id="ycs-prep-edit-email" class="ycs-photo-prep-input" placeholder="Email (optional)" />
        </div>

        <div class="ycs-photo-prep-actions">
          <button type="button" id="ycs-prep-save-client-btn" class="ycs-photo-prep-btn">
            Save Changes
          </button>
          <button type="button" id="ycs-prep-cancel-client-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
            Cancel
          </button>
        </div>
      </div>
    </div>

    <div class="ycs-photo-prep-customer" id="ycs-prep-create-client-panel" {% if is_personal_mode_request or is_member_mode_request %}hidden{% endif %}>
      {% if can_use_client_management and is_personal_mode_request != true %}
        <label class="ycs-photo-prep-label">{% if is_catool_free %}Free Trial Clients{% else %}Create Client{% endif %}</label>

        {% unless is_catool_free %}
        <div class="ycs-photo-prep-customer-details">
          <input type="text" id="ycs-prep-first-name" class="ycs-photo-prep-input" placeholder="First name" />
          <input type="text" id="ycs-prep-last-name" class="ycs-photo-prep-input" placeholder="Last name" />
          <input type="email" id="ycs-prep-email" class="ycs-photo-prep-input" placeholder="Email (optional)" />
        </div>

        <div class="ycs-photo-prep-customer-row" style="margin-top: 10px;">
          <button type="button" id="ycs-prep-create-client" class="ycs-photo-prep-btn">
            Create Client
          </button>
        </div>

        <p class="ycs-photo-prep-help">
          Create, save, edit, and reopen client analyses from your client list.
        </p>
        {% else %}
        <p class="ycs-photo-prep-help">
          Choose one of the preloaded trial clients to explore Photo Prep and the Color Analysis Tool.
        </p>
        {% endunless %}

        <div id="ycs-prep-recent-clients-panel" class="ycs-photo-prep-recent-clients">
          <div class="ycs-photo-prep-recent-head">
            <label class="ycs-photo-prep-label" style="margin-bottom: 0;">{% if is_catool_free %}Trial Clients{% else %}Recent Clients{% endif %}</label>
            {% unless is_catool_free %}
            <button type="button" id="ycs-prep-refresh-clients" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
              Refresh
            </button>
            {% endunless %}
          </div>

          <div id="ycs-prep-recent-clients-list" class="ycs-photo-prep-recent-list">
            <p class="ycs-photo-prep-help" style="margin-top: 0;">No recent clients yet.</p>
          </div>
        </div>
             {% endif %}
      
    </div>

    <div id="ycs-prep-client-created-note" class="ycs-photo-prep-help" hidden>
      Client saved and ready for photo upload.
    </div>
    <div id="ycs-prep-personal-library" class="ycs-photo-prep-panel" hidden>
  <div class="ycs-photo-prep-personal-head">
    <div>
      <h2 class="ycs-photo-prep-panel-title" style="margin-bottom: 4px;">My Photos</h2>
      <p id="ycs-prep-personal-library-help" class="ycs-photo-prep-help" style="margin-top: 0;">
  Upload a photo to begin.
</p>
    </div>

    <button type="button" id="ycs-prep-personal-upload-btn" class="ycs-photo-prep-btn">
      Upload New Photo
    </button>
  </div>

  <div id="ycs-prep-personal-library-empty" class="ycs-photo-prep-empty" hidden>
    <p>No saved photos yet.</p>
  </div>

  <div id="ycs-prep-personal-library-grid" class="ycs-photo-prep-personal-grid"></div>
</div>
<div id="ycs-photo-prep-loading-view" class="ycs-photo-prep-loading-view" hidden>
  <div class="ycs-photo-prep-loading-view__inner">
    <p class="ycs-photo-prep-kicker">Your Color Style</p>
    <h2 class="ycs-photo-prep-loading-view__title">Loading photo…</h2>
    <p id="ycs-photo-prep-loading-view-text" class="ycs-photo-prep-loading-view__text">
      Getting everything ready.
    </p>

    <div class="ycs-photo-prep-loading-view__grid">
      <div class="ycs-photo-prep-skeleton-stage"></div>
      <div class="ycs-photo-prep-skeleton-stage"></div>
    </div>
  </div>
</div>
    <div class="ycs-photo-prep-workspace" id="ycs-photo-prep-workspace" hidden>
      <div class="ycs-photo-prep-layout">
        <div class="ycs-photo-prep-panel">
          <div class="ycs-photo-prep-compare">
            <div class="ycs-photo-prep-pane">
              <div class="ycs-photo-prep-pane-head">
                <h3>Original</h3>
              </div>
              <div class="ycs-photo-prep-stage">
                <div id="ycs-prep-original-empty" class="ycs-photo-prep-empty">
                  <p>No original photo loaded yet.</p>
                </div>

                <div id="ycs-prep-original-wrap" class="ycs-photo-prep-preview-wrap" hidden>
                  <img id="ycs-prep-original-img" class="ycs-photo-prep-preview-img" alt="Original photo preview" />
                </div>
              </div>
            </div>

            <div class="ycs-photo-prep-pane">
              <div class="ycs-photo-prep-pane-head">
                <h3>Working</h3>
              </div>
              <div class="ycs-photo-prep-stage">
                <input type="file" id="ycs-prep-file-input" accept="image/*" hidden />

                <div id="ycs-prep-working-empty" class="ycs-photo-prep-empty">
                  <p>No working photo loaded yet.</p>
                  <button type="button" id="ycs-prep-upload-btn" class="ycs-photo-prep-btn">
                    Upload Photo
                  </button>
                </div>

                <div id="ycs-prep-working-wrap" class="ycs-photo-prep-preview-wrap" hidden>
                  <img id="ycs-prep-working-img" class="ycs-photo-prep-preview-img" alt="Working photo preview" />
                </div>

                <div id="ycs-prep-loading" class="ycs-photo-prep-loading" hidden>
                  <div class="ycs-photo-prep-loading-dots"><span></span><span></span><span></span></div>
                  <p id="ycs-prep-loading-text">Loading…</p>
                </div>
              </div>
            </div>
          </div>

          <div class="ycs-photo-prep-photo-actions">
            {% unless is_simple_analyst or is_personal_mode_request or is_member_mode_request %}
<button type="button" id="ycs-prep-replace-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
  Replace Photo
</button>

{% endunless %}

{% if is_admin and is_member_mode_request %}
<button type="button" id="ycs-prep-add-member-photo-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
  Upload New Member Photo
</button>
{% endif %}
          </div>

          <div class="ycs-photo-prep-status">
            <p><strong>Original:</strong> <span id="ycs-prep-original-status">—</span></p>
            <p><strong>Adjusted:</strong> <span id="ycs-prep-adjusted-status">—</span></p>
            <p><strong>Active:</strong> <span id="ycs-prep-active-status">—</span></p>
          </div>

          {% if is_admin %}
            <div id="ycs-prep-photo-quality-result" class="ycs-photo-prep-quality" hidden></div>
          {% endif %}
        </div>

        <div class="ycs-photo-prep-panel">
          <h2 class="ycs-photo-prep-panel-title">Adjustments</h2>

          <div class="ycs-photo-prep-control">
            <div class="ycs-photo-prep-control-head">
              <label for="ycs-prep-zoom">Zoom</label>
              <span id="ycs-prep-zoom-value">100%</span>
            </div>
            <input type="range" id="ycs-prep-zoom" min="70" max="260" step="1" value="100" />
          </div>

          <div class="ycs-photo-prep-control">
            <div class="ycs-photo-prep-control-head">
              <label for="ycs-prep-temperature">Temperature</label>
              <span id="ycs-prep-temperature-value" class="ycs-photo-prep-temp-value">Neutral</span>
            </div>
            <input type="range" id="ycs-prep-temperature" min="-80" max="80" step="1" value="0" />
          </div>

          <div class="ycs-photo-prep-control">
            <div class="ycs-photo-prep-control-head">
              <label for="ycs-prep-brightness">Brightness</label>
              <span id="ycs-prep-brightness-value">100%</span>
            </div>
            <input type="range" id="ycs-prep-brightness" min="50" max="150" step="1" value="100" />
          </div>

          <div class="ycs-photo-prep-control">
            <div class="ycs-photo-prep-control-head">
              <label for="ycs-prep-contrast">Contrast</label>
              <span id="ycs-prep-contrast-value">100%</span>
            </div>
            <input type="range" id="ycs-prep-contrast" min="50" max="150" step="1" value="100" />
          </div>

          <div class="ycs-photo-prep-actions">
            <button type="button" id="ycs-prep-reset-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
              Reset Controls
            </button>

            <button type="button" id="ycs-prep-use-original-btn" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
              Use Original Photo
            </button>

            <button type="button" id="ycs-prep-save-btn" class="ycs-photo-prep-btn">
              Save Adjusted Photo
            </button>

            <a id="ycs-prep-start-analysis-btn" href="/pages/color-analysis-tool" class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary">
  Continue
</a>
{% if is_admin %}
  <a
    id="ycs-prep-start-signature-analysis-btn"
    href="/pages/signature-color-analysis"
    class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary"
  >
    Lip & Draping Studio
  </a>
{% endif %}
          </div>

          <p class="ycs-photo-prep-help">
            Use this page to color-correct the photo only. Zoom here is temporary and is not saved. Face positioning happens in the Color Analysis Tool.
          </p>
        </div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .ycs-photo-prep-app {
    max-width: 1240px;
    margin: 0 auto;
    padding: 18px;
  }

  .ycs-photo-prep-topbar {
    margin-bottom: 10px;
  }

  .ycs-photo-prep-back {
    text-decoration: none;
    color: #444;
    font-weight: 600;
    font-size: 14px;
  }

  .ycs-photo-prep-header {
    margin-bottom: 14px;
  }

  .ycs-photo-prep-kicker {
    margin: 0 0 6px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8b7d6b;
  }

  .ycs-photo-prep-title {
    margin: 0 0 6px;
    font-size: 28px;
    line-height: 1.08;
  }

  .ycs-photo-prep-subtitle {
    margin: 0;
    font-size: 14px;
    color: #5f5a54;
  }

  .ycs-photo-prep-card,
  .ycs-photo-prep-panel,
  .ycs-photo-prep-customer {
    background: #fff;
    border: 1px solid #ece7df;
    border-radius: 20px;
    padding: 16px;
  }

  .ycs-photo-prep-card--center {
    max-width: 560px;
    margin: 60px auto;
    text-align: center;
  }

  .ycs-photo-prep-meta {
    margin-bottom: 14px;
    background: #fff;
    border: 1px solid #ece7df;
    border-radius: 16px;
    padding: 12px 14px;
    display: grid;
    gap: 4px;
  }

  .ycs-photo-prep-meta[hidden] {
    display: none !important;
  }

  .ycs-photo-prep-meta p {
    margin: 0;
    font-size: 14px;
    color: #4f4942;
  }

  .ycs-photo-prep-customer {
    margin-bottom: 14px;
  }

  .ycs-photo-prep-customer-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .ycs-photo-prep-customer-details {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 10px;
    margin-top: 10px;
  }

  .ycs-photo-prep-input {
    flex: 1 1 280px;
    min-height: 44px;
    border: 1px solid #d8cfc3;
    border-radius: 12px;
    padding: 0 14px;
    font-size: 14px;
  }

  .ycs-photo-prep-workspace[hidden] {
    display: none !important;
  }
.ycs-photo-prep-usage-message[hidden] {
  display: none !important;
}

.ycs-photo-prep-usage-message {
  display: inline-flex;
  align-items: center;
  margin: 10px 0 0;
  padding: 6px 10px;
  border-radius: 999px;
  background: #fff4d6;
  color: #8a5a00;
  font-size: 12px;
  line-height: 1;
  font-weight: 700;
  width: fit-content;
}
  .ycs-photo-prep-meta-head {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ycs-photo-prep-meta-copy {
    display: grid;
    gap: 4px;
  }

  .ycs-photo-prep-meta-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ycs-photo-prep-edit-panel {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid #ece7df;
  }

  .ycs-photo-prep-edit-panel[hidden] {
    display: none !important;
  }

  .ycs-photo-prep-recent-clients {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #ece7df;
  }

  .ycs-photo-prep-recent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .ycs-photo-prep-recent-list {
    display: grid;
    gap: 10px;
  }

  .ycs-photo-prep-recent-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 12px 14px;
    border: 1px solid #ece7df;
    border-radius: 14px;
    background: #faf7f2;
  }

  .ycs-photo-prep-recent-copy {
    min-width: 0;
  }

  .ycs-photo-prep-recent-name {
    margin: 0 0 3px;
    font-size: 14px;
    font-weight: 600;
    color: #2f2a25;
  }

  .ycs-photo-prep-recent-meta {
    margin: 0;
    font-size: 12px;
    color: #6b645c;
  }

  .ycs-photo-prep-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 16px;
    align-items: start;
  }

  .ycs-photo-prep-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .ycs-photo-prep-pane {
    min-width: 0;
  }

  .ycs-photo-prep-pane-head {
    margin-bottom: 8px;
  }

  .ycs-photo-prep-pane-head h3 {
    margin: 0;
    font-size: 15px;
    color: #4f4942;
  }

  .ycs-photo-prep-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 0.86 / 1;
    max-height: 560px;
    border-radius: 18px;
    border: 1px dashed #d8cfc3;
    background: #f6f1ea;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ycs-photo-prep-stage,
.ycs-photo-prep-preview-wrap,
.ycs-photo-prep-preview-img {
  touch-action: none;
  overscroll-behavior: contain;
}

  .ycs-photo-prep-empty {
    display: grid;
    gap: 12px;
    justify-items: center;
    text-align: center;
    color: #6b645c;
    padding: 20px;
  }

  .ycs-photo-prep-empty[hidden] {
  display: none !important;
}

  .ycs-photo-prep-preview-wrap {
    position: absolute;
    inset: 14px;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .ycs-photo-prep-preview-img {
    position: absolute;
    top: 50%;
    left: 50%;
    max-width: 80%;
    max-height: 90%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    transform-origin: center center;
    display: block;
