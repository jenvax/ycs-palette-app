      hasDrapingStudio: HAS_DRAPING_STUDIO_ACCESS,
      hasDrapingStudioStarter: HAS_DRAPING_STUDIO_STARTER,
      hasDrapingStudioFull: HAS_DRAPING_STUDIO_FULL,
      isSampleUser: (IS_SAMPLE_USER || IS_SAMPLE_TRIAL_REQUEST)
    })
  });

  const rawText = await response.text();
  let data = {};

  try {
    data = rawText ? JSON.parse(rawText) : {};
  } catch (parseError) {
    console.error('removeBackground returned non-JSON:', rawText);
    throw new Error('Server returned an invalid response');
  }

  if (!response.ok) {
    throw new Error(data.details || data.error || 'Background removal failed');
  }

  if (!data.image) {
    throw new Error('No processed image was returned');
  }

  return data.image;
}

  async function buildAdjustedImageDataUrl() {
    if (!state.currentBasePhotoUrl) {
      throw new Error('No photo loaded');
    }

    const img = await new Promise(function (resolve, reject) {
      const image = new Image();
      image.crossOrigin = 'anonymous';
      image.onload = function () { resolve(image); };
      image.onerror = reject;
      image.src = state.currentBasePhotoUrl;
    });

    const canvas = document.createElement('canvas');
    canvas.width = img.naturalWidth;
    canvas.height = img.naturalHeight;

    const ctx = canvas.getContext('2d');
    const brightness = state.controls.brightness / 100;
    const contrast = state.controls.contrast / 100;
    const temperature = state.controls.temperature;

    ctx.filter = 'brightness(' + brightness + ') contrast(' + contrast + ')';
    ctx.drawImage(img, 0, 0);

    if (temperature !== 0) {
      const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imageData.data;

      for (let i = 0; i < data.length; i += 4) {
        let r = data[i];
        let g = data[i + 1];
        let b = data[i + 2];

        if (temperature > 0) {
          const t = temperature;
          r = clamp(r + t * 0.45, 0, 255);
          g = clamp(g + t * 0.25, 0, 255);
          b = clamp(b - t * 0.75, 0, 255);
        } else {
          const cool = Math.abs(temperature);
          r = clamp(r - cool * 0.35, 0, 255);
          g = clamp(g - cool * 0.45, 0, 255);
          b = clamp(b + cool * 0.9, 0, 255);
        }

        data[i] = r;
        data[i + 1] = g;
        data[i + 2] = b;
      }

      ctx.putImageData(imageData, 0, 0);
    }

    return canvas.toDataURL('image/webp', 0.9);
  }

  async function applyPreviewFilters() {
    if (!workingImg) return;

    const isNeutral =
      state.controls.brightness === 100 &&
      state.controls.contrast === 100 &&
      state.controls.temperature === 0;

    if (isNeutral) {
      const baseUrl = state.activePhotoUrl || state.currentBasePhotoUrl || state.originalPhotoUrl || '';
      if (baseUrl && workingImg.src !== baseUrl) {
        workingImg.src = baseUrl;
      }
      return;
    }

    try {
      const previewDataUrl = await buildAdjustedImageDataUrl();
      if (previewDataUrl) {
        workingImg.src = previewDataUrl;
      }
    } catch (error) {
      console.error('Preview render failed:', error);
    }
  }

  const prepPointers = new Map();
let prepPinchStartDistance = 0;
let prepPinchStartZoom = 100;
let prepDragStartX = 0;
let prepDragStartY = 0;
let prepDragOffsetX = 0;
let prepDragOffsetY = 0;
let prepIsDragging = false;

function getPointerDistance(a, b) {
  const dx = b.clientX - a.clientX;
  const dy = b.clientY - a.clientY;
  return Math.sqrt(dx * dx + dy * dy);
}

function bindPrepPinch(el) {
  if (!el) return;

  el.addEventListener('pointerdown', function (e) {
  prepPointers.set(e.pointerId, e);
  try { el.setPointerCapture(e.pointerId); } catch (_) {}

  if (prepPointers.size === 1) {
    prepIsDragging = true;
    prepDragStartX = e.clientX;
    prepDragStartY = e.clientY;
    prepDragOffsetX = state.previewOffsetX;
    prepDragOffsetY = state.previewOffsetY;
  }
});

  el.addEventListener('pointermove', function (e) {
    if (!prepPointers.has(e.pointerId)) return;
    prepPointers.set(e.pointerId, e);
    if (prepPointers.size === 1 && prepIsDragging) {
  e.preventDefault();

  state.previewOffsetX = prepDragOffsetX + (e.clientX - prepDragStartX);
  state.previewOffsetY = prepDragOffsetY + (e.clientY - prepDragStartY);

  applyPreviewZoom();
  return;
}
    if (prepPointers.size === 2) {
      e.preventDefault();
      const pts = Array.from(prepPointers.values());
      const distance = getPointerDistance(pts[0], pts[1]);

      if (!prepPinchStartDistance) {
        prepPinchStartDistance = distance;
        prepPinchStartZoom = state.previewZoom;
        return;
      }

      const nextZoom = Math.max(70, Math.min(260, Math.round(
        prepPinchStartZoom * (distance / prepPinchStartDistance)
      )));

      state.previewZoom = nextZoom;
      if (zoomEl) zoomEl.value = String(nextZoom);
      if (zoomValueEl) zoomValueEl.textContent = nextZoom + '%';
      applyPreviewZoom();
    }
  }, { passive: false });

  function clearPointer(e) {
  prepPointers.delete(e.pointerId);

  if (prepPointers.size < 2) {
    prepPinchStartDistance = 0;
  }

  if (prepPointers.size === 0) {
    prepIsDragging = false;
  }
}

  el.addEventListener('pointerup', clearPointer);
  el.addEventListener('pointercancel', clearPointer);
}

bindPrepPinch(originalWrap);
bindPrepPinch(workingWrap);

