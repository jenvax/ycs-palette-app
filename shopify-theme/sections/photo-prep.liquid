  async function loadPhotoPrepUsage() {
  if (IS_CATOOL_FREE_TRIAL_FLOW) {
    if (photoPrepUsageMessageEl) photoPrepUsageMessageEl.hidden = true;
    state.canUploadPhoto = false;
    if (uploadBtn) uploadBtn.hidden = true;
    if (replaceBtn) replaceBtn.hidden = true;
    if (personalUploadBtn) personalUploadBtn.hidden = true;
    return;
  }

  if (!photoPrepUsageMessageEl || !VIEWER_CUSTOMER_ID || !APP_BASE_URL) return;

  photoPrepUsageMessageEl.hidden = true;
  photoPrepUsageMessageEl.textContent = '';

  try {
    const response = await fetch(
  APP_BASE_URL +
    '/api/get-upload-usage?' +
    new URLSearchParams({
      customerId: VIEWER_CUSTOMER_ID,
      tool: IS_PERSONAL_MODE ? 'photo-draping' : 'photo-prep',
      mode: IS_PERSONAL_MODE ? 'personal' : (IS_DIY_MODE ? 'diy' : 'trade'),
      isAdmin: IS_ADMIN ? 'true' : 'false',
      isTrade: IS_TRADE ? 'true' : 'false',
      isCatool: IS_CATOOL ? 'true' : 'false',
      isCatoolGrowth: IS_CATOOL_GROWTH ? 'true' : 'false',
      isCatoolFree: IS_CATOOL_FREE ? 'true' : 'false',
      isDiyCatool: IS_DIY_CATOOL ? 'true' : 'false',
      isVip: IS_VIP ? 'true' : 'false',
