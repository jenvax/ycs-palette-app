personalLibraryEmptyEl.hidden = true;

  personalLibraryGridEl.innerHTML = photos.map(function (photo) {
    const thumb = photo.activePhotoUrl || photo.adjustedPhotoUrl || photo.originalPhotoUrl || '';
    const photoId = String(photo.photoId || '').trim();
    const updatedAt = photo.updatedAt
      ? new Date(photo.updatedAt).toLocaleDateString()
      : '';
    const drapeQuery = new URLSearchParams({
      mode: 'personal',
