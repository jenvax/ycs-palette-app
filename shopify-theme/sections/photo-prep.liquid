function renderPhotoQualityResult(photoQuality) {
  if (!IS_ADMIN || !photoQualityResultEl) return;

  if (!photoQuality) {
    photoQualityResultEl.hidden = true;
    photoQualityResultEl.innerHTML = '';
    return;
  }

  if (photoQuality.error) {
    photoQualityResultEl.innerHTML =
      '<div class="ycs-photo-prep-quality__head">' +
        '<p class="ycs-photo-prep-quality__title">Photo quality check</p>' +
        '<p class="ycs-photo-prep-quality__score">Not completed</p>' +
      '</div>' +
      '<p class="ycs-photo-prep-quality__meta">' + escapeHtml(photoQuality.details || photoQuality.error) + '</p>';
    photoQualityResultEl.hidden = false;
    return;
  }

  const issues = Array.isArray(photoQuality.issues) ? photoQuality.issues : [];
  const recommendations = Array.isArray(photoQuality.recommendations) ? photoQuality.recommendations : [];
  const issueItems = issues.length
    ? issues.map(function (issue) { return '<li>' + escapeHtml(issue) + '</li>'; }).join('')
    : '<li>No major issues detected.</li>';
  const recommendationItems = recommendations.length
    ? recommendations.map(function (item) { return '<li>' + escapeHtml(item) + '</li>'; }).join('')
    : '';
  const saveWarning = photoQuality.evaluation_save_error
    ? '<p class="ycs-photo-prep-quality__meta">' + escapeHtml(photoQuality.evaluation_save_error) + '</p>'
    : '';

  photoQualityResultEl.innerHTML =
    '<div class="ycs-photo-prep-quality__head">' +
      '<p class="ycs-photo-prep-quality__title">Photo quality check</p>' +
      '<p class="ycs-photo-prep-quality__score">' +
        escapeHtml(photoQuality.status) + ' • ' + escapeHtml(photoQuality.score) + '/100' +
      '</p>' +
    '</div>' +
    '<p class="ycs-photo-prep-quality__meta">Evaluation ID: ' + escapeHtml(photoQuality.evaluation_id || 'not saved') + '</p>' +
    saveWarning +
    '<ul>' + issueItems + '</ul>' +
    (recommendationItems ? '<ul>' + recommendationItems + '</ul>' : '') +
    renderPhotoQualityReviewForm(photoQuality);

  photoQualityResultEl.hidden = false;
}

async function submitPhotoQualityFeedback(event) {
  const form = event.target.closest('[data-photo-quality-review-form]');
  if (!form || !IS_ADMIN || !APP_BASE_URL) return;

  event.preventDefault();

  const statusEl = form.querySelector('[data-photo-quality-review-status]');
  const submitBtn = form.querySelector('button[type="submit"]');
  const formData = new FormData(form);
  const issueTags = formData.getAll('human_issue_tags');

  if (statusEl) statusEl.textContent = 'Saving...';
  if (submitBtn) submitBtn.disabled = true;

  try {
    const response = await fetch(APP_BASE_URL + '/api/photo-quality-feedback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        isAdmin: IS_ADMIN,
        evaluation_id: form.dataset.evaluationId,
        human_status: formData.get('human_status'),
        admin_feedback: formData.get('admin_feedback'),
        human_issue_tags: issueTags,
        admin_notes: formData.get('admin_notes'),
        reviewed_by: VIEWER_CUSTOMER_ID || 'shopify_storefront_admin'
      })
    });
    const data = await response.json().catch(function () { return {}; });

    if (!response.ok || !data.success) {
      throw new Error(data.details || data.error || 'Could not save feedback.');
    }

    if (statusEl) statusEl.textContent = 'Feedback saved.';
  } catch (error) {
    console.error(error);
    if (statusEl) statusEl.textContent = error.message || 'Could not save feedback.';
  } finally {
    if (submitBtn) submitBtn.disabled = false;
  }
}

if (photoQualityResultEl) {
  photoQualityResultEl.addEventListener('submit', submitPhotoQualityFeedback);
}

  function showOriginalPhoto(url) {
    if (!originalImg || !originalWrap || !originalEmptyEl) return;

    if (!url) {
      originalWrap.hidden = true;
      originalEmptyEl.hidden = false;
      originalImg.removeAttribute('src');
      return;
    }

    originalImg.onload = function () {
      originalWrap.hidden = false;
      originalEmptyEl.hidden = true;
    };

    originalImg.onerror = function () {
      originalWrap.hidden = true;
      originalEmptyEl.hidden = false;
    };

    originalImg.src = url;

    if (originalImg.complete && originalImg.naturalWidth > 0) {
      originalWrap.hidden = false;
      originalEmptyEl.hidden = true;
    }
  }

  function showWorkingPhoto(url) {
    if (!workingImg || !workingWrap || !workingEmptyEl) return;

    if (!url) {
      state.hasLoadedPhoto = false;
      workingWrap.hidden = true;
      workingEmptyEl.hidden = false;
      workingImg.removeAttribute('src');
      updateStatus();
      hideLoading();
      return;
    }

    state.hasLoadedPhoto = false;

    workingImg.onload = function () {
      state.hasLoadedPhoto = true;
      workingWrap.hidden = false;
      workingEmptyEl.hidden = true;
      hideLoading();
    };

    workingImg.onerror = function () {
      hideLoading();
      alert('The photo could not be displayed.');
    };

    workingImg.src = url;

    if (workingImg.complete && workingImg.naturalWidth > 0) {
      state.hasLoadedPhoto = true;
      workingWrap.hidden = false;
      workingEmptyEl.hidden = true;
      hideLoading();
    }
  }

