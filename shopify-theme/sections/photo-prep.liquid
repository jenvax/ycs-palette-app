    if (IS_SAMPLE_TRIAL_REQUEST || IS_SAMPLE_USER) {
      drapeQuery.set('trial', 'sample');
    }

    return `
      <div
        class="ycs-photo-prep-personal-card ycs-prep-open-personal-photo-btn"
        data-photo-id="${escapeHtml(photoId)}"
        data-photo-url="${escapeHtml(thumb)}"
        data-original-url="${escapeHtml(photo.originalPhotoUrl || '')}"
        data-adjusted-url="${escapeHtml(photo.adjustedPhotoUrl || '')}"
        role="button"
        tabindex="0"
      >
        <div class="ycs-photo-prep-personal-thumb">
          ${thumb ? `<img src="${escapeHtml(thumb)}" alt="Saved photo" />` : `<div class="ycs-photo-prep-empty"><p>No image</p></div>`}
        </div>

        <div class="ycs-photo-prep-personal-body">
          <div class="ycs-photo-prep-personal-meta">
            ${updatedAt ? `Updated ${escapeHtml(updatedAt)}` : 'Saved photo'}
          </div>

          <div class="ycs-photo-prep-personal-actions">
            <a
  class="ycs-photo-prep-btn ycs-photo-prep-btn--secondary"
  href="/pages/photo-draping?${drapeQuery.toString()}"
>
  Open Draping Studio
</a>
            <button
              type="button"
              class="ycs-photo-prep-btn ycs-photo-prep-btn--danger ycs-prep-delete-personal-photo-btn"
              data-photo-id="${escapeHtml(photoId)}"
            >
