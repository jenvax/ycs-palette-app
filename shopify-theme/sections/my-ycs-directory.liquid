{% assign tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% assign paid = false %}{% assign free = false %}
{% if tags contains ',YCSMEMBER,' or tags contains ',TRADE,' %}{% assign paid = true %}{% endif %}
{% if tags contains ',FREEMEMBER,' %}{% assign free = true %}{% endif %}
<section class="dir"{% if paid %} data-directory-manager data-url="/apps/palette-data" data-customer-id="{{ customer.id }}"{% endif %}>
  <nav><a href="/pages/my-ycs">Back to My YCS</a><a href="mailto:support@yourcolorstyle.com">Contact</a></nav>
  {% if customer == nil %}
    <h1>Directory</h1><p>Please sign in to access your membership.</p><a class="btn" href="{{ routes.account_login_url }}">Sign In</a>
  {% elsif paid %}
    <header><small>MY YCS</small><h1>My Directory Listing</h1><p>Create and manage the listing potential clients see in the Your Color Style Color Analyst Directory.</p></header>
    <p data-msg role="status" aria-live="polite" hidden></p><p data-load>Loading your listing...</p>
    <section data-preview hidden>
      <div class="preview-card" id="ycs-analyst-directory-preview" data-preview-card></div>
      <div class="view-actions view-actions--bottom"><button type="button" data-edit>Edit</button><button class="btn" type="button" data-update hidden>Update Listing</button><button class="link" type="button" data-status-action>Publish Listing</button></div>
    </section>
    <form data-form hidden novalidate>
      <div class="form-actions form-actions--top"><button type="button" data-preview-button>Preview</button><button class="btn" type="button" data-publish>Publish Listing</button><button class="link" type="button" data-cancel>Cancel</button></div>
      <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
      <div class="grid">
        <label>Your name<input name="name" maxlength="120" required></label><label>Business name (optional)<input name="businessName" maxlength="160"></label>
        <label>City<input name="city" maxlength="100" required></label><label>State / Province<input name="stateProvince" maxlength="100" required></label><label>Country<input name="country" maxlength="100" required></label>
        <label>Services offered<select name="services" required><option value="">Choose one</option><option>In-Person</option><option>Virtual</option><option>Both</option></select></label>
        <label>Website URL<input name="websiteUrl" type="url" placeholder="https://" required></label><label>Contact email<input name="contactEmail" type="email" required></label>
        <label class="wide">Social media URL (optional)<input name="socialUrl" type="url" placeholder="https://"></label>
        <label class="wide">Profile photo or business logo<input name="image" type="file" accept="image/jpeg,image/png,image/webp"><span>Upload a clear photo of yourself. You'll be able to position and crop it before saving. JPG, PNG, or WebP, up to 5 MB.</span></label>
        <div class="photo-preview wide" data-photo-tools hidden><img data-image hidden alt="Listing image preview" width="180" height="225"><div class="actions"><button type="button" data-change-photo>Change Photo</button><button type="button" data-adjust-crop>Adjust Crop</button></div></div>
        <label class="wide">Short Bio<textarea name="bio" maxlength="180" rows="5" required></textarea><span>Tell potential clients a little about your color analysis services and what makes working with you special.</span><span><i data-count>0</i> / 180</span></label>
      </div>
      <div class="form-actions form-actions--bottom"><button type="button" data-preview-button>Preview</button><button class="btn" type="button" data-publish>Publish Listing</button><button class="link" type="button" data-cancel>Cancel</button></div>
    </form>
    <dialog class="crop-dialog" data-crop-dialog>
      <div class="crop-dialog__header"><div><h2>Position Your Photo</h2><p>Drag the photo to choose what appears in your directory listing.</p></div><button class="close" type="button" data-crop-cancel aria-label="Close">&times;</button></div>
      <canvas data-crop-canvas width="800" height="1000" aria-label="4 by 5 photo crop preview"></canvas>
      <div class="crop-zoom"><span>Zoom</span><button type="button" data-zoom-out aria-label="Zoom out">&minus;</button><input data-zoom type="range" min="1" max="3" step="0.01" value="1" aria-label="Photo zoom"><button type="button" data-zoom-in aria-label="Zoom in">+</button></div>
      <p class="crop-error" data-crop-error hidden></p><div class="actions"><button type="button" data-crop-cancel>Cancel</button><button class="btn" type="button" data-save-crop>Save Crop</button></div>
    </dialog>
  {% elsif free %}
    <header><small>MY YCS</small><h1>Get Listed in the Color Analyst Directory</h1><p>Connect with people who are looking for professional color analysis services.</p><p>YCS members can be listed in the <strong>Your Color Style Color Analyst Directory</strong>, giving potential clients a way to discover you and learn more about your services.</p></header>
    <section class="summary"><div><h2>Your Directory Listing</h2><p><strong>&#128274; Directory listings are included with YCS membership.</strong></p><p>Join Your Color Style to submit your business information and be included in the directory while your membership is active.</p><a class="btn" href="{{ routes.root_url }}">Join Your Color Style</a><p><a href="/pages/find-a-color-analyst">View the Color Analyst Directory &rarr;</a></p></div></section>
  {% else %}<h1>Directory</h1><p>This membership is not available on your account.</p>{% endif %}
</section>
{% if paid %}<script src="{{ 'ycs-directory-manager.js' | asset_url }}" defer></script><script src="{{ 'ycs-directory-cropper.js' | asset_url }}" defer></script>{% endif %}
{% style %}
.shopify-section-header,#shopify-section-header,.site-header,.header-wrapper,.header,#shopify-section-footer,.shopify-section--footer,.site-footer,footer{display:none!important}.dir{max-width:1120px;min-height:60vh;margin:auto;padding:28px 24px 72px;color:#313238}.dir nav{display:flex;justify-content:space-between;margin-bottom:42px}.dir a{color:#b93455;font-weight:700;text-decoration:none}.dir header{max-width:780px;margin-bottom:34px}.dir small{color:#bd315b;font-weight:700}.dir h1{font-size:42px;margin:8px 0 12px;letter-spacing:0}.dir p{font-size:17px;line-height:1.6;color:#5f626a}.btn,.dir button{min-height:44px;border:1px solid #cf3f65;border-radius:6px;background:#fff;color:#bd315b;font-weight:700;padding:10px 18px;cursor:pointer}.btn{display:inline-flex;align-items:center;background:#cf3f65!important;color:#fff!important}.dir button:disabled{cursor:wait;opacity:.6}.summary{display:flex;justify-content:space-between;gap:24px;max-width:850px;border:1px solid #e3d9dc;border-radius:8px;padding:24px}.view-actions,.form-actions,.actions{display:flex;align-items:center;flex-wrap:wrap;gap:10px}.view-actions,.form-actions{max-width:850px}.form-actions--top{margin-bottom:18px}.view-actions--bottom,.form-actions--bottom{margin-top:18px}.link{min-height:auto!important;border:0!important;background:none!important;padding:8px 4px!important}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;max-width:850px}.grid label{display:flex;flex-direction:column;gap:7px;font-weight:700}.grid input,.grid select,.grid textarea{border:1px solid #c9c4c6;border-radius:5px;padding:11px;font:inherit;font-weight:400}.grid span{font-weight:400;color:#70727a}.wide{grid-column:1/-1}[data-image]{width:180px;aspect-ratio:4/5;object-fit:cover;border-radius:6px}.photo-preview .actions{margin-top:10px}.dir [data-msg]{position:fixed;z-index:1000;top:18px;left:50%;width:max-content;max-width:min(520px,calc(100vw - 32px));margin:0;padding:14px 18px;transform:translateX(-50%);border:1px solid #bedbc8;border-left:4px solid #328252;border-radius:6px;background:#eef8f1;box-shadow:0 10px 30px rgba(30,40,35,.16);color:#245f3b;text-align:center}.dir [data-msg].error{border-color:#e7b8c5;border-left-color:#b93455;background:#fff0f3;color:#84223d}.form-status{max-width:850px;margin:0 0 14px!important;color:#52705d!important;font-size:14px!important}.error,.crop-error{padding:12px;border-left:4px solid #b93455;background:#fff0f3}.preview-card{max-width:460px}#ycs-analyst-directory-preview .analyst-card{display:grid!important;grid-template-columns:120px minmax(0,1fr)!important;align-items:stretch!important;gap:12px!important;min-height:260px!important;padding:12px!important;border:1px solid #dedbe8!important;border-radius:12px!important;background:#fff!important}#ycs-analyst-directory-preview .analyst-card__image{display:block!important;width:120px!important;height:150px!important;max-width:none!important;object-fit:cover!important;border-radius:7px!important}#ycs-analyst-directory-preview .analyst-card__badges{display:flex;flex-wrap:wrap;justify-content:center;gap:5px;margin-top:7px}#ycs-analyst-directory-preview .analyst-card__badge{display:inline-flex;align-items:center;min-height:21px;padding:2px 7px;border:1px solid #dcd6ef;border-radius:999px;background:#f0ecfb;color:#4f438f;font-size:10px;font-weight:750;line-height:1}#ycs-analyst-directory-preview .analyst-card__badge--online{border-color:#cdddf3;background:#eaf2fb;color:#315d89}#ycs-analyst-directory-preview .analyst-card__content{min-width:0;display:flex;flex-direction:column}#ycs-analyst-directory-preview .analyst-card h2{margin:0 0 4px;font-size:19px;line-height:1.18;letter-spacing:0}#ycs-analyst-directory-preview .analyst-card__name{margin:0 0 5px!important;font-size:14px!important;line-height:1.35!important}#ycs-analyst-directory-preview .analyst-card__location{margin-bottom:5px;color:#545b6a;font-size:13px;line-height:1.4}#ycs-analyst-directory-preview .analyst-card__bio{margin:7px 0 0!important;font-size:13.5px!important;line-height:1.45!important}#ycs-analyst-directory-preview .analyst-card__links{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:auto;padding-top:7px}#ycs-analyst-directory-preview .preview-button{display:inline-flex;align-items:center;min-height:32px;padding:5px 10px;border:1px solid #6657bd;border-radius:6px;color:#5749a5!important;font-size:11px;text-transform:uppercase}#ycs-analyst-directory-preview .analyst-card__email{min-height:32px;display:inline-flex;align-items:center;color:#5749a5!important;font-size:12px;font-weight:750}.close{float:right;border:0!important;font-size:26px}.crop-dialog{width:min(92vw,520px);padding:24px;border:0;border-radius:8px}.crop-dialog::backdrop{background:rgba(20,20,25,.65)}.crop-dialog__header{display:flex;justify-content:space-between;gap:18px}.crop-dialog__header h2{margin:0}.crop-dialog__header p{margin:5px 0 16px;font-size:15px}.crop-dialog canvas{display:block;width:min(100%,400px);aspect-ratio:4/5;margin:auto;background:#eceaec;border-radius:6px;touch-action:none;cursor:grab}.crop-dialog canvas:active{cursor:grabbing}.crop-zoom{display:grid;grid-template-columns:auto 44px 1fr 44px;align-items:center;gap:9px;margin-top:18px}.crop-zoom button{padding:4px;min-height:40px}.crop-zoom input{width:100%}.dir [hidden]{display:none!important}@media(max-width:700px){.dir{padding:22px 16px}.dir h1{font-size:32px}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.summary{display:block}#ycs-analyst-directory-preview .analyst-card{grid-template-columns:78px minmax(0,1fr)!important;gap:10px!important;min-height:0!important;padding:10px!important}#ycs-analyst-directory-preview .analyst-card__image{width:78px!important;height:97.5px!important}#ycs-analyst-directory-preview .analyst-card h2{font-size:18px}#ycs-analyst-directory-preview .analyst-card__bio{font-size:13px!important}.crop-dialog{padding:18px}.crop-zoom{grid-template-columns:auto 40px 1fr 40px}.dir [data-msg]{top:12px;width:calc(100vw - 32px);max-width:none}}
{% endstyle %}
{% schema %}{"name":"My YCS Directory","settings":[],"presets":[{"name":"My YCS Directory"}]}{% endschema %}
