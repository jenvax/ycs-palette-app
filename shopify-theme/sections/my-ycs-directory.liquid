{% assign ycs_member_access = false %}
{% assign ycs_free_member = false %}
{% if customer %}
  {% assign ycs_member_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% if ycs_member_tags contains ',YCSMEMBER,' %}
    {% assign ycs_member_access = true %}
  {% endif %}
  {% if ycs_member_tags contains ',FREEMEMBER,' %}
    {% assign ycs_member_access = true %}
    {% unless ycs_member_tags contains ',YCSMEMBER,' %}
      {% assign ycs_free_member = true %}
    {% endunless %}
  {% endif %}
{% endif %}

<section class="ycs-directory">
  <nav class="ycs-directory__nav" aria-label="Membership navigation">
    <a href="/pages/my-ycs" class="ycs-directory__back">Back to My YCS</a>
    <a href="mailto:support@yourcolorstyle.com" class="ycs-directory__back">Contact</a>
  </nav>

  {% if customer == nil %}
    <div class="ycs-directory__message">
      <p class="ycs-directory__kicker">Your Color Style</p>
      <h1>Directory</h1>
      <p>Please sign in to access your membership.</p>
      <a href="{{ routes.account_login_url }}" class="ycs-directory__button">Sign In</a>
    </div>
  {% elsif ycs_member_access == false %}
    <div class="ycs-directory__message">
      <p class="ycs-directory__kicker">Your Color Style</p>
      <h1>Directory</h1>
      <p>This membership is not available on your account.</p>
    </div>
  {% else %}
    {% if ycs_free_member %}
      <header class="ycs-directory__header">
        <p class="ycs-directory__kicker">My YCS</p>
        <h1>Get Listed in the Color Analyst Directory</h1>
        <p>Connect with people who are looking for professional color analysis services.</p>
        <p>YCS members can be listed in the <strong>Your Color Style Color Analyst Directory</strong>, giving potential clients a way to discover you and learn more about your services.</p>
      </header>

      <div class="ycs-directory__content" aria-label="Directory membership information">
        <h2>Your Directory Listing</h2>
        <p><strong>&#128274; Directory listings are included with YCS membership.</strong></p>
        <p>Join Your Color Style to submit your business information and be included in the directory while your membership is active.</p>
        <a href="/" class="ycs-directory__button">Join Your Color Style</a>
        <p class="ycs-directory__secondary-action">
          <a href="/pages/color-analyst-directory">View the Color Analyst Directory &rarr;</a>
        </p>
      </div>
    {% else %}
    <header class="ycs-directory__header">
      <p class="ycs-directory__kicker">My YCS</p>
      <h1>Get Listed in the Color Analyst Directory</h1>
      <p>Your YCS membership includes a listing in the <strong>Your Color Style Color Analyst Directory</strong>, helping people who visit YourColorStyle.com find a color analyst to work with.</p>
    </header>

    <div class="ycs-directory__content" aria-label="Directory listing instructions">
      <h2>Submit Your Listing</h2>
      <p>To create your listing, please email me the following information:</p>

      <ul>
        <li><strong>Your name</strong></li>
        <li><strong>Business name</strong> (if applicable)</li>
        <li><strong>Location</strong> &mdash; City, State/Province, Country</li>
        <li><strong>Services offered</strong> &mdash; In-person, virtual, or both</li>
        <li><strong>Website URL</strong></li>
        <li><strong>Email address</strong> you'd like potential clients to use</li>
        <li><strong>Social media link</strong> (optional)</li>
        <li><strong>Profile photo or business logo</strong></li>
        <li><strong>Short bio</strong> &mdash; 2&ndash;3 sentences about you and your color analysis services</li>
      </ul>

      <p>Once I receive your information, I'll create your listing and add it to the directory.</p>

      <a href="mailto:support@yourcolorstyle.com?subject=My%20Color%20Analyst%20Directory%20Listing" class="ycs-directory__button">Submit My Listing</a>

      <p class="ycs-directory__note"><em>Your directory listing is available while your YCS membership is active.</em></p>
    </div>
    {% endif %}
  {% endif %}
</section>

{% style %}
  .shopify-section-header,
  #shopify-section-header,
  .site-header,
  .header-wrapper,
  .header {
    display: none !important;
  }

  #shopify-section-footer,
  .shopify-section--footer,
  .site-footer,
  footer.footer,
  footer[role="contentinfo"] {
    display: none !important;
  }

  body {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .ycs-directory {
    max-width: 1180px;
    min-height: 60vh;
    margin: 0 auto;
    padding: 28px 24px 72px;
    color: #313238;
  }

  .ycs-directory__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 42px;
  }

  .ycs-directory__back {
    color: #4b4d55;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .ycs-directory__back:hover {
    text-decoration: underline;
  }

  .ycs-directory__header,
  .ycs-directory__message {
    max-width: 780px;
  }

  .ycs-directory__header {
    margin-bottom: 36px;
  }

  .ycs-directory__kicker {
    margin: 0 0 8px;
    color: #bd315b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .ycs-directory h1 {
    margin: 0 0 12px;
    color: #292a30;
    font-size: 42px;
    line-height: 1.14;
    letter-spacing: 0;
  }

  .ycs-directory__message > p:not(.ycs-directory__kicker) {
    margin: 0;
    color: #686a72;
    font-size: 17px;
    line-height: 1.6;
  }

  .ycs-directory__header > p:not(.ycs-directory__kicker),
  .ycs-directory__content p,
  .ycs-directory__content li {
    color: #5f626a;
    font-size: 17px;
    line-height: 1.65;
  }

  .ycs-directory__content {
    max-width: 780px;
  }

  .ycs-directory__content h2 {
    margin: 0 0 12px;
    color: #292a30;
    font-size: 28px;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .ycs-directory__content p {
    margin: 0 0 20px;
  }

  .ycs-directory__content ul {
    margin: 0 0 24px;
    padding-left: 24px;
  }

  .ycs-directory__content li + li {
    margin-top: 6px;
  }

  .ycs-directory__note {
    margin-top: 22px !important;
    font-size: 15px !important;
  }

  .ycs-directory__button {
    display: inline-flex;
    min-height: 46px;
    margin-top: 22px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    background: #cf3f65;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    padding: 12px 20px;
    text-decoration: none;
  }

  .ycs-directory__secondary-action {
    margin-top: 20px !important;
  }

  .ycs-directory__secondary-action a {
    color: #bd315b;
    font-weight: 700;
    text-decoration: none;
  }

  .ycs-directory__secondary-action a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .ycs-directory {
      padding: 22px 16px 52px;
    }

    .ycs-directory__nav {
      margin-bottom: 30px;
    }

    .ycs-directory h1 {
      font-size: 32px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "My YCS Directory",
  "settings": [],
  "presets": [{ "name": "My YCS Directory" }]
}
{% endschema %}
