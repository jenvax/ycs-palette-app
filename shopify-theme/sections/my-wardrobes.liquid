  }

  .ycs-wardrobes-color-add {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 120px auto;
    gap: 8px;
    align-items: end;
  }

  .ycs-wardrobes-form__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 4px;
  }

  @media (max-width: 720px) {
    .ycs-wardrobes__header,
    .ycs-wardrobes__controls {
      display: grid;
    }

    .ycs-wardrobes__controls {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .ycs-wardrobes__controls label {
      display: grid;
      gap: 6px;
    }

    .ycs-wardrobes__controls label span,
    .ycs-wardrobes__controls select,
    .ycs-wardrobes__control-actions {
      grid-column: auto;
      grid-row: auto;
    }

    .ycs-wardrobes__control-actions,
    .ycs-wardrobes__button {
      width: 100%;
    }

    .ycs-wardrobe-card {
      flex-basis: 112px;
      width: 112px;
    }

    .ycs-wardrobe-card__swatch {
      width: 112px;
      height: 112px;
    }

    .ycs-wardrobes-color-add {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const root = document.getElementById('ycs-wardrobes');
    if (!root) return;

    const customerId = root.dataset.customerId || '';
    const apiBase = (root.dataset.appBaseUrl || '').replace(/\/$/, '') + '/api/wardrobes';
    const controlsEl = root.querySelector('[data-ycs-wardrobe-controls]');
    const selectEl = root.querySelector('[data-ycs-wardrobe-select]');
    const bodyEl = root.querySelector('[data-ycs-wardrobe-body]');
    const statusEl = root.querySelector('[data-ycs-wardrobe-status]');
    const modalEl = root.querySelector('[data-ycs-wardrobe-modal]');
    const modalBodyEl = root.querySelector('[data-ycs-wardrobe-modal-body]');
    const modalTitleEl = root.querySelector('#ycs-wardrobe-modal-title');

    const typeLabels = {
      top: 'Tops',
      bottom: 'Bottoms',
      dress_jumpsuit: 'Dresses & Jumpsuits',
      outer_layer: 'Outer Layers',
      shoe: 'Shoes',
      bag: 'Bags'
    };
    const typeOrder = ['top', 'outer_layer', 'bottom', 'dress_jumpsuit', 'shoe', 'bag'];
    const itemTypeOptions = [
      ['top', 'Top'],
      ['bottom', 'Bottom'],
      ['dress_jumpsuit', 'Dress / Jumpsuit'],
      ['outer_layer', 'Outer Layer'],
      ['shoe', 'Shoe'],
      ['bag', 'Bag']
    ];

    let state = {
      wardrobes: [],
      activeWardrobeId: localStorage.getItem('ycsActiveWardrobeId') || '',
      editingItem: null,
      editingMode: 'edit',
      editingColors: [],
      draggingItemId: '',
      didDragCard: false,
      dragEndedAt: 0
    };

    function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStatus(message, isError) {
      statusEl.hidden = !message;
      statusEl.textContent = message || '';
      statusEl.style.borderColor = isError ? '#f2c8d3' : '#cfe3d4';
      statusEl.style.background = isError ? '#fff5f7' : '#f7fff9';
      statusEl.style.color = isError ? '#bd3155' : '#3f6f4d';
    }

    function activeWardrobe() {
      return state.wardrobes.find((wardrobe) => wardrobe.id === state.activeWardrobeId) || state.wardrobes[0] || null;
    }

    function normalizeHex(value) {
      const raw = String(value || '').trim().replace(/^#/, '');
      return /^[0-9a-fA-F]{6}$/.test(raw) ? '#' + raw.toUpperCase() : '';
    }

    function mosaicStyle(colors) {
      const count = Math.max(1, colors.length);
      if (count <= 1) return 'grid-template-columns:1fr;grid-template-rows:1fr;';
      if (count === 2) return 'grid-template-columns:1fr 1fr;grid-template-rows:1fr;';
      if (count <= 4) return 'grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;';
      if (count <= 6) return 'grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(2,1fr);';
      return 'grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);';
    }

    function displayMosaicColors(colors) {
      const displayColors = colors.slice(0, 9);
      const count = displayColors.length;
      const targetCount = count <= 4 ? count : count <= 6 ? 6 : 9;
      let fillIndex = 0;
      while (displayColors.length < targetCount) {
        displayColors.push(colors[fillIndex % colors.length]);
        fillIndex += 1;
      }
      return displayColors;
    }

    function cardMarkup(item) {
      const colors = item.colors && item.colors.length ? item.colors : [{ hex: '#eee', name: 'Color' }];
      const mosaicColors = displayMosaicColors(colors);
      return `
        <button type="button" class="ycs-wardrobe-card" data-ycs-item-id="${escapeHtml(item.id)}" data-ycs-item-type="${escapeHtml(item.itemType)}">
          <span class="ycs-wardrobe-card__handle" draggable="true" data-ycs-drag-handle aria-label="Move wardrobe item">⋮</span>
          <span class="ycs-wardrobe-card__swatch" style="${mosaicStyle(mosaicColors)}">
            ${mosaicColors.map((color) => `<span style="background:${escapeHtml(color.hex || color.hexCode || '#eee')}"></span>`).join('')}
          </span>
          <span class="ycs-wardrobe-card__name">${escapeHtml(item.description)}</span>
        </button>
      `;
    }

    function addCardMarkup(type) {
      return `
        <button type="button" class="ycs-wardrobe-card ycs-wardrobe-card--add" data-ycs-add-item-type="${type}" aria-label="Add ${escapeHtml(typeLabels[type])} item">
          <span class="ycs-wardrobe-card__swatch">+</span>
          <span class="ycs-wardrobe-card__name">Add Item</span>
        </button>
      `;
    }

    function render() {
      const wardrobe = activeWardrobe();

      if (!state.wardrobes.length) {
        controlsEl.hidden = true;
        bodyEl.innerHTML = `
          <div class="ycs-wardrobes__empty">
            Create your first wardrobe to start organizing the colors you already own.
          </div>
        `;
        return;
      }

      controlsEl.hidden = false;
      selectEl.innerHTML = state.wardrobes
        .map((item) => `<option value="${escapeHtml(item.id)}"${item.id === wardrobe.id ? ' selected' : ''}>${escapeHtml(item.name)}</option>`)
        .join('');

      const rows = typeOrder.map((type) => {
        const items = (wardrobe.items || []).filter((item) => item.itemType === type);
        return `
          <section class="ycs-wardrobes-row">
            <div class="ycs-wardrobes-row__head">
              <div class="ycs-wardrobes-row__title">
                <h2>${typeLabels[type]}</h2>
                <span class="ycs-wardrobes-row__count">(${items.length})</span>
              </div>
            </div>
            <div class="ycs-wardrobes-row__scroll-shell" aria-label="${typeLabels[type]} row controls">
              <button type="button" class="ycs-wardrobes-row__scroll-button" data-ycs-scroll-row="-1" aria-label="Scroll ${typeLabels[type]} left">‹</button>
              <div class="ycs-wardrobes-row__scroller" data-ycs-row-scroller>
                <div class="ycs-wardrobes-row__track" data-ycs-row-track data-ycs-row-type="${type}" data-ycs-row-offset="0">
                  ${items.map(cardMarkup).join('')}
                  ${addCardMarkup(type)}
                </div>
              </div>
              <button type="button" class="ycs-wardrobes-row__scroll-button" data-ycs-scroll-row="1" aria-label="Scroll ${typeLabels[type]} right">›</button>
            </div>
          </section>
        `;
      }).join('');

      bodyEl.innerHTML = rows || `
        <div class="ycs-wardrobes__empty">
          This wardrobe is empty. Add an item from one of the wardrobe rows.
        </div>
      `;
    }

    async function apiPost(payload) {
      const response = await fetch(apiBase, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'omit',
        body: JSON.stringify({ customerId, ...payload })
      });
      const json = await response.json();
      if (!response.ok) throw new Error(json.error || 'Wardrobe request failed');
      return json;
    }

    async function loadWardrobes() {
      setStatus('Loading wardrobes...', false);
      try {
        const query = new URLSearchParams({ customerId });
        const response = await fetch(apiBase + '?' + query.toString(), { credentials: 'omit' });
        const json = await response.json();
        if (!response.ok) throw new Error(json.error || 'Could not load wardrobes');
        state.wardrobes = json.wardrobes || [];
        if (!state.wardrobes.some((wardrobe) => wardrobe.id === state.activeWardrobeId)) {
          state.activeWardrobeId = state.wardrobes[0]?.id || '';
        }
        setStatus('', false);
        render();
      } catch (error) {
        console.error(error);
        setStatus(error.message || 'Could not load wardrobes.', true);
      }
    }

    async function refreshAfter(message) {
      await loadWardrobes();
      setStatus(message, false);
      window.setTimeout(() => setStatus('', false), 1800);
    }

    function closeModal() {
      modalEl.hidden = true;
      state.editingItem = null;
      state.editingMode = 'edit';
      state.editingColors = [];
    }

    function renderColorPills() {
      const list = modalBodyEl.querySelector('[data-ycs-wardrobe-color-list]');
      if (!list) return;
      list.innerHTML = state.editingColors.map((color, index) => `
        <span class="ycs-wardrobes-color-pill">
          <span class="ycs-wardrobes-color-pill__swatch" style="background:${escapeHtml(color.hex || color.hexCode)}"></span>
          ${escapeHtml(color.name || color.colorName)}
          <button type="button" data-ycs-remove-color="${index}" aria-label="Remove color">×</button>
        </span>
      `).join('');
    }

    function itemFormMarkup({ item, itemType, isNew }) {
      return `
        <form class="ycs-wardrobes-form" data-ycs-item-form>
          <label>Description
            <input name="description" value="${escapeHtml(item?.description || '')}" placeholder="Knit Top" required>
          </label>
          <label>Item Type
            <select name="itemType">
              ${itemTypeOptions.map(([value, label]) => `<option value="${value}"${value === itemType ? ' selected' : ''}>${label}</option>`).join('')}
            </select>
          </label>
          <div>
            <label>Colors</label>
            <div class="ycs-wardrobes-color-list" data-ycs-wardrobe-color-list></div>
          </div>
          <div class="ycs-wardrobes-color-add">
            <label>Color name
              <input name="newColorName" placeholder="Navy">
            </label>
            <label>Hex
              <input name="newColorHex" placeholder="#1B2A44">
            </label>
            <button type="button" class="ycs-wardrobes__button ycs-wardrobes__button--secondary" data-ycs-add-manual-color>Add Color</button>
          </div>
          <div class="ycs-wardrobes-form__actions">
            ${isNew ? '' : '<button type="button" class="ycs-wardrobes__button ycs-wardrobes__button--danger" data-ycs-remove-from-wardrobe>Remove from Wardrobe</button>'}
            <button type="submit" class="ycs-wardrobes__button">${isNew ? 'Add Item' : 'Save Item'}</button>
          </div>
        </form>
      `;
    }

    function openItemModal(item) {
      state.editingItem = item;
      state.editingMode = 'edit';
      state.editingColors = (item.colors || []).map((color) => ({
        name: color.name || color.colorName,
        hex: color.hex || color.hexCode,
        paletteCode: color.paletteCode || ''
      }));
      modalTitleEl.textContent = 'Edit Wardrobe Item';
      modalBodyEl.innerHTML = itemFormMarkup({ item, itemType: item.itemType, isNew: false });
      modalEl.hidden = false;
      renderColorPills();
    }

    function openNewItemModal(itemType) {
      state.editingItem = null;
      state.editingMode = 'create';
      state.editingColors = [];
      modalTitleEl.textContent = 'Add Wardrobe Item';
      modalBodyEl.innerHTML = itemFormMarkup({ item: null, itemType, isNew: true });
      modalEl.hidden = false;
      renderColorPills();
      const form = modalEl.querySelector('[data-ycs-item-form]');
      if (form) form.elements.description.focus();
    }

    function orderedItemPayload(wardrobe) {
      return typeOrder.flatMap((type) => (wardrobe.items || [])
        .filter((item) => item.itemType === type)
        .map((item) => ({ itemId: item.id, itemType: type })));
    }

    function applyVisibleRowOrderToState() {
      const wardrobe = activeWardrobe();
      if (!wardrobe) return false;

      const itemById = new Map((wardrobe.items || []).map((item) => [item.id, item]));
      const orderedItems = [];
      root.querySelectorAll('[data-ycs-row-track]').forEach((track) => {
        const itemType = track.dataset.ycsRowType;
        track.querySelectorAll('[data-ycs-item-id]').forEach((card) => {
          const item = itemById.get(card.dataset.ycsItemId);
          if (!item || !typeOrder.includes(itemType)) return;
          item.itemType = itemType;
          orderedItems.push(item);
        });
      });

      if (!orderedItems.length) return false;
      wardrobe.items = orderedItems;
      return true;
    }

    async function saveWardrobeItemOrder() {
      const wardrobe = activeWardrobe();
      if (!wardrobe) return;
      await apiPost({
        action: 'reorderItems',
        wardrobeId: wardrobe.id,
        items: orderedItemPayload(wardrobe)
      });
    }

    root.addEventListener('click', async function (event) {
      const actionButton = event.target.closest('[data-ycs-wardrobe-action]');
      if (actionButton) {
        const action = actionButton.dataset.ycsWardrobeAction;
        try {
          if (action === 'create-wardrobe') {
            const name = window.prompt('Wardrobe name', 'Fall Wardrobe');
            if (!name) return;
            const json = await apiPost({ action: 'createWardrobe', name });
            state.activeWardrobeId = json.wardrobe?.id || state.activeWardrobeId;
            localStorage.setItem('ycsActiveWardrobeId', state.activeWardrobeId);
            await refreshAfter('Wardrobe created.');
          }
          if (action === 'rename-wardrobe') {
            const wardrobe = activeWardrobe();
            if (!wardrobe) return;
            const name = window.prompt('Rename wardrobe', wardrobe.name);
            if (!name) return;
            await apiPost({ action: 'renameWardrobe', wardrobeId: wardrobe.id, name });
            await refreshAfter('Wardrobe renamed.');
          }
          if (action === 'delete-wardrobe') {
            const wardrobe = activeWardrobe();
            if (!wardrobe) return;
            if (!window.confirm(`Delete ${wardrobe.name}? This will not delete any palette colors.`)) return;
            await apiPost({ action: 'deleteWardrobe', wardrobeId: wardrobe.id });
            state.activeWardrobeId = '';
            localStorage.removeItem('ycsActiveWardrobeId');
            await refreshAfter('Wardrobe deleted.');
          }
        } catch (error) {
          console.error(error);
          setStatus(error.message || 'Wardrobe update failed.', true);
        }
        return;
      }

      const rowScrollButton = event.target.closest('[data-ycs-scroll-row]');
      if (rowScrollButton) {
        event.preventDefault();
        event.stopPropagation();
        const row = rowScrollButton.closest('.ycs-wardrobes-row');
        const track = row?.querySelector('[data-ycs-row-track]');
        if (!track) return;
        const direction = Number(rowScrollButton.dataset.ycsScrollRow || 1);
        const card = track.querySelector('.ycs-wardrobe-card');
        const cardWidth = card ? card.getBoundingClientRect().width : 132;
        const gap = Number.parseFloat(window.getComputedStyle(track).columnGap || window.getComputedStyle(track).gap || '12') || 12;
        const step = cardWidth + gap;
        const currentOffset = Number(track.dataset.ycsRowOffset || 0);
        const nextOffset = currentOffset + (direction * step);
        track.dataset.ycsRowOffset = String(nextOffset);
        track.style.transform = `translateX(${nextOffset}px)`;
        return;
      }

      const addCard = event.target.closest('[data-ycs-add-item-type]');
      if (addCard) {
        openNewItemModal(addCard.dataset.ycsAddItemType || 'top');
        return;
      }

      const card = event.target.closest('[data-ycs-item-id]');
      if (card) {
        if (event.target.closest('[data-ycs-drag-handle]')) return;
        if (state.didDragCard || Date.now() - state.dragEndedAt < 350) {
          state.didDragCard = false;
          return;
        }
        const wardrobe = activeWardrobe();
        const item = (wardrobe?.items || []).find((entry) => entry.id === card.dataset.ycsItemId);
        if (item) openItemModal(item);
      }
    });

    root.addEventListener('dragstart', function (event) {
      const handle = event.target.closest('[data-ycs-drag-handle]');
      if (!handle) return;
      event.stopPropagation();
      const card = handle.closest('[data-ycs-item-id]');
      if (!card) return;
      state.draggingItemId = card.dataset.ycsItemId || '';
      state.didDragCard = true;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', state.draggingItemId);
      card.classList.add('is-dragging');
    });

    root.addEventListener('dragend', function (event) {
      const card = event.target.closest('[data-ycs-item-id]');
      if (card) card.classList.remove('is-dragging');
      root.querySelectorAll('[data-ycs-row-track].is-drop-target').forEach((track) => track.classList.remove('is-drop-target'));
      state.dragEndedAt = Date.now();
      window.setTimeout(() => {
        state.draggingItemId = '';
        state.didDragCard = false;
      }, 350);
    });

    root.addEventListener('dragover', function (event) {
      const track = event.target.closest('[data-ycs-row-track]');
      if (!track || !state.draggingItemId) return;
      event.preventDefault();
      event.dataTransfer.dropEffect = 'move';
      track.classList.add('is-drop-target');

      const draggingCard = root.querySelector('.ycs-wardrobe-card.is-dragging');
      if (!draggingCard) return;
      const targetCard = event.target.closest('[data-ycs-item-id]');
      if (targetCard && targetCard !== draggingCard) {
        const targetRect = targetCard.getBoundingClientRect();
        const insertAfter = event.clientX > targetRect.left + (targetRect.width / 2);
        track.insertBefore(draggingCard, insertAfter ? targetCard.nextSibling : targetCard);
        return;
      }

      if (!targetCard && draggingCard.parentElement !== track) {
        track.appendChild(draggingCard);
      }
    });

    root.addEventListener('dragleave', function (event) {
      const track = event.target.closest('[data-ycs-row-track]');
      if (!track || track.contains(event.relatedTarget)) return;
      track.classList.remove('is-drop-target');
    });

    root.addEventListener('drop', async function (event) {
      const track = event.target.closest('[data-ycs-row-track]');
      if (!track || !state.draggingItemId) return;
      event.preventDefault();

      root.querySelectorAll('[data-ycs-row-track].is-drop-target').forEach((rowTrack) => rowTrack.classList.remove('is-drop-target'));
      if (!applyVisibleRowOrderToState()) return;

      try {
        await saveWardrobeItemOrder();
        await refreshAfter('Wardrobe order saved.');
      } catch (error) {
        console.error(error);
        setStatus(error.message || 'Could not save wardrobe order.', true);
        await loadWardrobes();
      }
    });

    modalEl.addEventListener('click', async function (event) {
      if (event.target.closest('[data-ycs-wardrobe-close]')) {
        closeModal();
        return;
      }

      const removeColorButton = event.target.closest('[data-ycs-remove-color]');
      if (removeColorButton) {
        state.editingColors.splice(Number(removeColorButton.dataset.ycsRemoveColor), 1);
        renderColorPills();
        return;
      }

      if (event.target.closest('[data-ycs-add-manual-color]')) {
        const form = modalEl.querySelector('[data-ycs-item-form]');
        const name = String(form.elements.newColorName.value || '').trim();
        const hex = normalizeHex(form.elements.newColorHex.value);
        if (!name || !hex) {
          setStatus('Enter a color name and six-character hex.', true);
          return;
        }
        state.editingColors.push({ name, hex, paletteCode: '' });
        form.elements.newColorName.value = '';
        form.elements.newColorHex.value = '';
        renderColorPills();
        return;
      }

      if (event.target.closest('[data-ycs-remove-from-wardrobe]')) {
        const wardrobe = activeWardrobe();
        if (!wardrobe || !state.editingItem) return;
        if (!window.confirm('Remove this item from the current wardrobe?')) return;
        try {
          await apiPost({ action: 'removeFromWardrobe', wardrobeId: wardrobe.id, itemId: state.editingItem.id });
          closeModal();
          await refreshAfter('Item removed from wardrobe.');
        } catch (error) {
          console.error(error);
          setStatus(error.message || 'Could not remove item.', true);
        }
      }
    });

    modalEl.addEventListener('submit', async function (event) {
      const form = event.target.closest('[data-ycs-item-form]');
      if (!form) return;
      event.preventDefault();

      const wardrobe = activeWardrobe();
      if (!wardrobe) return;
      const typedColorName = String(form.elements.newColorName?.value || '').trim();
      const typedColorHex = normalizeHex(form.elements.newColorHex?.value);
      if (typedColorName || typedColorHex) {
        if (!typedColorName || !typedColorHex) {
          setStatus('Enter a color name and six-character hex.', true);
          return;
        }
        state.editingColors.push({ name: typedColorName, hex: typedColorHex, paletteCode: '' });
      }
      if (!state.editingColors.length) {
        setStatus('Select at least one color.', true);
        return;
      }

      try {
        const isCreate = state.editingMode === 'create';
        const payload = {
          action: isCreate ? 'createItem' : 'updateItem',
          wardrobeId: wardrobe.id,
          description: form.elements.description.value,
          itemType: form.elements.itemType.value,
          colors: state.editingColors
        };
        if (!isCreate) {
          if (!state.editingItem) return;
          payload.itemId = state.editingItem.id;
        }
        await apiPost(payload);
        closeModal();
        await refreshAfter(isCreate ? 'Item added.' : 'Item saved.');
      } catch (error) {
        console.error(error);
        setStatus(error.message || 'Could not save item.', true);
      }
    });

    selectEl.addEventListener('change', function () {
      state.activeWardrobeId = selectEl.value;
      localStorage.setItem('ycsActiveWardrobeId', state.activeWardrobeId);
      render();
    });

    loadWardrobes();
  });
</script>

{% schema %}
{
  "name": "My Wardrobes",
  "settings": []
}
{% endschema %}
