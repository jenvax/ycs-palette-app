{% assign palette_access_string = '' %}
{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% assign wardrobe_palette_codes = 'CWL,CWM,CWD,CCL,CCM,CCD,SWL,SWM,SWD,SCL,SCM,SCD,LO,MO,DO,CWLG,CWMG,CWDG,SWLG,SWMG,SWDG' | split: ',' %}

{% assign is_admin = false %}
{% if customer and palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}

{% if customer == nil %}
  <div class="ycs-wardrobes ycs-wardrobes--center">
    <p class="ycs-wardrobes__kicker">Your Color Style</p>
    <h1>Sign in to view wardrobes</h1>
    <a href="{{ routes.account_login_url }}" class="ycs-wardrobes__button">Sign In</a>
  </div>
{% elsif is_admin %}
  <div
    class="ycs-wardrobes"
    id="ycs-wardrobes"
    data-customer-id="{{ customer.id }}"
    data-app-base-url="https://ycs-palette-app.vercel.app"
  >
    <nav class="ycs-wardrobes__nav" aria-label="Wardrobe navigation">
      <a href="/pages/my-palettes" class="ycs-wardrobes__nav-link">My Palettes</a>
      {% for palette_code in wardrobe_palette_codes %}
        {% assign palette_token = ',' | append: palette_code | append: ',' %}
        {% if palette_access_string contains palette_token %}
          <a
            href="/pages/palette?palette={{ palette_code }}&returnUrl=/pages/my-wardrobes"
            class="ycs-wardrobes__nav-link ycs-wardrobes__nav-link--palette"
          >
            {{ palette_code }}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    <header class="ycs-wardrobes__header">
      <div>
        <p class="ycs-wardrobes__kicker">Your Color Style</p>
        <h1>My Wardrobes</h1>
        <p class="ycs-wardrobes__intro">Organize real wardrobe pieces by the palette colors they use.</p>
      </div>
      <button type="button" class="ycs-wardrobes__button" data-ycs-wardrobe-action="create-wardrobe">Create Wardrobe</button>
    </header>

    <section class="ycs-wardrobes__controls" data-ycs-wardrobe-controls hidden>
      <label>
        <span>Wardrobe</span>
        <select data-ycs-wardrobe-select></select>
      </label>
      <div class="ycs-wardrobes__control-actions">
        <button type="button" class="ycs-wardrobes__button ycs-wardrobes__button--secondary" data-ycs-wardrobe-action="rename-wardrobe">Rename</button>
        <button type="button" class="ycs-wardrobes__button ycs-wardrobes__button--danger" data-ycs-wardrobe-action="delete-wardrobe">Delete</button>
      </div>
    </section>

    <p class="ycs-wardrobes__status" data-ycs-wardrobe-status hidden></p>
    <div class="ycs-wardrobes__body" data-ycs-wardrobe-body></div>

    <div class="ycs-wardrobes-modal" data-ycs-wardrobe-modal hidden>
      <div class="ycs-wardrobes-modal__backdrop" data-ycs-wardrobe-close></div>
      <div class="ycs-wardrobes-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ycs-wardrobe-modal-title">
        <div class="ycs-wardrobes-modal__head">
          <h2 id="ycs-wardrobe-modal-title">Wardrobe Item</h2>
          <button type="button" class="ycs-wardrobes__icon-button" data-ycs-wardrobe-close aria-label="Close">×</button>
        </div>
        <div data-ycs-wardrobe-modal-body></div>
      </div>
    </div>
  </div>
{% endif %}

<style>
  .shopify-section-header,
  #shopify-section-header,
  .site-header,
  .header-wrapper,
  .header,
  nav[role="navigation"],
  #shopify-section-footer,
  .shopify-section--footer,
  .site-footer,
  footer.footer,
  footer[role="contentinfo"],
  .bredcrumbWrap,
  .breadcrumbWrap,
  nav.breadcrumbs,
  .breadcrumbs {
    display: none !important;
  }

  .ycs-wardrobes {
    max-width: 1180px;
    margin: 0 auto;
    padding: 20px 16px 48px;
    color: #2f2a25;
  }

  .ycs-wardrobes--center {
    text-align: center;
  }

  .ycs-wardrobes__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .ycs-wardrobes__nav-link,
  .ycs-wardrobes__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 9px 14px;
    border: 1px solid #d8cfc3;
    border-radius: 999px;
    background: #111;
    color: #fff !important;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none !important;
    white-space: nowrap;
  }

  .ycs-wardrobes__nav-link,
  .ycs-wardrobes__button--secondary {
    background: #fff;
    color: #2f2a25 !important;
  }

  .ycs-wardrobes__button--danger {
    background: #fff5f7;
    color: #bd3155 !important;
    border-color: #f2c8d3;
  }

  .ycs-wardrobes__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ycs-wardrobes__kicker {
    margin: 0 0 6px;
    color: #8b8177;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .ycs-wardrobes h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.04;
  }

  .ycs-wardrobes__intro {
    margin: 8px 0 0;
    color: #625c55;
    font-size: 15px;
    line-height: 1.45;
  }

  .ycs-wardrobes__controls {
    display: grid;
    grid-template-columns: minmax(260px, 576px) auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 12px;
    row-gap: 6px;
    margin-bottom: 18px;
    padding: 14px;
    border: 1px solid #ece7df;
    border-radius: 8px;
    background: #fbfaf8;
  }

  .ycs-wardrobes__controls label {
    display: contents;
    width: 100%;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-wardrobes__controls label span {
    grid-column: 1;
    grid-row: 1;
  }

  .ycs-wardrobes__controls select {
    grid-column: 1;
    grid-row: 2;
  }

  .ycs-wardrobes__controls select,
  .ycs-wardrobes-form input,
  .ycs-wardrobes-form select {
    width: 100%;
    min-height: 42px;
    border: 1px solid #ddd3c8;
    border-radius: 8px;
    background: #fff;
    color: #2f2a25;
    font: inherit;
    padding: 9px 12px;
  }

  .ycs-wardrobes__control-actions {
    display: flex;
    flex-wrap: wrap;
    grid-column: 2;
    grid-row: 2;
    gap: 8px;
    align-items: center;
    align-self: stretch;
  }

  .ycs-wardrobes__control-actions .ycs-wardrobes__button {
    min-height: 42px;
  }

  .ycs-wardrobes__status {
    margin: 0 0 16px;
    border: 1px dashed #e4c7ce;
    border-radius: 8px;
    padding: 12px;
    background: #fffafb;
    color: #6b5359;
    font-size: 14px;
  }

  .ycs-wardrobes__status[hidden],
  .ycs-wardrobes__controls[hidden],
  .ycs-wardrobes-modal[hidden] {
    display: none;
  }

  .ycs-wardrobes__empty {
    border: 1px dashed #ddd3c8;
    border-radius: 8px;
    padding: 22px;
    background: #fbfaf8;
    color: #625c55;
  }

  .ycs-wardrobes-row {
    margin-bottom: 24px;
  }

  .ycs-wardrobes-row__head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .ycs-wardrobes-row__title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
  }

  .ycs-wardrobes-row__head h2 {
    margin: 0;
    font-size: 20px;
    line-height: 1.15;
  }

  .ycs-wardrobes-row__count {
    color: #8b8177;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-wardrobes-row__scroll-controls {
    display: flex;
    gap: 6px;
  }

  .ycs-wardrobes-row__scroll-shell {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 34px;
    align-items: start;
    gap: 8px;
    width: 100%;
  }

  .ycs-wardrobes-row__scroll-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid #d8cfc3;
    border-radius: 999px;
    background: #fff;
    color: #2f2a25;
    cursor: pointer;
    font: inherit;
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
  }

  .ycs-wardrobes-row__scroll-button:hover {
    background: #111;
    color: #fff;
  }

  .ycs-wardrobes-row__scroller {
    overflow: hidden;
    padding: 2px 2px 12px;
    width: 100%;
  }

  .ycs-wardrobes-row__track {
    display: flex;
    gap: 12px;
    min-height: 158px;
    transform: translateX(0);
    transition: transform .22s ease;
    will-change: transform;
  }

  .ycs-wardrobes-row__track.is-drop-target {
    outline: 2px dashed #d8cfc3;
    outline-offset: 6px;
  }

  .ycs-wardrobe-card {
    position: relative;
    flex: 0 0 132px;
    width: 132px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-align: left;
  }

  .ycs-wardrobe-card.is-dragging {
    opacity: .42;
  }

  .ycs-wardrobe-card--add {
    min-height: 158px;
  }

  .ycs-wardrobe-card--add .ycs-wardrobe-card__swatch {
    display: grid;
    place-items: center;
    border: 2px dashed #d8cfc3;
    background: #fbfaf8;
    box-shadow: none;
    color: #8b8177;
    font-size: 42px;
    font-weight: 500;
  }

  .ycs-wardrobe-card--add:hover .ycs-wardrobe-card__swatch {
