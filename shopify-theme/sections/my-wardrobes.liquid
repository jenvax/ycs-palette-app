    height: 28px;
    border-radius: 999px;
    background: rgba(255,255,255,.9);
    box-shadow: 0 2px 8px rgba(0,0,0,.14);
    color: #2f2a25;
    cursor: grab;
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
  }

  .ycs-wardrobe-card__handle:active {
    cursor: grabbing;
  }

  .ycs-wardrobe-card__swatch {
    display: grid;
    width: 132px;
    height: 132px;
    overflow: hidden;
    border-radius: 8px;
    background: #f6f1ea;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08), 0 5px 16px rgba(0,0,0,.06);
  }

  @media (min-width: 980px) {
    .ycs-wardrobes-row {
      display: block;
    }

    .ycs-wardrobes-row__head {
      margin-bottom: 10px;
    }
  }

  .ycs-wardrobe-card__swatch span {
    min-width: 0;
    min-height: 0;
  }

  .ycs-wardrobe-card__name {
    display: block;
    margin-top: 7px;
    color: #2f2a25;
    font-size: 13px;
    font-weight: 800;
    line-height: 1.22;
  }

  .ycs-wardrobes-modal {
    position: fixed;
    inset: 0;
    z-index: 10040;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .ycs-wardrobes-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17,17,17,.42);
  }

  .ycs-wardrobes-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(560px, 100%);
    max-height: min(760px, 88vh);
    overflow: auto;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 55px rgba(0,0,0,.22);
    padding: 18px;
  }

  .ycs-wardrobes-modal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }

  .ycs-wardrobes-modal__head h2 {
    margin: 0;
    font-size: 22px;
    line-height: 1.15;
  }

  .ycs-wardrobes__icon-button {
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: #f6f1ea;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .ycs-wardrobes-form {
    display: grid;
    gap: 12px;
  }

  .ycs-wardrobes-form label {
    display: grid;
    gap: 6px;
    color: #4f463d;
    font-size: 13px;
    font-weight: 800;
  }

  .ycs-wardrobes-color-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ycs-wardrobes-color-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid #ddd3c8;
    border-radius: 999px;
    background: #fff;
    padding: 6px 8px;
    color: #2f2a25;
