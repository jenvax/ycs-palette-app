{% assign ycs_member_access = false %}
{% assign ycs_free_member = false %}
{% assign ycs_has_draping_studio = false %}
{% assign ycs_has_owned_palettes = false %}
{% if customer %}
  {% assign ycs_member_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% assign ycs_member_access = true %}
  {% unless ycs_member_tags contains ',YCSMEMBER,' or ycs_member_tags contains ',TRADE,' or ycs_member_tags contains ',YCS_ADMIN,' %}
    {% assign ycs_free_member = true %}
  {% endunless %}
  {% if ycs_member_tags contains ',DRAPINGSTUDIO,' or ycs_member_tags contains ',DRAPINGSTUDIOSTARTER,' %}
    {% assign ycs_has_draping_studio = true %}
  {% endif %}
  {% assign ycs_palette_codes = 'CWL,CWM,CWD,CCL,CCM,CCD,SWL,SWM,SWD,SCL,SCM,SCD,LO,MO,DO,CWLG,CWMG,CWDG,SWLG,SWMG,SWDG' | split: ',' %}
  {% for ycs_palette_code in ycs_palette_codes %}
    {% assign ycs_palette_token = ',' | append: ycs_palette_code | append: ',' %}
    {% if ycs_member_tags contains ycs_palette_token %}
      {% assign ycs_has_owned_palettes = true %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}

<section class="ycs-analyze-hub">
  <nav class="ycs-analyze-hub__topnav" aria-label="Membership navigation">
    {% render 'my-ycs-logo' %}
    <a href="/pages/my-ycs" class="ycs-analyze-hub__back">Back to My YCS</a>
    <a href="mailto:support@yourcolorstyle.com" class="ycs-analyze-hub__back">Contact</a>
  </nav>

  {% if customer == nil %}
    <header class="ycs-analyze-hub__header">
      <p class="ycs-analyze-hub__kicker">Your Color Style</p>
      <h1>Tools</h1>
      <p>Please sign in to access your membership.</p>
      <a href="{{ routes.account_login_url }}?return_url=%2Fpages%2Fmy-ycs" class="ycs-analyze-hub__button">Sign In</a>
    </header>
  {% elsif ycs_member_access == false %}
    <header class="ycs-analyze-hub__header">
      <p class="ycs-analyze-hub__kicker">Your Color Style</p>
      <h1>Tools</h1>
      <p>This membership is not available on your account.</p>
    </header>
  {% else %}
    <header class="ycs-analyze-hub__header">
      <p class="ycs-analyze-hub__kicker">My YCS</p>
      <h1>Tools</h1>
      <p>Manage clients and create guided color analyses.</p>
    </header>

    {% capture ycs_consumer_tool_cards %}
      {% if ycs_has_owned_palettes or ycs_has_draping_studio %}
        <article class="ycs-analyze-card">
          <div class="ycs-analyze-card__accent ycs-analyze-card__accent--draping"></div>
          <div class="ycs-analyze-card__body">
            <h2>Photo Draping Studio</h2>
            {% if ycs_has_draping_studio %}
              <p>See yourself alongside the colors in your purchased digital palettes. Compare shades to discover your favorites.</p>
              <a href="/pages/draping-studio?view=draping-studio&mode=personal" class="ycs-analyze-hub__button">Open Draping Studio</a>
            {% else %}
              <p>See yourself in the colors of your digital palettes. Compare shades side by side with your photo to discover your best colors.</p>
              <a href="/products/photo-draping-studio" class="ycs-analyze-hub__button">Unlock for $10</a>
            {% endif %}
          </div>
        </article>

        {% if ycs_has_draping_studio %}
          <article class="ycs-analyze-card">
            <div class="ycs-analyze-card__accent ycs-analyze-card__accent--photos"></div>
            <div class="ycs-analyze-card__body">
              <h2>My Photos</h2>
              <p>Upload, prepare, and manage the photos you use in Draping Studio.</p>
              <a href="/pages/my-photos" class="ycs-analyze-hub__button">Open My Photos</a>
            </div>
          </article>
        {% endif %}
      {% endif %}
    {% endcapture %}

    <div class="ycs-analyze-hub__grid">
      {% if ycs_free_member %}{{ ycs_consumer_tool_cards }}{% endif %}

      <article class="ycs-analyze-card">
        <div class="ycs-analyze-card__accent ycs-analyze-card__accent--clients"></div>
        <div class="ycs-analyze-card__body">
          <h2>My Clients</h2>
          <p>Manage your clients, prepare photos, create color analyses reports, and send digital color palettes to your clients.</p>
          {% if ycs_free_member %}
            <div class="ycs-analyze-card__member-feature">
              <strong><span aria-hidden="true">&#128274;</span> YCS MEMBER FEATURE</strong>
              <a class="ycs-analyze-hub__button" href="/#membership">Join YCS &rarr;</a>
            </div>
          {% else %}
            <a href="/pages/tools-clients" class="ycs-analyze-hub__button">Open My Clients</a>
          {% endif %}
        </div>
      </article>

      <article class="ycs-analyze-card">
        <div class="ycs-analyze-card__accent ycs-analyze-card__accent--structured"></div>
        <div class="ycs-analyze-card__body">
          <h2>Structured Analysis</h2>
          <p>Follow a guided color analysis process to evaluate depth, undertone, and chroma, step by step.</p>
          {% if ycs_free_member %}
            <div class="ycs-analyze-card__member-feature">
              <strong><span aria-hidden="true">&#128274;</span> YCS MEMBER FEATURE</strong>
              <a class="ycs-analyze-hub__button" href="/#membership">Join YCS &rarr;</a>
            </div>
          {% else %}
            <a href="/pages/tools-photo-prep?mode=trade&amp;workflow=color-analysis&amp;returnUrl=%2Fpages%2Ftools" class="ycs-analyze-hub__button">Open Tool</a>
          {% endif %}
        </div>
      </article>

      <article class="ycs-analyze-card">
        <div class="ycs-analyze-card__accent ycs-analyze-card__accent--lip-draping"></div>
        <div class="ycs-analyze-card__body">
          <h2>Lip &amp; Draping Studio</h2>
          <p>Compare your client side by side with different color palettes, experiment with lip colors, and see how different shades complement their natural coloring.</p>
          {% if ycs_free_member %}
            <div class="ycs-analyze-card__member-feature">
              <strong><span aria-hidden="true">&#128274;</span> YCS MEMBER FEATURE</strong>
              <a class="ycs-analyze-hub__button" href="/#membership">Join YCS &rarr;</a>
            </div>
          {% else %}
            <a href="/pages/tools-lip-draping" class="ycs-analyze-hub__button">Open Lip &amp; Draping Studio</a>
          {% endif %}
        </div>
      </article>

      {% unless ycs_free_member %}{{ ycs_consumer_tool_cards }}{% endunless %}
    </div>
  {% endif %}
</section>

{% style %}
  .shopify-section-header, #shopify-section-header, .site-header, .header-wrapper, .header, nav[role="navigation"], #shopify-section-footer, .shopify-section--footer, .site-footer, footer.footer, footer[role="contentinfo"] { display: none !important; }
  body { margin-top: 0 !important; padding-top: 0 !important; }
  .ycs-analyze-hub { max-width: 1180px; margin: 0 auto; padding: 28px 24px 72px; color: #313238; }
  .ycs-analyze-hub__topnav { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 42px; }
  .ycs-analyze-hub__back { color: #4b4d55; font-size: 15px; font-weight: 600; text-decoration: none; }
  .ycs-analyze-hub__back:hover { text-decoration: underline; }
  .ycs-analyze-hub__header { max-width: 780px; margin-bottom: 42px; }
  .ycs-analyze-hub__kicker { margin: 0 0 8px; color: #bd315b; font-size: 13px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
  .ycs-analyze-hub__header h1 { margin: 0 0 12px; color: #292a30; font-size: 42px; line-height: 1.14; letter-spacing: 0; }
  .ycs-analyze-hub__header > p:not(.ycs-analyze-hub__kicker) { margin: 0; color: #686a72; font-size: 19px; line-height: 1.6; }
  .ycs-analyze-hub__header .ycs-analyze-hub__button { margin-top: 22px; }
  .ycs-analyze-hub__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .ycs-analyze-card { overflow: hidden; border: 1px solid #e7e3df; border-radius: 8px; background: #fff; box-shadow: 0 8px 24px rgba(37, 39, 46, .06); }
  .ycs-analyze-card__accent { height: 10px; }
  .ycs-analyze-card__accent--clients { background: linear-gradient(90deg, #385c7d, #56a3ae, #83c998); }
  .ycs-analyze-card__accent--structured { background: linear-gradient(90deg, #bd315b, #dd7866, #e6bd59); }
  .ycs-analyze-card__accent--lip-draping { background: linear-gradient(90deg, #8c3f78, #d44b70, #ee8665); }
  .ycs-analyze-card__accent--draping { background: linear-gradient(90deg, #6350a8, #b84f86, #de7b68); }
  .ycs-analyze-card__accent--photos { background: linear-gradient(90deg, #24758c, #53a69b, #9acb7a); }
  .ycs-analyze-card__body { display: flex; min-height: 230px; flex-direction: column; align-items: flex-start; padding: 28px; }
  .ycs-analyze-card h2 { margin: 0 0 10px; color: #303139; font-size: 24px; line-height: 1.32; letter-spacing: 0; }
  .ycs-analyze-card p { margin: 0 0 28px; color: #686a72; font-size: 17px; line-height: 1.55; }
  .ycs-analyze-hub__button { display: inline-flex; min-height: 46px; margin-top: auto; align-items: center; justify-content: center; border-radius: 6px; background: #cf3f65; color: #fff; font-size: 15px; font-weight: 700; line-height: 1.2; padding: 12px 20px; text-decoration: none; }
  .ycs-analyze-hub__button:hover { background: #b72f55; color: #fff; }
  .ycs-analyze-card__member-feature { display: flex; margin-top: auto; flex-direction: column; align-items: flex-start; gap: 12px; }
  .ycs-analyze-card__member-feature strong { color: #5c31bd; font-size: 12px; font-weight: 800; letter-spacing: 0; }
  .ycs-analyze-card__member-feature .ycs-analyze-hub__button { margin-top: 0; }
  @media (max-width: 720px) {
    .ycs-analyze-hub { padding: 22px 16px 52px; }
    .ycs-analyze-hub__topnav { margin-bottom: 30px; }
    .ycs-analyze-hub__header h1 { font-size: 32px; }
    .ycs-analyze-hub__grid { grid-template-columns: 1fr; }
    .ycs-analyze-card__body { min-height: 205px; padding: 24px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "My YCS Tools",
  "settings": [],
  "presets": [{ "name": "My YCS Tools" }]
}
{% endschema %}
