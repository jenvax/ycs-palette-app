  .ycs-drape-svg {
    position: absolute;
    bottom: -1%;
    left: 0;
    width: 100%;
    height: 28%;
    filter: blur(1.2px);
    opacity: 1;
  }

  .ycs-drape-overlay-object {
    mix-blend-mode: normal;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .ycs-drape-texture-object {
    mix-blend-mode: var(--drape-texture-blend);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .ycs-drape-texture {
    width: 100%;
    height: 100%;
    background-image: var(--drape-texture-url);
    background-size: var(--drape-texture-size);
    background-position: center;
    background-repeat: repeat;
    mix-blend-mode: var(--drape-texture-blend);
    filter: var(--drape-texture-filter);
    pointer-events: none;
  }

  .ycs-drape-wrap.drape-texture-active .ycs-drape-texture-object {
    opacity: var(--drape-texture-opacity);
  }

  .ycs-drape-overlay {
    width: 100%;
    height: 100%;
    background-color: var(--drape-color);
    background-image: var(--drape-overlay-url);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-blend-mode: multiply;
    mix-blend-mode: normal;
    pointer-events: none;
  }

  .ycs-drape-wrap.drape-realistic .ycs-drape-overlay-object {
