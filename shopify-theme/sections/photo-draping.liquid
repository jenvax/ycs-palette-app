  .ycs-palette-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    height: 40px;
    min-width: 110px;
    padding: 0 36px 0 14px;
    border-radius: 999px;
    border: 1px solid #d6ccc2;
    background: #fff;
