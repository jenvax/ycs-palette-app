{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% assign is_style_masters = false %}
{% if palette_access_string contains ',VIP,' %}
  {% assign is_style_masters = true %}
{% endif %}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}

{% assign is_catool_growth = false %}
{% if palette_access_string contains ',CATOOLGROWTH,' %}
  {% assign is_catool_growth = true %}
{% endif %}

{% assign has_draping_studio_starter = false %}
{% if palette_access_string contains ',DRAPINGSTUDIOSTARTER,' %}
  {% assign has_draping_studio_starter = true %}
{% endif %}

{% assign has_draping_studio = false %}
{% if palette_access_string contains ',DRAPINGSTUDIO,' %}
  {% assign has_draping_studio = true %}
{% endif %}

{% assign has_draping_studio_access = false %}
{% if has_draping_studio_starter or has_draping_studio %}
  {% assign has_draping_studio_access = true %}
{% endif %}

{% assign is_forced_sample_trial = false %}

{% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
{% assign ycs_page_url = ycs_header_content
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | replace: '\/', '/'
  | replace: '\\u0026', '&'
  | replace: '%3F', '?'
  | replace: '%3D', '='
%}

{% assign is_sample_user = false %}
{% if has_draping_studio_access == false %}
  {% if palette_access_string contains ',SAMPLE,' or ycs_page_url contains 'trial=sample' %}
    {% assign is_sample_user = true %}
  {% endif %}
{% endif %}



{% assign real_palette_codes = 'CWL,CWM,CWD,CCL,CCM,CCD,SWL,SWM,SWD,SCL,SCM,SCD,LO,MO,DO,CWLG,CWMG,CWDG,SWLG,SWMG,SWDG' | split: ',' %}

{% assign has_real_palette = false %}
{% for code in real_palette_codes %}
  {% assign palette_token = ',' | append: code | append: ',' %}
  {% if palette_access_string contains palette_token %}
    {% assign has_real_palette = true %}
    {% break %}
  {% endif %}
{% endfor %}

<div
  class="ycs-drape-app"
  data-is-style-masters="{{ is_style_masters }}"
  data-has-draping-studio="{% if has_draping_studio_access %}true{% else %}false{% endif %}"
data-has-draping-studio-starter="{% if has_draping_studio_starter %}true{% else %}false{% endif %}"
data-has-draping-studio-full="{% if has_draping_studio %}true{% else %}false{% endif %}"
  data-is-sample-user="{% if is_sample_user %}true{% else %}false{% endif %}"
  data-customer-id="{{ customer.id }}"
  data-customer-first-name="{{ customer.first_name | escape }}"
  data-palette-access="{{ palette_access_string }}"
  data-is-admin="{{ is_admin }}"
  data-is-catool-growth="{% if is_catool_growth %}true{% else %}false{% endif %}"
  data-app-base-url="https://ycs-palette-app.vercel.app"
>
  {% if customer == nil %}
    <div class="ycs-drape-login">
      <h1>Sign in to access Photo Draping Studio</h1>
      <a href="{{ routes.account_login_url }}">Sign In</a>
    </div>

  {% elsif is_style_masters == false and has_draping_studio_access == false and is_sample_user == false and is_admin != true and is_catool_growth != true %}
    <div class="ycs-drape-upsell ycs-drape-upsell--hero">
      <div class="ycs-drape-upsell-grid">
        <div class="ycs-drape-upsell-media">
          <img
            src="https://cdn.shopify.com/s/files/1/0623/6284/5408/files/Photo_Draping_Studio.png?v=1776007752"
            alt="Photo Draping Studio preview"
            class="ycs-drape-upsell-image"
          >
        </div>

        <div class="ycs-drape-upsell-content">
          <p class="ycs-drape-upsell-kicker">Included with Style Masters</p>

          <h1 class="ycs-drape-upsell-title">
            See Your Colors<br>Near Your Face
          </h1>

          <p class="ycs-drape-upsell-headline">
            Upload your photo and instantly test your best colors—before you buy or get dressed.
          </p>

          <ul class="ycs-drape-upsell-list">
            <li><span class="check">✓</span> Spot your best colors instantly</li>
            <li><span class="check">✓</span> Stop wasting money on wrong shades</li>
            <li><span class="check">✓</span> Get dressed faster with confidence</li>
          </ul>

          <a href="/products/style-masters-magazine" class="ycs-drape-upsell-btn">
            Unlock Photo Draping Studio
          </a>

          <p class="ycs-drape-upsell-micro">
            Try it on your own photo in seconds.
          </p>
        </div>
      </div>
    </div>

  {% else %}
    <div class="ycs-drape-topnav">
      <a href="{{ routes.account_url }}" class="ycs-drape-back-link">My Account</a>
      <a href="/pages/my-palettes" class="ycs-drape-back-link">My Color Palettes</a>
      <a href="/pages/photo-prep?mode=personal&workflow=photo-draping" class="ycs-drape-back-link">Photo Prep</a>

      {% if is_admin %}
        <a
          class="ycs-drape-admin-link"
          href="/pages/photo-prep?adminCustomerId={{ customer.id }}&returnUrl=/pages/photo-draping"
        >
          Prep Photo
        </a>
      {% endif %}
    </div>

    <div id="ycs-drape-studio-root" class="ycs-drape-studio" data-mobile-step="photo">
      
      <div class="ycs-drape-header">
        <p class="ycs-drape-kicker">Your Color Style</p>
        <h1 class="ycs-drape-title">Photo Draping Studio</h1>
        <p class="ycs-drape-subtitle">
          Upload a clear front-facing photo in natural light.
        </p>
      </div>

      <div class="ycs-drape-view-toggle" role="tablist" aria-label="Photo Draping Studio view">
        <button type="button" id="ycs-drape-view-single" class="ycs-drape-view-btn is-active">
          Single View
        </button>
        <button type="button" id="ycs-drape-view-comparison" class="ycs-drape-view-btn">
          Side-by-Side Comparison
        </button>
      </div>

      <div class="ycs-drape-layout">
        <div class="ycs-drape-panel ycs-drape-panel--photo">
          <div class="ycs-drape-photo-panel-head">
            <div class="ycs-drape-photo-panel-head-main">
              <h2 class="ycs-drape-panel__title">Your Photo</h2>
              <p id="ycs-upload-usage-message" class="ycs-upload-usage-message" hidden></p>
            </div>

            <button type="button" id="ycs-mobile-back" class="ycs-mobile-back-btn">
              Adjust Photo
            </button>
          </div>

          <div class="ycs-drape-photo-stage" id="ycs-photo-stage">
            <input
              type="file"
              id="ycs-photo-input"
              accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp"
              style="display:none;"
            />

            <div class="ycs-drape-upload">
              <div class="ycs-drape-upload-inner">
                <p class="ycs-drape-placeholder">Upload your photo to begin</p>
                <button type="button" id="ycs-upload-btn" class="ycs-drape-btn">
                  Upload Photo
                </button>
              </div>
            </div>

            <div id="ycs-drape-loading" class="ycs-drape-loading" hidden>
              <div class="ycs-drape-loading__dots">
                <span></span><span></span><span></span>
              </div>
              <p class="ycs-drape-loading__text">Loading colors…</p>
            </div>

            <div id="ycs-photo-frame" class="ycs-photo-frame">
              <div
                id="ycs-drape-wrap"
                class="ycs-drape-wrap"
                style="--drape-color: #e8dfd4; --drape-overlay-url: url('https://cdn.shopify.com/s/files/1/0623/6284/5408/files/fabric-drape-overlay-550.png?v=1778252521'); --drape-overlay-opacity: 0; --drape-texture-url: none; --drape-texture-opacity: 0;"
              >
                <svg
                  id="ycs-drape-svg"
                  class="ycs-drape-svg"
                  viewBox="0 0 1000 500"
                  preserveAspectRatio="none"
                >
                  <defs>
                    <clipPath id="ycs-drape-clip">
                      <path
                        id="ycs-drape-clip-path"
                        d="M0,235
                          Q160,170 320,182
                          Q500,310 680,182
                          Q840,170 1000,235
                          L1000,500
                          L0,500 Z"
                      />
                    </clipPath>
                  </defs>
                  <path
                    id="ycs-drape-path"
                    d="M0,235
                      Q160,170 320,182
                      Q500,310 680,182
                      Q840,170 1000,235
                      L1000,500
                      L0,500 Z"
                    fill="#e8dfd4"
                  />
                  <foreignObject
                    class="ycs-drape-texture-object"
                    x="0"
                    y="0"
                    width="1000"
                    height="500"
                    clip-path="url(#ycs-drape-clip)"
                  >
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-texture"></div>
                  </foreignObject>
                  <foreignObject
                    class="ycs-drape-overlay-object"
                    x="0"
                    y="0"
                    width="1000"
                    height="500"
                    clip-path="url(#ycs-drape-clip)"
                  >
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-overlay"></div>
                  </foreignObject>
                </svg>
              </div>

              <img id="ycs-photo-preview" class="ycs-photo-preview" alt="Uploaded preview" />
            </div>

            <div id="ycs-replace-confirm" class="ycs-confirm-modal" hidden>
              <div class="ycs-confirm-modal__backdrop"></div>
              <div
                class="ycs-confirm-modal__dialog"
                role="dialog"
                aria-modal="true"
                aria-labelledby="ycs-replace-confirm-title"
                aria-describedby="ycs-replace-confirm-text"
              >
                <h3 id="ycs-replace-confirm-title" class="ycs-confirm-modal__title">Replace photo?</h3>
                <p id="ycs-replace-confirm-text" class="ycs-confirm-modal__text">
                  Replacing your photo will overwrite the current saved photo for this account.
                </p>
                <div class="ycs-confirm-modal__actions">
                  <button type="button" id="ycs-replace-cancel" class="ycs-drape-btn ycs-drape-btn--secondary">
                    Cancel
                  </button>
                  <button type="button" id="ycs-replace-confirm-btn" class="ycs-drape-btn">
                    Replace Photo
                  </button>
                </div>
              </div>
            </div>

            <div id="ycs-usage-modal" class="ycs-confirm-modal" hidden>
  <div class="ycs-confirm-modal__backdrop"></div>
  <div
    class="ycs-confirm-modal__dialog ycs-usage-modal-dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ycs-usage-modal-title"
    aria-describedby="ycs-usage-modal-body"
  >
    <h3 id="ycs-usage-modal-title" class="ycs-confirm-modal__title ycs-usage-modal-title">
      Keep Going
    </h3>

    <div id="ycs-usage-modal-body" class="ycs-confirm-modal__text ycs-usage-modal-body">
      <p>Your free try is complete.</p>
    </div>

    <div class="ycs-usage-modal__actions">
      <a href="/products/photo-draping-studio#order"
         id="ycs-usage-modal-cta"
         class="ycs-drape-btn ycs-usage-modal__primary">
        Get More Uploads
      </a>

      <a href="/products/digital-color-palettes"
         id="ycs-usage-modal-secondary-cta"
         class="ycs-usage-modal__secondary-link">
        Get My Digital Color Palette
      </a>

      <a href="/products/online-color-analysis"
         id="ycs-usage-modal-analysis-link"
         class="ycs-usage-modal__tertiary-link">
        Or get a personal color analysis
      </a>

      <button type="button" id="ycs-usage-modal-close" class="ycs-drape-btn ycs-drape-btn--secondary">
        Not Now
      </button>
    </div>
  </div>
</div>
          </div>

          <div class="ycs-mobile-photo-actions">
  <div class="ycs-drape-control-group">
    <label for="ycs-zoom-slider" class="ycs-drape-label">Zoom</label>
    <input
      type="range"
      id="ycs-zoom-slider"
      min="0.6"
      max="2.5"
      step="0.01"
      value="1"
      class="ycs-drape-range"
    />
  </div>

  <div class="ycs-btn-group">
    <button type="button" id="ycs-save-position-mobile" class="ycs-btn ycs-btn-secondary">
      Save Photo Position
    </button>

    <button type="button" id="ycs-reset-photo-mobile" class="ycs-btn ycs-btn-outline">
      Reset Photo
    </button>

    <button type="button" id="ycs-replace-photo-mobile" class="ycs-btn ycs-btn-outline">
      Replace Photo
    </button>

    <button type="button" id="ycs-delete-photo-mobile" class="ycs-btn ycs-btn-danger" hidden>
      Delete Photo
    </button>

    <button type="button" id="ycs-mobile-continue" class="ycs-btn ycs-btn-primary">
      Continue to Colors
    </button>
  </div>

  <p class="ycs-mobile-help">
    Upload your photo, then drag or pinch to resize and position it before moving on to your colors.
  </p>
</div>
<div class="ycs-drape-save-under-photo">
  <button type="button" id="ycs-save-photo-under-image" class="ycs-btn ycs-btn-primary">
    Save Draped Photo
  </button>
</div>
        </div>

        <div class="ycs-drape-panel ycs-drape-panel--controls">
          <div class="ycs-desktop-photo-actions">
            <div class="ycs-drape-control-group">
              <label for="ycs-zoom-slider-desktop" class="ycs-drape-label">Zoom</label>
              <input
                type="range"
                id="ycs-zoom-slider-desktop"
                min="0.6"
                max="2.5"
                step="0.01"
                value="1"
                class="ycs-drape-range"
              />
            </div>

            <div class="ycs-drape-control-actions">
              <div class="ycs-btn-group">
                <button id="ycs-save-position-desktop" class="ycs-btn ycs-btn-secondary">
                  Save Photo Position
                </button>

                <button id="ycs-reset-photo-desktop" class="ycs-btn ycs-btn-outline">
                  Reset Photo
                </button>

                <button id="ycs-replace-photo-desktop" class="ycs-btn ycs-btn-outline">
                  Replace Photo
                </button>

                <button type="button" id="ycs-delete-photo-desktop" class="ycs-btn ycs-btn-danger" hidden>
                  Delete Photo
                </button>
              </div>
            </div>
          </div>

          <div class="ycs-color-header">
            <div class="ycs-color-title" id="ycs-current-palette-name">
              {{ palette_name }}
            </div>

            <div class="ycs-palette-select-wrap">
              <select id="ycs-drape-palette-select" class="ycs-palette-select"></select>
            </div>
          </div>

          <div class="ycs-filter-row">
            <div id="ycs-drape-filters" class="ycs-drape-filters"></div>

            <div class="ycs-filter-nav">
              <button type="button" id="ycs-filter-left" class="ycs-filter-arrow" aria-label="Scroll filters left">‹</button>
              <button type="button" id="ycs-filter-right" class="ycs-filter-arrow" aria-label="Scroll filters right">›</button>
            </div>
          </div>

          <label class="ycs-drape-toggle">
            <input type="checkbox" id="realisticDrapeToggle" />
            <span>Realistic fabric drape</span>
          </label>

          <div class="ycs-drape-swatches-section">
            <div id="ycs-selected-color" class="ycs-selected-color">
              <button
                type="button"
                id="ycs-drape-fav-btn"
                class="ycs-drape-fav-btn"
                aria-label="Add to favorites"
                title="Add to favorites">
                <span class="ycs-drape-fav-btn__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d="M12 20.2c-.2 0-.4-.1-.6-.2C10.1 19 4 14.7 4 9.6 4 6.9 5.9 5 8.5 5c1.5 0 2.8.7 3.5 1.8C12.7 5.7 14 5 15.5 5 18.1 5 20 6.9 20 9.6c0 5.1-6.1 9.4-7.4 10.4-.2.1-.4.2-.6.2z"></path>
                  </svg>
                </span>
              </button>

              <span class="ycs-selected-name">—</span>
            </div>

            <div id="ycs-swatch-loading" class="ycs-drape-loading" hidden>
              <div class="ycs-drape-loading__dots">
                <span></span><span></span><span></span>
              </div>
              <p class="ycs-drape-loading__text">Loading colors…</p>
            </div>

            <div id="ycs-drape-swatches" class="ycs-drape-swatches"></div>
          </div>
        </div>
      </div>

      <div id="ycs-drape-comparison-layout" class="ycs-drape-comparison-layout" hidden>
        <div class="ycs-drape-comparison-toolbar">
          <div class="ycs-drape-control-group">
            <label for="ycs-zoom-slider-comparison" class="ycs-drape-label">Zoom</label>
            <input
              type="range"
              id="ycs-zoom-slider-comparison"
              min="0.6"
              max="2.5"
              step="0.01"
              value="1"
              class="ycs-drape-range"
            />
          </div>
          <button type="button" id="ycs-save-position-comparison" class="ycs-btn ycs-btn-secondary">
            Save Photo Position
          </button>
          <label class="ycs-drape-toggle">
            <input type="checkbox" id="realisticDrapeToggleComparison" />
            <span>Realistic fabric drape</span>
          </label>
        </div>

        <aside class="ycs-drape-comparison-controls">
          <label for="ycs-drape-left-palette-select" class="ycs-drape-label">Left Palette</label>
          <div class="ycs-palette-select-wrap">
            <select id="ycs-drape-left-palette-select" class="ycs-palette-select"></select>
          </div>
          <div id="ycs-drape-left-filters" class="ycs-drape-filters ycs-drape-comparison-filters"></div>
          <div id="ycs-drape-left-swatches" class="ycs-drape-swatches ycs-drape-comparison-swatches"></div>
        </aside>

        <div class="ycs-drape-comparison-stage-grid">
          <div class="ycs-drape-comparison-stage">
            <div class="ycs-photo-frame ycs-photo-frame--comparison" id="ycs-left-photo-frame">
              <div
                id="ycs-left-drape-wrap"
                class="ycs-drape-wrap"
                style="--drape-color: #e8dfd4; --drape-overlay-url: url('https://cdn.shopify.com/s/files/1/0623/6284/5408/files/fabric-drape-overlay-550.png?v=1778252521'); --drape-overlay-opacity: 0; --drape-texture-url: none; --drape-texture-opacity: 0;"
              >
                <svg class="ycs-drape-svg" viewBox="0 0 1000 500" preserveAspectRatio="none">
                  <defs>
                    <clipPath id="ycs-left-drape-clip">
                      <path class="ycs-comparison-drape-clip-path" d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z" />
                    </clipPath>
                  </defs>
                  <path id="ycs-left-drape-path" class="ycs-comparison-drape-path" d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z" fill="#e8dfd4" />
                  <foreignObject class="ycs-drape-texture-object" x="0" y="0" width="1000" height="500" clip-path="url(#ycs-left-drape-clip)">
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-texture"></div>
                  </foreignObject>
                  <foreignObject class="ycs-drape-overlay-object" x="0" y="0" width="1000" height="500" clip-path="url(#ycs-left-drape-clip)">
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-overlay"></div>
                  </foreignObject>
                </svg>
              </div>
              <img id="ycs-left-photo-preview" class="ycs-photo-preview" alt="Left draped preview" />
            </div>
            <div class="ycs-drape-comparison-footer">
              <div>
                <span class="ycs-drape-comparison-meta">Applied</span>
                <strong id="ycs-drape-left-selected-name">—</strong>
              </div>
              <button type="button" id="ycs-save-left-draped-photo" class="ycs-btn ycs-btn-primary">
                Save Left View
              </button>
            </div>
          </div>

          <div class="ycs-drape-comparison-stage">
            <div class="ycs-photo-frame ycs-photo-frame--comparison" id="ycs-right-photo-frame">
              <div
                id="ycs-right-drape-wrap"
                class="ycs-drape-wrap"
                style="--drape-color: #e8dfd4; --drape-overlay-url: url('https://cdn.shopify.com/s/files/1/0623/6284/5408/files/fabric-drape-overlay-550.png?v=1778252521'); --drape-overlay-opacity: 0; --drape-texture-url: none; --drape-texture-opacity: 0;"
              >
                <svg class="ycs-drape-svg" viewBox="0 0 1000 500" preserveAspectRatio="none">
                  <defs>
                    <clipPath id="ycs-right-drape-clip">
                      <path class="ycs-comparison-drape-clip-path" d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z" />
                    </clipPath>
                  </defs>
                  <path id="ycs-right-drape-path" class="ycs-comparison-drape-path" d="M0,235 Q160,170 320,182 Q500,310 680,182 Q840,170 1000,235 L1000,500 L0,500 Z" fill="#e8dfd4" />
                  <foreignObject class="ycs-drape-texture-object" x="0" y="0" width="1000" height="500" clip-path="url(#ycs-right-drape-clip)">
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-texture"></div>
                  </foreignObject>
                  <foreignObject class="ycs-drape-overlay-object" x="0" y="0" width="1000" height="500" clip-path="url(#ycs-right-drape-clip)">
                    <div xmlns="http://www.w3.org/1999/xhtml" class="ycs-drape-overlay"></div>
                  </foreignObject>
                </svg>
              </div>
              <img id="ycs-right-photo-preview" class="ycs-photo-preview" alt="Right draped preview" />
            </div>
            <div class="ycs-drape-comparison-footer">
              <div>
                <span class="ycs-drape-comparison-meta">Selected</span>
                <strong id="ycs-drape-right-selected-name">—</strong>
              </div>
              <button type="button" id="ycs-save-right-draped-photo" class="ycs-btn ycs-btn-primary">
                Save Right View
              </button>
            </div>
          </div>
        </div>

        <aside class="ycs-drape-comparison-controls">
          <label for="ycs-drape-right-palette-select" class="ycs-drape-label">Right Palette</label>
          <div class="ycs-palette-select-wrap">
            <select id="ycs-drape-right-palette-select" class="ycs-palette-select"></select>
          </div>
          <div id="ycs-drape-right-filters" class="ycs-drape-filters ycs-drape-comparison-filters"></div>
          <div id="ycs-drape-right-swatches" class="ycs-drape-swatches ycs-drape-comparison-swatches"></div>
        </aside>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .ycs-drape-app {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 18px 22px;
  }

  .ycs-drape-topnav {
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }
