  .ycs-drape-wrap {
    --drape-color: #e8dfd4;
    --drape-overlay-url: url("https://cdn.shopify.com/s/files/1/0623/6284/5408/files/fabric-drape-overlay-550.png?v=1778252521");
    --drape-overlay-opacity: 0;
    --drape-texture-url: none;
    --drape-texture-opacity: 0;
    --drape-texture-size: 120px;
    --drape-texture-blend: overlay;
    --drape-texture-filter: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
