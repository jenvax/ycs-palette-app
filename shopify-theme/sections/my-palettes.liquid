</style>
<script>
(function () {
  const root = document.getElementById('ycs-custom-palettes');
  const modal = document.getElementById('ycs-custom-modal');
  if (!root || !modal) return;

  const listEl = root.querySelector('[data-ycs-custom-palettes-list]');
  const emptyEl = root.querySelector('[data-ycs-custom-empty]');
  const statusEl = root.querySelector('[data-ycs-custom-status]');
  const modalTitle = document.getElementById('ycs-custom-modal-title');
  const modalBody = modal.querySelector('[data-ycs-custom-modal-body]');
  const apiBase = (root.dataset.appBaseUrl || '').replace(/\/$/, '') + '/api/custom-palettes';
  const context = {
    customerId: root.dataset.customerId || '',
    previewCustomerId: root.dataset.previewCustomerId || '',
    viewAs: root.dataset.viewAs || '',
    hasGrowthAccess: root.dataset.hasGrowthAccess || '',
    scope: root.dataset.scope || 'private'
  };
  const isStyleMastersAdmin = context.scope === 'stylemasters';
  const state = { colors: [], palettes: [], activePalette: null, colorSearch: '', csvImportColors: [] };

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
    });
  }

  function setStatus(message, isError) {
    if (!statusEl) return;
    statusEl.textContent = message || '';
    statusEl.hidden = !message;
    statusEl.style.borderColor = isError ? '#e09aaa' : '#c9dfcf';
    statusEl.style.background = isError ? '#fff8fa' : '#f6fff8';
  }

  function normalizeHexInput(value) {
    const raw = String(value || '').trim().replace(/^#/, '');
    return /^[0-9a-fA-F]{6}$/.test(raw) ? '#' + raw.toUpperCase() : '';
  }

  function normalizeCsvHeader(value) {
    return String(value || '').trim().toLowerCase().replace(/[^a-z0-9]/g, '');
  }

  function parseCsvRows(text) {
    const rows = [];
    let row = [];
    let value = '';
    let inQuotes = false;

    String(text || '').replace(/^\uFEFF/, '').split('').forEach(function (char, index, chars) {
      const nextChar = chars[index + 1];

      if (char === '"') {
        if (inQuotes && nextChar === '"') {
          value += '"';
          chars[index + 1] = '';
        } else {
          inQuotes = !inQuotes;
        }
        return;
      }

      if (char === ',' && !inQuotes) {
        row.push(value.trim());
        value = '';
        return;
      }

      if ((char === '\n' || char === '\r') && !inQuotes) {
        if (char === '\r' && nextChar === '\n') return;
        row.push(value.trim());
        if (row.some(function (cell) { return cell; })) rows.push(row);
        row = [];
        value = '';
        return;
      }

      value += char;
    });

    row.push(value.trim());
    if (row.some(function (cell) { return cell; })) rows.push(row);
    return rows;
  }

  function parseColorCsv(text) {
    const rows = parseCsvRows(text);
    if (!rows.length) return [];

    const firstRowHeaders = rows[0].map(normalizeCsvHeader);
    let nameIndex = firstRowHeaders.findIndex(function (header) {
      return ['name', 'colorname', 'colourname', 'color'].includes(header);
    });
    let hexIndex = firstRowHeaders.findIndex(function (header) {
      return ['hex', 'hexcode', 'colorhex', 'colourhex'].includes(header);
    });
    const categoryIndex = firstRowHeaders.findIndex(function (header) {
      return ['category', 'colorcategory', 'colourcategory', 'group', 'family'].includes(header);
    });
    const hasHeader = nameIndex !== -1 && hexIndex !== -1;
    const dataRows = hasHeader ? rows.slice(1) : rows;

    if (!hasHeader) {
      nameIndex = 0;
      hexIndex = 1;
    }

    return dataRows.map(function (row, index) {
      return {
        name: row[nameIndex] || '',
        hexCode: normalizeHexInput(row[hexIndex] || ''),
        category: (categoryIndex === -1 ? 'Custom' : row[categoryIndex]) || 'Custom',
        rowNumber: index + (hasHeader ? 2 : 1)
      };
    }).filter(function (color) {
      return color.name || color.hexCode;
    });
  }

  async function requestJson(action, payload) {
    const response = await fetch(apiBase, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.assign({}, context, payload, { action: action }))
    });
    const json = await response.json();
    if (!response.ok) throw new Error(json.error || 'Request failed');
    return json;
  }

  async function loadData() {
    const query = new URLSearchParams(context);
    query.set('action', 'list');
    const response = await fetch(apiBase + '?' + query.toString());
    const json = await response.json();
    if (!response.ok) throw new Error(json.error || 'Unable to load custom palettes');
    state.colors = json.colors || [];
    state.palettes = json.palettes || [];
    renderPalettes();
  }

  function renderPalettes() {
    if (!listEl || !emptyEl) return;
    listEl.innerHTML = '';
    emptyEl.hidden = state.palettes.length > 0;

    state.palettes.forEach(function (palette) {
      const swatches = (palette.colors || []).slice(0, 7).map(function (item) {
        const color = item.color || {};
        return '<span class="ycs-custom-swatch" title="' + escapeHtml(color.name) + ' ' + escapeHtml(color.hexCode) + '" style="background:' + escapeHtml(color.hexCode) + '"></span>';
      }).join('');
      const paletteCode = 'CUSTOM_' + palette.id;
      const visibilityBadge = isStyleMastersAdmin
        ? '<p class="ycs-palette-card__admin-label">' + (palette.visibleToVip ? 'Visible to VIP' : 'Admin only') + '</p>'
        : '';
      const viewLinks = isStyleMastersAdmin && palette.visibleToVip
        ? '<a href="/pages/palette?palette=' + encodeURIComponent(paletteCode) + '" class="ycs-palette-card__button ycs-palette-card__button--secondary">View Palette</a>' +
          '<a href="/pages/photo-prep?mode=personal&workflow=photo-draping&palette=' + encodeURIComponent(paletteCode) + '" class="ycs-palette-card__button ycs-palette-card__button--secondary">Draping Studio</a>'
        : '';
      const visibilityButton = isStyleMastersAdmin
        ? '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="toggle-vip-visibility" data-palette-id="' + escapeHtml(palette.id) + '">' + (palette.visibleToVip ? 'Hide from VIP' : 'Show to VIP') + '</button>'
        : '';

      const card = document.createElement('div');
      card.className = 'ycs-palette-card ycs-custom-card';
      card.innerHTML =
        '<div class="ycs-palette-card__top"><div class="ycs-palette-card__gradient" style="background: linear-gradient(to right, #2f2a25, #d94c6a, #f2b880, #5fb6ff);"></div></div>' +
        '<div class="ycs-palette-card__content">' +
          '<div class="ycs-palette-card__text">' +
            '<h2>' + escapeHtml(palette.name) + '</h2>' +
            '<p class="ycs-palette-card__subtitle">' + palette.colorCount + (palette.colorCount === 1 ? ' custom color' : ' custom colors') + '</p>' +
            visibilityBadge +
            '<div class="ycs-custom-card__swatches">' + swatches + '</div>' +
          '</div>' +
          '<div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">' +
            '<button type="button" class="ycs-palette-card__button" data-ycs-custom-action="open-palette" data-palette-id="' + escapeHtml(palette.id) + '">Open</button>' +
            '<a href="/pages/color-palette-prints" class="ycs-palette-card__button ycs-palette-card__button--secondary">Order Postcards</a>' +
            visibilityButton +
            viewLinks +
            '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="rename-palette" data-palette-id="' + escapeHtml(palette.id) + '">Rename</button>' +
            '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="delete-palette" data-palette-id="' + escapeHtml(palette.id) + '">Delete</button>' +
          '</div>' +
        '</div>';
      listEl.appendChild(card);
    });
  }

  function openModal(title, html) {
    modalTitle.textContent = title;
    modalBody.innerHTML = html;
    modal.hidden = false;
  }

  function focusSearchField() {
    const input = modal.querySelector('[data-ycs-color-search]');
    if (!input) return;
    input.focus();
    input.setSelectionRange(input.value.length, input.value.length);
  }

  function closeModal() {
    modal.hidden = true;
    state.activePalette = null;
    state.csvImportColors = [];
  }

  function colorRows(colors, selectable, paletteColorIds) {
    if (!colors.length) {
      return '<p class="ycs-custom-empty-text">You haven’t added any custom colors yet. Add your first color to begin building your private color collection.</p>';
    }

    return '<div class="ycs-custom-list">' + colors.map(function (color) {
      const disabled = paletteColorIds && paletteColorIds.has(color.id);
      const assignedPaletteNames = state.palettes.filter(function (palette) {
        return (palette.colors || []).some(function (item) {
          return item.color && item.color.id === color.id;
        });
      }).map(function (palette) { return palette.name; });
      const paletteMeta = assignedPaletteNames.length
        ? assignedPaletteNames.join(', ')
        : 'Not assigned to any palette';
      return '<div class="ycs-custom-row">' +
        '<div class="ycs-custom-row__main">' +
          (selectable ? '<input type="checkbox" data-color-select value="' + escapeHtml(color.id) + '"' + (disabled ? ' disabled' : '') + ' aria-label="Select ' + escapeHtml(color.name) + '">' : '') +
          '<span class="ycs-custom-swatch" style="background:' + escapeHtml(color.hexCode) + '"></span>' +
          '<div><p class="ycs-custom-row__name">' + escapeHtml(color.name) + '</p><p class="ycs-custom-row__meta">' + escapeHtml(color.category || 'Custom') + ' • ' + escapeHtml(color.hexCode) + '</p>' + (selectable ? '' : '<p class="ycs-custom-row__meta">' + escapeHtml(paletteMeta) + '</p>') + '</div>' +
        '</div>' +
        (selectable
          ? '<div class="ycs-custom-row__actions">' +
              (disabled
                ? '<span class="ycs-custom-added-label">Added</span>'
                : '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="add-one-color" data-color-id="' + escapeHtml(color.id) + '">Add</button>') +
            '</div>'
          : '<div class="ycs-custom-row__actions"><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="assign-color-palettes" data-color-id="' + escapeHtml(color.id) + '">Palettes</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="edit-color" data-color-id="' + escapeHtml(color.id) + '">Edit</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="delete-color" data-color-id="' + escapeHtml(color.id) + '">Delete</button></div>') +
      '</div>';
    }).join('') + '</div>';
  }

  function filteredColors() {
    const query = state.colorSearch.trim().toLowerCase();
    if (!query) return state.colors;
    return state.colors.filter(function (color) {
      return color.name.toLowerCase().includes(query) || color.hexCode.toLowerCase().includes(query);
    });
  }

  function myColorRows(colors) {
    if (!colors.length) {
      return '<p class="ycs-custom-empty-text">You haven’t added any custom colors yet. Add your first color to begin building your private color collection.</p>';
    }

    return '<div class="ycs-custom-list">' + colors.map(function (color) {
      const assignedPaletteNames = state.palettes.filter(function (palette) {
        return (palette.colors || []).some(function (item) {
          return item.color && item.color.id === color.id;
        });
      }).map(function (palette) { return palette.name; });
      const paletteMeta = assignedPaletteNames.length
        ? assignedPaletteNames.join(', ')
        : 'Not assigned to any palette';

      return '<div class="ycs-custom-row">' +
        '<div class="ycs-custom-row__main">' +
          '<input type="checkbox" data-manage-color-select value="' + escapeHtml(color.id) + '" aria-label="Select ' + escapeHtml(color.name) + '">' +
          '<span class="ycs-custom-swatch" style="background:' + escapeHtml(color.hexCode) + '"></span>' +
          '<div><p class="ycs-custom-row__name">' + escapeHtml(color.name) + '</p><p class="ycs-custom-row__meta">' + escapeHtml(color.category || 'Custom') + ' • ' + escapeHtml(color.hexCode) + '</p><p class="ycs-custom-row__meta">' + escapeHtml(paletteMeta) + '</p></div>' +
        '</div>' +
        '<div class="ycs-custom-row__actions"><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="assign-color-palettes" data-color-id="' + escapeHtml(color.id) + '">Palettes</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="edit-color" data-color-id="' + escapeHtml(color.id) + '">Edit</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="delete-color" data-color-id="' + escapeHtml(color.id) + '">Delete</button></div>' +
      '</div>';
    }).join('') + '</div>';
  }

  function renderMyColors(error) {
    const colors = filteredColors();
    openModal('My Colors',
      '<div class="ycs-custom-toolbar">' +
        '<label>Search My Colors<input type="search" data-ycs-color-search value="' + escapeHtml(state.colorSearch) + '"></label>' +
      '</div>' +
      '<form class="ycs-custom-form" data-ycs-color-form>' +
        '<div class="ycs-custom-form__row">' +
          '<label>Color Name<input name="name" required></label>' +
          '<label>Hex Code<input name="hexCode" required placeholder="#D94C6A"></label>' +
          '<label>Category<input name="category" placeholder="Reds"></label>' +
          '<div class="ycs-custom-preview"><span>Preview</span><span class="ycs-custom-swatch" data-ycs-hex-preview></span></div>' +
        '</div>' +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button">Save</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-close>Cancel</button></div>' +
      '</form>' +
      '<div class="ycs-custom-batch-bar">' +
        '<label><input type="checkbox" data-manage-color-select-all' + (colors.length ? '' : ' disabled') + '> Select all visible colors</label>' +
        '<button type="button" class="ycs-palette-card__button" data-ycs-custom-action="batch-assign-colors"' + (state.palettes.length && colors.length ? '' : ' disabled') + '>Assign Selected to Palette</button>' +
      '</div>' +
      myColorRows(colors)
    );
  }

  function renderColorEdit(color, error) {
    openModal('Edit Custom Color',
      '<form class="ycs-custom-form" data-ycs-color-form data-color-id="' + escapeHtml(color.id) + '">' +
        '<div class="ycs-custom-form__row">' +
          '<label>Color Name<input name="name" required value="' + escapeHtml(color.name) + '"></label>' +
          '<label>Hex Code<input name="hexCode" required value="' + escapeHtml(color.hexCode) + '"></label>' +
          '<label>Category<input name="category" value="' + escapeHtml(color.category || 'Custom') + '"></label>' +
          '<div class="ycs-custom-preview"><span>Preview</span><span class="ycs-custom-swatch" data-ycs-hex-preview style="background:' + escapeHtml(color.hexCode) + '"></span></div>' +
        '</div>' +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button">Save</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="manage-colors">Cancel</button></div>' +
      '</form>');
  }

  function renderColorPaletteAssignments(color, error) {
    const assignedPaletteIds = new Set(state.palettes.filter(function (palette) {
      return (palette.colors || []).some(function (item) {
        return item.color && item.color.id === color.id;
      });
    }).map(function (palette) { return palette.id; }));
    const paletteOptions = state.palettes.length
      ? '<div class="ycs-custom-assignment-list">' + state.palettes.map(function (palette) {
          const checked = assignedPaletteIds.has(palette.id);
          return '<label class="ycs-custom-assignment-row">' +
            '<input type="checkbox" name="paletteIds" value="' + escapeHtml(palette.id) + '"' + (checked ? ' checked' : '') + '>' +
            '<span>' + escapeHtml(palette.name) + '</span>' +
            '<small>' + palette.colorCount + (palette.colorCount === 1 ? ' color' : ' colors') + '</small>' +
          '</label>';
        }).join('') + '</div>'
      : '<p class="ycs-custom-empty-text">Create a custom palette first, then assign this color to it.</p>';

    openModal('Assign ' + color.name + ' To Palettes',
      '<form class="ycs-custom-form" data-ycs-color-palettes-form data-color-id="' + escapeHtml(color.id) + '">' +
        '<div class="ycs-custom-assignment-preview">' +
          '<span class="ycs-custom-swatch" style="background:' + escapeHtml(color.hexCode) + '"></span>' +
          '<div><p class="ycs-custom-row__name">' + escapeHtml(color.name) + '</p><p class="ycs-custom-row__meta">' + escapeHtml(color.category || 'Custom') + ' • ' + escapeHtml(color.hexCode) + '</p></div>' +
        '</div>' +
        paletteOptions +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button"' + (state.palettes.length ? '' : ' disabled') + '>Save Palette Assignments</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="manage-colors">Cancel</button></div>' +
      '</form>');
  }

  function renderBatchAssignColors(colorIds, error) {
    const selectedColors = colorIds.map(function (colorId) {
      return state.colors.find(function (color) { return color.id === colorId; });
    }).filter(Boolean);
    const paletteOptions = state.palettes.map(function (palette) {
      return '<option value="' + escapeHtml(palette.id) + '">' + escapeHtml(palette.name) + '</option>';
    }).join('');
    const preview = selectedColors.slice(0, 8).map(function (color) {
      return '<span class="ycs-custom-swatch" title="' + escapeHtml(color.name) + '" style="background:' + escapeHtml(color.hexCode) + '"></span>';
    }).join('');
    const moreCount = selectedColors.length > 8 ? selectedColors.length - 8 : 0;

    openModal('Assign Selected Colors',
      '<form class="ycs-custom-form" data-ycs-batch-color-palette-form data-color-ids="' + escapeHtml(colorIds.join(',')) + '">' +
        '<p class="ycs-custom-batch-summary">' + selectedColors.length + (selectedColors.length === 1 ? ' color selected' : ' colors selected') + '</p>' +
        '<div class="ycs-custom-card__swatches">' + preview + (moreCount ? '<span class="ycs-custom-added-label">+' + moreCount + '</span>' : '') + '</div>' +
        '<label>Assign to Palette<select name="paletteId" required>' + paletteOptions + '</select></label>' +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button">Assign Colors</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="manage-colors">Cancel</button></div>' +
      '</form>');
  }

  function renderPaletteForm(title, action, palette, error) {
    openModal(title,
      '<form class="ycs-custom-form" data-ycs-palette-form data-action="' + action + '" data-palette-id="' + escapeHtml((palette && palette.id) || '') + '">' +
        '<label>Palette Name<input name="name" required value="' + escapeHtml((palette && palette.name) || '') + '"></label>' +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button">Save</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-close>Cancel</button></div>' +
      '</form>');
  }

  function orderedPaletteColorGroups(colors) {
    const categoryOrder = [
      'Reds', 'Oranges', 'Golden Yellows', 'Yellows', 'Yellow Greens',
      'Greens', 'Aquas/Teals', 'Blues', 'Indigos', 'Purples', 'Plums',
      'Magentas', 'Pinks', 'Neutrals', 'Custom'
    ];
    const groups = {};

    colors.forEach(function (item) {
      const color = item.color || {};
      const category = String(color.category || 'Custom').trim() || 'Custom';
      if (!groups[category]) groups[category] = [];
      groups[category].push(item);
    });

    return categoryOrder.filter(function (category) {
      return groups[category];
    }).concat(Object.keys(groups).filter(function (category) {
      return categoryOrder.indexOf(category) === -1;
    }).sort()).map(function (category) {
      return { category: category, colors: groups[category] };
    });
  }

  function importPreviewRows(colors) {
    if (!colors.length) {
      return '<p class="ycs-custom-empty-text">Choose a CSV with color names and hex codes.</p>';
    }

    return '<div class="ycs-custom-import-preview">' + colors.slice(0, 25).map(function (color) {
      const isValid = color.name && color.hexCode;
      return '<div class="ycs-custom-row">' +
        '<div class="ycs-custom-row__main">' +
          '<span class="ycs-custom-swatch" style="background:' + escapeHtml(color.hexCode || '#FFFFFF') + '"></span>' +
          '<div><p class="ycs-custom-row__name">' + escapeHtml(color.name || 'Missing color name') + '</p><p class="ycs-custom-row__meta">' + (isValid ? escapeHtml(color.category || 'Custom') + ' • ' + escapeHtml(color.hexCode) : 'Row ' + color.rowNumber + ' needs a name and valid hex code') + '</p></div>' +
        '</div>' +
      '</div>';
    }).join('') + (colors.length > 25 ? '<p class="ycs-custom-batch-summary">+' + (colors.length - 25) + ' more colors</p>' : '') + '</div>';
  }

  function renderCsvImport(error, colors, paletteName) {
    const parsedColors = Array.isArray(colors) ? colors : [];
    const hasInvalid = parsedColors.some(function (color) { return !color.name || !color.hexCode; });
    openModal('Upload Color Palette CSV',
      '<form class="ycs-custom-form" data-ycs-csv-import-form>' +
        '<label>Palette Name<input name="name" required value="' + escapeHtml(paletteName || '') + '"></label>' +
        '<label>CSV File<input name="csvFile" type="file" accept=".csv,text/csv"' + (parsedColors.length ? '' : ' required') + '></label>' +
        '<p class="ycs-custom-help-text">Use columns named Name, Hex, and optional Category. Two-column CSV files are read as name, hex and categorized as Custom.</p>' +
        '<div data-ycs-csv-preview>' + importPreviewRows(parsedColors) + '</div>' +
        (error ? '<p class="ycs-custom-error">' + escapeHtml(error) + '</p>' : '') +
        '<div class="ycs-custom-form__actions"><button type="submit" class="ycs-palette-card__button"' + (parsedColors.length && !hasInvalid ? '' : ' disabled') + '>Import Palette</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-close>Cancel</button></div>' +
      '</form>');
  }

  function renderPaletteDetail(palette) {
    state.activePalette = palette;
    const colors = palette.colors || [];
    const rows = colors.length ? orderedPaletteColorGroups(colors).map(function (group) {
      return '<div class="ycs-custom-list"><p class="ycs-custom-batch-summary">' + escapeHtml(group.category) + '</p>' + group.colors.map(function (item) {
        const color = item.color;
        const index = colors.indexOf(item);
        return '<div class="ycs-custom-row">' +
          '<div class="ycs-custom-row__main"><input type="checkbox" data-palette-color-select value="' + escapeHtml(color.id) + '" aria-label="Select ' + escapeHtml(color.name) + '"><span class="ycs-custom-swatch" style="background:' + escapeHtml(color.hexCode) + '"></span><div><p class="ycs-custom-row__name">' + escapeHtml(color.name) + '</p><p class="ycs-custom-row__meta">' + escapeHtml(color.category || 'Custom') + ' • ' + escapeHtml(color.hexCode) + '</p></div></div>' +
          '<div class="ycs-custom-row__actions">' +
            '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="move-color" data-direction="up" data-color-id="' + escapeHtml(color.id) + '"' + (index === 0 ? ' disabled' : '') + '>Move Up</button>' +
            '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="move-color" data-direction="down" data-color-id="' + escapeHtml(color.id) + '"' + (index === colors.length - 1 ? ' disabled' : '') + '>Move Down</button>' +
            '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="remove-from-palette" data-color-id="' + escapeHtml(color.id) + '">Remove</button>' +
          '</div></div>';
      }).join('') + '</div>';
    }).join('') : '<p class="ycs-custom-empty-text">This palette does not have any colors yet. Add colors from My Colors.</p>';

    openModal(palette.name,
      '<div class="ycs-custom-form__actions" style="margin-bottom:16px">' +
        '<button type="button" class="ycs-palette-card__button" data-ycs-custom-action="add-colors">Add Colors</button>' +
        '<button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="rename-palette" data-palette-id="' + escapeHtml(palette.id) + '">Rename</button>' +
      '</div>' +
      (colors.length
        ? '<div class="ycs-custom-batch-bar"><label><input type="checkbox" data-palette-color-select-all> Select all visible colors</label><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="remove-selected-from-palette">Remove Selected</button></div>'
        : '') +
      rows);
  }

  function renderAddColors() {
    const selectedIds = new Set((state.activePalette.colors || []).map(function (item) { return item.color.id; }));
    const hasAvailableColors = state.colors.some(function (color) { return !selectedIds.has(color.id); });
    const emptyAction = state.colors.length
      ? ''
      : '<div class="ycs-custom-form__actions" style="margin-top:12px"><button type="button" class="ycs-palette-card__button" data-ycs-custom-action="manage-colors">Add Color</button></div>';
    openModal('Add Colors',
      '<div class="ycs-custom-toolbar"><label>Search My Colors<input type="search" data-ycs-color-search value="' + escapeHtml(state.colorSearch) + '"></label></div>' +
      colorRows(filteredColors(), true, selectedIds) +
      emptyAction +
      '<div class="ycs-custom-form__actions" style="margin-top:16px"><button type="button" class="ycs-palette-card__button" data-ycs-custom-action="save-add-colors"' + (hasAvailableColors ? '' : ' disabled') + '>Add Selected Colors</button><button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="open-palette" data-palette-id="' + escapeHtml(state.activePalette.id) + '">Cancel</button></div>');
  }

  async function refreshAfterMutation(message) {
    await loadData();
    setStatus(message || '', false);
  }

  root.addEventListener('click', function (event) {
    const button = event.target.closest('[data-ycs-custom-action]');
    if (!button) return;
    const action = button.dataset.ycsCustomAction;
    const palette = state.palettes.find(function (item) { return item.id === button.dataset.paletteId; });
    if (action === 'create-palette') renderPaletteForm('Create Custom Palette', 'createPalette');
    if (action === 'import-csv') {
      state.csvImportColors = [];
      renderCsvImport();
    }
    if (action === 'manage-colors') renderMyColors();
    if (action === 'open-palette' && palette) renderPaletteDetail(palette);
    if (action === 'rename-palette' && palette) renderPaletteForm('Rename Custom Palette', 'renamePalette', palette);
    if (action === 'toggle-vip-visibility' && palette) {
      requestJson('setPaletteVipVisibility', { paletteId: palette.id, visibleToVip: !palette.visibleToVip }).then(function () {
        return refreshAfterMutation(palette.visibleToVip ? 'Palette hidden from VIP users.' : 'Palette visible to VIP users.');
      }).catch(function (error) { setStatus(error.message, true); });
    }
    if (action === 'delete-palette' && palette && confirm('Delete this custom palette? This will not delete its colors from My Colors.')) {
      requestJson('deletePalette', { paletteId: palette.id }).then(function () { return refreshAfterMutation('Custom palette deleted.'); }).catch(function (error) { setStatus(error.message, true); });
    }
  });

  modal.addEventListener('click', function (event) {
    if (event.target.closest('[data-ycs-custom-close]')) closeModal();
    const button = event.target.closest('[data-ycs-custom-action]');
    if (!button) return;
    const action = button.dataset.ycsCustomAction;
    const color = state.colors.find(function (item) { return item.id === button.dataset.colorId; });
    const palette = state.palettes.find(function (item) { return item.id === button.dataset.paletteId; }) || state.activePalette;

    if (action === 'manage-colors') renderMyColors();
    if (action === 'edit-color' && color) renderColorEdit(color);
    if (action === 'assign-color-palettes' && color) renderColorPaletteAssignments(color);
    if (action === 'batch-assign-colors') {
      const colorIds = Array.from(modal.querySelectorAll('[data-manage-color-select]:checked')).map(function (input) { return input.value; });
      if (!colorIds.length) {
        renderMyColors('Select at least one color to assign.');
      } else {
        renderBatchAssignColors(colorIds);
      }
    }
    if (action === 'delete-color' && color) {
      const message = color.paletteCount > 0
        ? 'Delete this custom color? It will also be removed from any custom palettes that use it.'
        : 'Delete this custom color?';
      if (confirm(message)) {
        requestJson('deleteColor', { colorId: color.id }).then(function () { return refreshAfterMutation('Custom color deleted.'); }).then(renderMyColors).catch(function (error) { renderMyColors(error.message); });
      }
    }
    if (action === 'rename-palette' && palette) renderPaletteForm('Rename Custom Palette', 'renamePalette', palette);
    if (action === 'open-palette' && palette) renderPaletteDetail(palette);
    if (action === 'add-colors') renderAddColors();
    if (action === 'add-one-color' && state.activePalette && color) {
      requestJson('addColorsToPalette', { paletteId: state.activePalette.id, colorIds: [color.id] }).then(function (json) {
        return refreshAfterMutation('Color added.').then(function () { renderPaletteDetail(json.palette); });
      }).catch(function (error) { setStatus(error.message, true); });
    }
    if (action === 'save-add-colors' && state.activePalette) {
      const colorIds = Array.from(modal.querySelectorAll('[data-color-select]:checked')).map(function (input) { return input.value; });
      requestJson('addColorsToPalette', { paletteId: state.activePalette.id, colorIds: colorIds }).then(function (json) {
        return refreshAfterMutation('Colors added.').then(function () { renderPaletteDetail(json.palette); });
      }).catch(function (error) { setStatus(error.message, true); });
    }
    if (action === 'remove-from-palette' && state.activePalette && color) {
      requestJson('removeColorFromPalette', { paletteId: state.activePalette.id, colorId: color.id }).then(function (json) {
        return refreshAfterMutation('Color removed from custom palette.').then(function () { renderPaletteDetail(json.palette); });
      }).catch(function (error) { setStatus(error.message, true); });
    }
    if (action === 'remove-selected-from-palette' && state.activePalette) {
      const colorIds = Array.from(modal.querySelectorAll('[data-palette-color-select]:checked')).map(function (input) { return input.value; });
      if (!colorIds.length) {
        setStatus('Select at least one color to remove.', true);
        return;
      }
      Promise.all(colorIds.map(function (colorId) {
        return requestJson('removeColorFromPalette', { paletteId: state.activePalette.id, colorId: colorId });
      })).then(function () {
        return refreshAfterMutation('Selected colors removed from custom palette.');
      }).then(function () {
        const palette = state.palettes.find(function (item) { return item.id === state.activePalette.id; });
        renderPaletteDetail(palette || state.activePalette);
      }).catch(function (error) { setStatus(error.message, true); });
    }
    if (action === 'move-color' && state.activePalette) {
      const colorIds = state.activePalette.colors.map(function (item) { return item.color.id; });
      const index = colorIds.indexOf(button.dataset.colorId);
      const swapIndex = button.dataset.direction === 'up' ? index - 1 : index + 1;
      if (index < 0 || swapIndex < 0 || swapIndex >= colorIds.length) return;
      const moved = colorIds[index];
      colorIds[index] = colorIds[swapIndex];
      colorIds[swapIndex] = moved;
      requestJson('reorderPaletteColors', { paletteId: state.activePalette.id, colorIds: colorIds }).then(function (json) {
        return refreshAfterMutation('Palette color order saved.').then(function () { renderPaletteDetail(json.palette); });
      }).catch(function (error) { setStatus(error.message, true); });
    }
  });

  modal.addEventListener('input', function (event) {
    if (event.target.matches('[data-manage-color-select-all]')) {
      modal.querySelectorAll('[data-manage-color-select]').forEach(function (input) {
        input.checked = event.target.checked;
      });
    }
    if (event.target.matches('[data-palette-color-select-all]')) {
      modal.querySelectorAll('[data-palette-color-select]').forEach(function (input) {
        input.checked = event.target.checked;
      });
    }
    if (event.target.matches('[data-ycs-color-search]')) {
      state.colorSearch = event.target.value;
      if (state.activePalette && modalTitle.textContent === 'Add Colors') renderAddColors();
      else renderMyColors();
      focusSearchField();
    }
    if (event.target.name === 'hexCode') {
      const preview = modal.querySelector('[data-ycs-hex-preview]');
      const normalized = normalizeHexInput(event.target.value);
      if (preview && normalized) preview.style.background = normalized;
    }
  });

  modal.addEventListener('change', function (event) {
    if (!event.target.matches('input[name="csvFile"]')) return;

    const form = event.target.closest('[data-ycs-csv-import-form]');
    const file = event.target.files && event.target.files[0];
    const paletteName = form ? new FormData(form).get('name') : '';

    if (!file) {
      state.csvImportColors = [];
      renderCsvImport('', state.csvImportColors, paletteName);
      return;
    }

    if (!/\.csv$/i.test(file.name) && file.type && file.type !== 'text/csv') {
      state.csvImportColors = [];
      renderCsvImport('Choose a CSV file.', state.csvImportColors, paletteName);
      return;
    }

    const reader = new FileReader();
    reader.onload = function () {
      state.csvImportColors = parseColorCsv(reader.result || '');
      renderCsvImport('', state.csvImportColors, paletteName || file.name.replace(/\.csv$/i, ''));
    };
    reader.onerror = function () {
      state.csvImportColors = [];
      renderCsvImport('Unable to read this CSV file.', state.csvImportColors, paletteName);
    };
    reader.readAsText(file);
  });

  modal.addEventListener('submit', function (event) {
    const colorForm = event.target.closest('[data-ycs-color-form]');
    const paletteForm = event.target.closest('[data-ycs-palette-form]');
    const colorPalettesForm = event.target.closest('[data-ycs-color-palettes-form]');
    const batchColorPaletteForm = event.target.closest('[data-ycs-batch-color-palette-form]');
    const csvImportForm = event.target.closest('[data-ycs-csv-import-form]');
    if (!colorForm && !paletteForm && !colorPalettesForm && !batchColorPaletteForm && !csvImportForm) return;
    event.preventDefault();

    if (colorForm) {
      const formData = new FormData(colorForm);
      const colorId = colorForm.dataset.colorId || '';
      const payload = {
        colorId: colorId,
        name: formData.get('name'),
        hexCode: formData.get('hexCode'),
        category: formData.get('category')
      };
      requestJson(colorId ? 'updateColor' : 'createColor', payload).then(function () {
        return refreshAfterMutation(colorId ? 'Custom color updated.' : 'Custom color added.');
      }).then(renderMyColors).catch(function (error) {
        if (colorId) {
          const color = state.colors.find(function (item) { return item.id === colorId; });
          renderColorEdit(color || payload, error.message);
        } else {
          renderMyColors(error.message);
        }
      });
    }

    if (paletteForm) {
      const formData = new FormData(paletteForm);
      const action = paletteForm.dataset.action;
      const paletteId = paletteForm.dataset.paletteId || '';
      requestJson(action, { paletteId: paletteId, name: formData.get('name') }).then(function (json) {
        return refreshAfterMutation(action === 'createPalette' ? 'Custom palette created.' : 'Custom palette renamed.').then(function () {
          renderPaletteDetail(json.palette);
        });
      }).catch(function (error) {
        renderPaletteForm(action === 'createPalette' ? 'Create Custom Palette' : 'Rename Custom Palette', action, { id: paletteId, name: formData.get('name') }, error.message);
      });
    }

    if (colorPalettesForm) {
      const colorId = colorPalettesForm.dataset.colorId || '';
      const color = state.colors.find(function (item) { return item.id === colorId; });
      const paletteIds = Array.from(colorPalettesForm.querySelectorAll('input[name="paletteIds"]:checked')).map(function (input) { return input.value; });
      requestJson('setColorPalettes', { colorId: colorId, paletteIds: paletteIds }).then(function (json) {
        state.colors = json.colors || [];
        state.palettes = json.palettes || [];
        renderMyColors();
        setStatus('Palette assignments saved.', false);
      }).catch(function (error) {
        renderColorPaletteAssignments(color || { id: colorId, name: 'Custom Color', hexCode: '#FFFFFF' }, error.message);
      });
    }

    if (batchColorPaletteForm) {
      const formData = new FormData(batchColorPaletteForm);
      const colorIds = (batchColorPaletteForm.dataset.colorIds || '').split(',').map(function (colorId) { return colorId.trim(); }).filter(Boolean);
      const paletteId = formData.get('paletteId');
      requestJson('addColorsToPalette', { paletteId: paletteId, colorIds: colorIds }).then(function () {
        return refreshAfterMutation('Selected colors assigned to palette.');
      }).then(renderMyColors).catch(function (error) {
        renderBatchAssignColors(colorIds, error.message);
      });
    }

    if (csvImportForm) {
      const formData = new FormData(csvImportForm);
      const colors = state.csvImportColors || [];
      const hasInvalid = colors.some(function (color) { return !color.name || !color.hexCode; });

      if (!colors.length || hasInvalid) {
        renderCsvImport('Choose a CSV with valid color names and hex codes.', colors, formData.get('name'));
        return;
      }

      requestJson('importPaletteCsv', {
        name: formData.get('name'),
        colors: colors
      }).then(function (json) {
        state.csvImportColors = [];
        return refreshAfterMutation('Custom palette imported from CSV.').then(function () {
          renderPaletteDetail(json.palette);
        });
      }).catch(function (error) {
        renderCsvImport(error.message, colors, formData.get('name'));
      });
    }
  });

  loadData().catch(function (error) {
    setStatus(error.message, true);
  });
})();

(function () {
  const root = document.getElementById('ycs-style-masters-palettes');
  if (!root) return;

  const listEl = root.querySelector('[data-ycs-style-masters-list]');
  const emptyEl = root.querySelector('[data-ycs-style-masters-empty]');
  const statusEl = root.querySelector('[data-ycs-style-masters-status]');
  const apiBase = (root.dataset.appBaseUrl || '').replace(/\/$/, '') + '/api/custom-palettes';
  const context = {
    customerId: root.dataset.customerId || ''
  };

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
    });
  }

  function setStatus(message, isError) {
    if (!statusEl) return;
    statusEl.textContent = message || '';
    statusEl.hidden = !message;
    statusEl.style.borderColor = isError ? '#e09aaa' : '#c9dfcf';
    statusEl.style.background = isError ? '#fff8fa' : '#f6fff8';
  }

  function renderPalettes(palettes) {
    if (!listEl || !emptyEl) return;
    listEl.innerHTML = '';
    if (!palettes.length) {
      root.hidden = true;
      emptyEl.hidden = false;
      return;
    }

    root.hidden = false;
    emptyEl.hidden = true;

    palettes.forEach(function (palette) {
      const paletteCode = 'CUSTOM_' + palette.id;
      const swatches = (palette.colors || []).slice(0, 8).map(function (item) {
        const color = item.color || {};
        return '<span class="ycs-custom-swatch" title="' + escapeHtml(color.name) + ' ' + escapeHtml(color.hexCode) + '" style="background:' + escapeHtml(color.hexCode) + '"></span>';
      }).join('');
      const card = document.createElement('div');
      card.className = 'ycs-palette-card ycs-custom-card';
      card.innerHTML =
        '<div class="ycs-palette-card__top"><div class="ycs-palette-card__gradient" style="background: linear-gradient(to right, #2f2a25, #d94c6a, #f2b880, #5fb6ff);"></div></div>' +
        '<div class="ycs-palette-card__content">' +
          '<div class="ycs-palette-card__text">' +
            '<h2>' + escapeHtml(palette.name) + '</h2>' +
            '<p class="ycs-palette-card__subtitle">' + palette.colorCount + (palette.colorCount === 1 ? ' custom color' : ' custom colors') + '</p>' +
            '<div class="ycs-custom-card__swatches">' + swatches + '</div>' +
          '</div>' +
          '<div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">' +
            '<a href="/pages/palette?palette=' + encodeURIComponent(paletteCode) + '" class="ycs-palette-card__button">Open Palette</a>' +
            '<a href="/pages/color-palette-prints" class="ycs-palette-card__button ycs-palette-card__button--secondary">Order Postcards</a>' +
            '<a href="/pages/photo-prep?mode=personal&workflow=photo-draping&palette=' + encodeURIComponent(paletteCode) + '" class="ycs-palette-card__button ycs-palette-card__button--secondary">Draping Studio</a>' +
          '</div>' +
        '</div>';
      listEl.appendChild(card);
    });
  }

  const query = new URLSearchParams(context);
  query.set('action', 'vipList');
  fetch(apiBase + '?' + query.toString()).then(function (response) {
    return response.json().then(function (json) {
      if (!response.ok) throw new Error(json.error || 'Unable to load Style Masters palettes');
      renderPalettes(json.palettes || []);
    });
  }).catch(function (error) {
    console.error('Failed to load VIP Style Masters palettes', error);
    root.hidden = true;
    setStatus('', false);
  });
})();

(function () {
  let pdfLogoPromise = null;

  function normalizeHexInput(value) {
    const raw = String(value || '').trim().replace(/^#/, '');
    return /^[0-9a-fA-F]{6}$/.test(raw) ? '#' + raw.toUpperCase() : '';
  }

  function normalizePrintHex(value) {
    return normalizeHexInput(value) || '#FFFFFF';
  }

  function loadPdfLogoData() {
    if (pdfLogoPromise) return pdfLogoPromise;

    pdfLogoPromise = fetch('https://cdn.shopify.com/s/files/1/0623/6284/5408/files/YourColorStyle_Logo-120_e3c4c33e-3249-4120-8dc6-c665eb3fec9f.png?v=1644954058')
      .then(function (response) {
        if (!response.ok) throw new Error('Unable to load logo.');
        return response.blob();
      })
      .then(function (blob) {
        return new Promise(function (resolve) {
          const image = new Image();
          image.onload = function () {
            URL.revokeObjectURL(image.src);
            const targetWidth = 144;
            const targetHeight = Math.max(1, Math.round(targetWidth * (image.naturalHeight / image.naturalWidth)));
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');

            canvas.width = targetWidth;
            canvas.height = targetHeight;
            context.fillStyle = '#FFFFFF';
            context.fillRect(0, 0, targetWidth, targetHeight);
            context.drawImage(image, 0, 0, targetWidth, targetHeight);

            const dataUrl = canvas.toDataURL('image/jpeg', 0.92);
            resolve({
              data: atob(dataUrl.split(',')[1] || ''),
              width: targetWidth,
              height: targetHeight
            });
          };
          image.onerror = function () {
            URL.revokeObjectURL(image.src);
            resolve(null);
          };
          image.src = URL.createObjectURL(blob);
        });
      })
      .catch(function () {
        return null;
      });

    return pdfLogoPromise;
  }

  function normalizePdfText(value) {
    return String(value || '')
      .replace(/[\u2018\u2019]/g, "'")
      .replace(/[\u201C\u201D]/g, '"')
      .replace(/[\u2013\u2014]/g, '-')
      .replace(/[^\x09\x0A\x0D\x20-\x7E]/g, '');
  }

  function escapePdfText(value) {
    return normalizePdfText(value).replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)');
  }

  function estimatePdfTextWidth(value, fontSize) {
    return normalizePdfText(value).split('').reduce(function (width, char) {
      if (char === ' ') return width + (fontSize * 0.28);
      if ('ilI.,;:!|'.indexOf(char) !== -1) return width + (fontSize * 0.24);
      if ('mwMW@#%&'.indexOf(char) !== -1) return width + (fontSize * 0.72);
      return width + (fontSize * 0.52);
    }, 0);
  }

  function splitPdfText(value, fontSize, maxWidth, maxLines) {
    const words = normalizePdfText(value).split(/\s+/).filter(Boolean);
    const lines = [];
    let current = '';

    words.forEach(function (word) {
      const next = current ? current + ' ' + word : word;
      if (estimatePdfTextWidth(next, fontSize) <= maxWidth || !current) {
        current = next;
      } else {
        lines.push(current);
        current = word;
      }
    });

    if (current) lines.push(current);
    return lines.slice(0, maxLines || lines.length);
  }

  function normalizePdfColor(color) {
    return Object.assign({}, color, {
      hexCode: color.hexCode || color.hex || color.colorHex || '',
      name: color.name || color.colorName || ''
    });
  }

  function getPdfColorCategory(color) {
    return String(
      color.category ||
      color.categoryName ||
      color.colorCategory ||
      color.group ||
      color.family ||
      'Custom Colors'
    ).trim() || 'Custom Colors';
  }

  function buildPalettePrintGroups(palette) {
    const groups = {};
    const groupOrder = [];

    (palette.colors || []).forEach(function (item) {
      const color = normalizePdfColor(item.color || {});
      const category = getPdfColorCategory(color);

      if (!groups[category]) {
        groups[category] = [];
        groupOrder.push(category);
      }

      groups[category].push(color);
    });

    return groupOrder.map(function (category) {
      return { category: category, colors: groups[category] };
    });
  }

  function hexToRgb(hex) {
    const normalized = normalizePrintHex(hex).replace('#', '');
    const value = normalized.length === 3
      ? normalized.split('').map(function (char) { return char + char; }).join('')
      : normalized;
    const red = parseInt(value.slice(0, 2), 16);
    const green = parseInt(value.slice(2, 4), 16);
    const blue = parseInt(value.slice(4, 6), 16);

    return {
      r: Number.isNaN(red) ? 255 : red,
      g: Number.isNaN(green) ? 255 : green,
      b: Number.isNaN(blue) ? 255 : blue
    };
  }

  function pdfFileName(name) {
    const slug = String(name || 'palette')
      .trim()
      .replace(/[^a-z0-9]+/gi, '-')
      .replace(/^-+|-+$/g, '')
      .toLowerCase();

    return (slug || 'palette') + '.pdf';
  }

  function pdfBinaryBytes(binary) {
    const bytes = new Uint8Array(binary.length);
    for (let index = 0; index < binary.length; index += 1) {
      bytes[index] = binary.charCodeAt(index) & 255;
    }
    return bytes;
  }

  function createPdfBlob(pageStreams, logoData) {
    const encoder = new TextEncoder();
    const pageCount = pageStreams.length;
    const logoObjectId = logoData ? 6 : null;
    const firstPageObjectId = logoData ? 7 : 6;
    const objects = [];

    function addObject(id, content) {
      objects[id] = typeof content === 'string' ? encoder.encode(content) : content;
    }

    addObject(1, '<< /Type /Catalog /Pages 2 0 R >>');
    addObject(2, '<< /Type /Pages /Kids [' + pageStreams.map(function (_, index) {
      return (firstPageObjectId + (index * 2)) + ' 0 R';
    }).join(' ') + '] /Count ' + pageCount + ' >>');
    addObject(3, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
    addObject(4, '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>');
    addObject(5, '<< /Type /Font /Subtype /Type1 /BaseFont /Times-Roman >>');

    if (logoData) {
      const imageBytes = pdfBinaryBytes(logoData.data);
      const header = encoder.encode('<< /Type /XObject /Subtype /Image /Width ' + logoData.width + ' /Height ' + logoData.height + ' /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ' + imageBytes.length + ' >>\nstream\n');
      const footer = encoder.encode('\nendstream');
      const imageObject = new Uint8Array(header.length + imageBytes.length + footer.length);
      imageObject.set(header, 0);
      imageObject.set(imageBytes, header.length);
      imageObject.set(footer, header.length + imageBytes.length);
      addObject(logoObjectId, imageObject);
    }

    pageStreams.forEach(function (stream, index) {
      const pageId = firstPageObjectId + (index * 2);
      const contentId = pageId + 1;
      const resourceParts = ['/Font << /F1 3 0 R /F2 4 0 R /F3 5 0 R >>'];
      if (logoObjectId) resourceParts.push('/XObject << /Logo ' + logoObjectId + ' 0 R >>');

      addObject(pageId, '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << ' + resourceParts.join(' ') + ' >> /Contents ' + contentId + ' 0 R >>');

      const streamBytes = encoder.encode(stream);
      addObject(contentId, '<< /Length ' + streamBytes.length + ' >>\nstream\n' + stream + '\nendstream');
    });

    const parts = [];
    const offsets = [0];
    let length = 0;

    function pushPart(part) {
      const bytes = typeof part === 'string' ? encoder.encode(part) : part;
      parts.push(bytes);
      length += bytes.length;
    }

    pushPart('%PDF-1.4\n%\xE2\xE3\xCF\xD3\n');

    for (let id = 1; id < objects.length; id += 1) {
      if (!objects[id]) continue;
      offsets[id] = length;
      pushPart(id + ' 0 obj\n');
      pushPart(objects[id]);
      pushPart('\nendobj\n');
    }

    const xrefOffset = length;
    pushPart('xref\n0 ' + objects.length + '\n');
    pushPart('0000000000 65535 f \n');

    for (let id = 1; id < objects.length; id += 1) {
      pushPart(String(offsets[id] || 0).padStart(10, '0') + ' 00000 n \n');
    }

    pushPart('trailer\n<< /Size ' + objects.length + ' /Root 1 0 R >>\nstartxref\n' + xrefOffset + '\n%%EOF');

    return new Blob(parts, { type: 'application/pdf' });
  }

  function downloadBlob(blob, fileName) {
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

  async function createPalettePdf(palette) {
    const groups = buildPalettePrintGroups(palette).filter(function (group) {
      return group.colors.length > 0;
    });

    if (!groups.length) {
      alert('No colors were found for this palette.');
      return;
    }

    const logoData = await loadPdfLogoData();
    const pageStreams = [];
    const pageWidth = 612;
    const pageHeight = 792;
    const margin = 36;
    const contentWidth = pageWidth - (margin * 2);
    const bottomLimit = pageHeight - margin;
    const columns = 6;
    const gapX = 5;
    const gapY = 8;
    const swatchSize = (contentWidth - (gapX * (columns - 1))) / columns;
    const labelGap = 14;
    const labelLineHeight = 11;
    const rowHeight = swatchSize + labelGap + (labelLineHeight * 2) + gapY;
    const categoryTopPadding = 22;
    const logoWidth = 52;
    const logoHeight = logoData ? Math.round(logoWidth * (logoData.height / logoData.width)) : 0;
    let commands = '';
    let y = margin;
    let pageStarted = false;

    function pdfY(topY) {
      return pageHeight - topY;
    }

    function append(command) {
      commands += command + '\n';
    }

    function drawText(text, x, topY, fontSize, fontName, align, rgb) {
      const safeText = escapePdfText(text);
      const width = estimatePdfTextWidth(text, fontSize);
      const textX = align === 'center' ? x - (width / 2) : x;
      const color = rgb || [0, 0, 0];
      append('BT ' + (color[0] / 255).toFixed(3) + ' ' + (color[1] / 255).toFixed(3) + ' ' + (color[2] / 255).toFixed(3) + ' rg /' + fontName + ' ' + fontSize + ' Tf ' + textX.toFixed(2) + ' ' + pdfY(topY).toFixed(2) + ' Td (' + safeText + ') Tj ET');
    }

    function startPage(includeTitle) {
      if (pageStarted) pageStreams.push(commands);
      commands = '';
      pageStarted = true;
      y = margin;

      if (logoData) {
        const logoX = (pageWidth - logoWidth) / 2;
        append('q ' + logoWidth.toFixed(2) + ' 0 0 ' + logoHeight.toFixed(2) + ' ' + logoX.toFixed(2) + ' ' + (pageHeight - y - logoHeight).toFixed(2) + ' cm /Logo Do Q');
        y += logoHeight + 20;
      }

      if (includeTitle) {
        drawText(palette.name || 'Color Palette', pageWidth / 2, y + 24, 34, 'F3', 'center', [0, 0, 0]);
        y += 58;
      }
    }

    function roundedRectPath(x, topY, width, height, radius) {
      const left = x;
      const right = x + width;
      const top = pdfY(topY);
      const bottom = pdfY(topY + height);
      const curve = radius * 0.5522847498;

      return [
        (left + radius).toFixed(2) + ' ' + top.toFixed(2) + ' m',
        (right - radius).toFixed(2) + ' ' + top.toFixed(2) + ' l',
        (right - radius + curve).toFixed(2) + ' ' + top.toFixed(2) + ' ' + right.toFixed(2) + ' ' + (top - radius + curve).toFixed(2) + ' ' + right.toFixed(2) + ' ' + (top - radius).toFixed(2) + ' c',
        right.toFixed(2) + ' ' + (bottom + radius).toFixed(2) + ' l',
        right.toFixed(2) + ' ' + (bottom + radius - curve).toFixed(2) + ' ' + (right - radius + curve).toFixed(2) + ' ' + bottom.toFixed(2) + ' ' + (right - radius).toFixed(2) + ' ' + bottom.toFixed(2) + ' c',
        (left + radius).toFixed(2) + ' ' + bottom.toFixed(2) + ' l',
        (left + radius - curve).toFixed(2) + ' ' + bottom.toFixed(2) + ' ' + left.toFixed(2) + ' ' + (bottom + radius - curve).toFixed(2) + ' ' + left.toFixed(2) + ' ' + (bottom + radius).toFixed(2) + ' c',
        left.toFixed(2) + ' ' + (top - radius).toFixed(2) + ' l',
        left.toFixed(2) + ' ' + (top - radius + curve).toFixed(2) + ' ' + (left + radius - curve).toFixed(2) + ' ' + top.toFixed(2) + ' ' + (left + radius).toFixed(2) + ' ' + top.toFixed(2) + ' c',
        'h'
      ].join(' ');
    }

    function drawCategoryHeader(category) {
      y += categoryTopPadding;

      if (y + 18 + rowHeight > bottomLimit) {
        startPage(false);
        y += categoryTopPadding;
      }

      drawText(String(category || '').toUpperCase(), margin, y, 14, 'F2', 'left', [34, 43, 50]);
      y += 18;
    }

    function drawColor(color, column, rowY) {
      const x = margin + (column * (swatchSize + gapX));
      const rgb = hexToRgb(color.hexCode);

      append('0.945 0.945 0.945 rg ' + roundedRectPath(x + 2, rowY + 3, swatchSize, swatchSize, 7) + ' f');
      append((rgb.r / 255).toFixed(3) + ' ' + (rgb.g / 255).toFixed(3) + ' ' + (rgb.b / 255).toFixed(3) + ' rg ' + roundedRectPath(x, rowY, swatchSize, swatchSize, 7) + ' f');

      splitPdfText(color.name || '', 10, swatchSize, 2).forEach(function (line, index) {
        drawText(line, x + (swatchSize / 2), rowY + swatchSize + labelGap + (index * labelLineHeight), 10, 'F1', 'center', [0, 0, 0]);
      });
    }

    startPage(true);

    groups.forEach(function (group) {
      const colors = group.colors.map(normalizePdfColor);
      let colorIndex = 0;
      let needsHeader = true;

      while (colorIndex < colors.length) {
        if (needsHeader) {
          drawCategoryHeader(group.category);
          needsHeader = false;
        }

        if (y + rowHeight > bottomLimit) {
          startPage(false);
          drawCategoryHeader(group.category);
        }

        colors.slice(colorIndex, colorIndex + columns).forEach(function (color, column) {
          drawColor(color, column, y);
        });

        y += rowHeight;
        colorIndex += columns;
      }
    });

    pageStreams.push(commands);
    downloadBlob(createPdfBlob(pageStreams, logoData), pdfFileName(palette.name));
  }

  async function createYcsPalettePdf(paletteCode, paletteTitle) {
    const response = await fetch('/apps/palette-data?palette=' + encodeURIComponent(paletteCode), {
      credentials: 'same-origin'
    });
    const json = await response.json();

    if (!response.ok || !json.colors) {
      throw new Error(json.error || 'Unable to load palette colors.');
    }

    await createPalettePdf({
      name: paletteTitle || json.paletteName || paletteCode,
      colors: json.colors.map(function (color) {
        return { color: normalizePdfColor(color) };
      })
    });
  }

  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-ycs-pdf-palette-code]');
    if (!button) return;

    button.disabled = true;
    createYcsPalettePdf(
      button.dataset.ycsPdfPaletteCode,
      button.dataset.ycsPdfPaletteTitle
    ).catch(function (error) {
      alert(error.message || 'Unable to create PDF.');
    }).finally(function () {
      button.disabled = false;
    });
  });
})();

(function () {
  const previewSelect = document.getElementById('ycs-admin-view-as');
  const lastAnalysisClientStorageKey = 'ycs:last-color-analysis-client:{{ customer.id | default: "default" }}';

  function getLastAnalysisClientId() {
    try {
      return String(window.localStorage.getItem(lastAnalysisClientStorageKey) || '').trim();
    } catch (error) {
      return '';
    }
  }

  document.addEventListener('click', function (event) {
    const openToolLink = event.target.closest('[data-ycs-open-color-analysis-tool="true"]');
    if (!openToolLink) return;

    const lastClientId = getLastAnalysisClientId();
    if (!lastClientId) return;

    event.preventDefault();

    const nextUrl = new URL('/pages/color-analysis-tool', window.location.origin);
    nextUrl.searchParams.set('clientRecordId', lastClientId);
    nextUrl.searchParams.set('mode', 'trade');

    const fallbackUrl = new URL(openToolLink.getAttribute('href'), window.location.origin);
    if (fallbackUrl.searchParams.get('returnUrl')) {
      nextUrl.searchParams.set('returnUrl', fallbackUrl.searchParams.get('returnUrl'));
    }

    if (previewSelect && previewSelect.value) {
      nextUrl.searchParams.set('viewAs', previewSelect.value);
    }

    window.location.href = nextUrl.pathname + nextUrl.search;
  });

  if (previewSelect) {
    const currentPreviewRole = previewSelect.value;

    function preserveAdminPreviewRole(anchor) {
      if (!currentPreviewRole || !anchor || !anchor.getAttribute('href')) return;
      const href = anchor.getAttribute('href');
      if (
        !href.includes('/pages/photo-prep') &&
        !href.includes('/pages/color-analysis-tool') &&
        !href.includes('/pages/signature-color-analysis')
      ) {
        return;
      }

      const nextUrl = new URL(href, window.location.origin);
      nextUrl.searchParams.set('viewAs', currentPreviewRole);
      anchor.setAttribute('href', nextUrl.pathname + nextUrl.search);
    }

    document.querySelectorAll('a[href]').forEach(preserveAdminPreviewRole);

    previewSelect.addEventListener('change', function () {
      const nextUrl = new URL(window.location.href);
      if (previewSelect.value) {
        nextUrl.searchParams.set('viewAs', previewSelect.value);
      } else {
        nextUrl.searchParams.delete('viewAs');
      }
      window.location.href = nextUrl.pathname + nextUrl.search;
    });
  }

  const overlay = document.getElementById('ycs-tools-tos-overlay');
  const checkbox = document.getElementById('ycs-tools-tos-checkbox');
  const continueBtn = document.getElementById('ycs-tools-tos-continue');

  if (!overlay || !checkbox || !continueBtn) return;
// Change this to reset TOS for users
// Run localStorage.removeItem('ycs_tools_tos_accepted_v1');
// localStorage.removeItem('ycs_tools_tos_accepted_my_palettes_v1');
// in console to clear browser
  const storageKey = 'ycs_tools_tos_accepted_my_palettes_v1';
  const hasAcceptedTerms = localStorage.getItem(storageKey);

  if (!hasAcceptedTerms) {
    overlay.style.display = 'flex';
  }

  continueBtn.addEventListener('click', function () {
    if (!checkbox.checked) {
      alert('Please agree to the Terms to continue.');
      return;
    }

    localStorage.setItem(storageKey, new Date().toISOString());
    overlay.style.display = 'none';
  });
})();
</script>
{% endif %}

