  display: none;
}

.ycs-custom-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
}

.ycs-custom-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(36, 30, 28, .35);
}

.ycs-custom-modal__dialog {
  position: relative;
  width: min(760px, 100%);
  max-height: min(86vh, 760px);
  overflow: auto;
  background: #fff;
  border-radius: 16px;
  border: 1px solid #ead7dc;
  box-shadow: 0 24px 70px rgba(0,0,0,.18);
