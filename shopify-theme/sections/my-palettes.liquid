<div class="ycs-my-palettes">
  <div class="ycs-palette-topnav">
    <a href="/account" class="palette-back-link">← My Account</a>
  </div>

  {% assign palette_access_string = '' %}

  {% if customer %}
    {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% endif %}

  {% capture ycs_header_content %}{{ content_for_header }}{% endcapture %}
  {% assign ycs_page_url = ycs_header_content
    | split: '"pageurl":"'
    | last
    | split: '"'
    | first
    | replace: '\/', '/'
    | replace: '\\u0026', '&'
    | replace: '%26', '&'
    | replace: '%3F', '?'
    | replace: '%3D', '='
    | append: '&'
  %}

  {% assign is_catools_view = false %}
  {% if ycs_page_url contains 'view=catools&'
    or ycs_header_content contains 'view=catools'
    or ycs_header_content contains 'view%3Dcatools'
    or ycs_header_content contains 'view\\u003dcatools'
  %}
    {% assign is_catools_view = true %}
  {% endif %}

  {% assign is_admin = false %}
  {% if customer and palette_access_string contains ',YCS_ADMIN,' %}
    {% assign is_admin = true %}
  {% endif %}
  {% assign actual_is_admin = is_admin %}

  {% assign is_trade_july_cohort = false %}
  {% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
  {% assign current_timestamp = 'now' | date: '%s' %}
  {% if customer and palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
    {% assign is_trade_july_cohort = true %}
  {% endif %}

  {% assign is_trade = false %}
  {% if customer and palette_access_string contains ',TRADE,' %}
    {% assign is_trade = true %}
  {% endif %}
  {% if is_trade_july_cohort %}
    {% assign is_trade = true %}
  {% endif %}

  {% assign is_catool = false %}
  {% if customer and palette_access_string contains ',CATOOL,' %}
    {% assign is_catool = true %}
  {% endif %}

  {% assign is_catool_growth = false %}
  {% if customer and palette_access_string contains ',CATOOLGROWTH,' %}
    {% assign is_catool_growth = true %}
  {% endif %}

  {% assign is_catool_free = false %}
  {% if customer and palette_access_string contains ',CATOOLFREE,' %}
    {% assign is_catool_free = true %}
  {% endif %}

  {% assign is_free_diy_catool = false %}
  {% if customer and palette_access_string contains ',FREEDIYCATOOL,' %}
    {% assign is_free_diy_catool = true %}
  {% endif %}

  {% assign is_diy_catool = false %}
  {% if customer and palette_access_string contains ',DIYCATOOL,' %}
    {% assign is_diy_catool = true %}
  {% endif %}

  {% assign admin_view_as = '' %}
  {% if actual_is_admin %}
    {% if ycs_page_url contains 'viewAs=trade&' %}
      {% assign admin_view_as = 'trade' %}
    {% elsif ycs_page_url contains 'viewAs=catoolgrowth&' %}
      {% assign admin_view_as = 'catoolgrowth' %}
    {% elsif ycs_page_url contains 'viewAs=catoolfree&' %}
      {% assign admin_view_as = 'catoolfree' %}
    {% elsif ycs_page_url contains 'viewAs=freediycatool&' %}
      {% assign admin_view_as = 'freediycatool' %}
    {% elsif ycs_page_url contains 'viewAs=diycatool&' %}
      {% assign admin_view_as = 'diycatool' %}
    {% elsif ycs_page_url contains 'viewAs=catool&' %}
      {% assign admin_view_as = 'catool' %}
    {% endif %}
  {% endif %}

  {% if admin_view_as != '' %}
    {% assign is_admin = false %}
    {% assign is_trade = false %}
    {% assign is_catool = false %}
    {% assign is_catool_growth = false %}
    {% assign is_catool_free = false %}
    {% assign is_free_diy_catool = false %}
    {% assign is_diy_catool = false %}

    {% if admin_view_as == 'trade' %}
      {% assign is_trade = true %}
    {% elsif admin_view_as == 'catoolgrowth' %}
      {% assign is_catool_growth = true %}
    {% elsif admin_view_as == 'catoolfree' %}
      {% assign is_catool_free = true %}
    {% elsif admin_view_as == 'freediycatool' %}
      {% assign is_free_diy_catool = true %}
    {% elsif admin_view_as == 'diycatool' %}
      {% assign is_diy_catool = true %}
    {% elsif admin_view_as == 'catool' %}
      {% assign is_catool = true %}
    {% endif %}
  {% endif %}

  {% assign can_use_analysis_tool = false %}
  {% if is_admin or is_trade or is_catool or is_catool_growth or is_catool_free or is_diy_catool or is_free_diy_catool %}
    {% assign can_use_analysis_tool = true %}
  {% endif %}

  {% assign can_manage_clients = false %}
  {% if is_admin or is_trade or is_catool or is_catool_growth %}
    {% assign can_manage_clients = true %}
  {% endif %}
  {% if customer and palette_access_string contains 'YCS_ADMIN' %}
    {% assign can_manage_clients = true %}
  {% endif %}
  {% if customer and palette_access_string contains 'CATOOLGROWTH' %}
    {% assign can_manage_clients = true %}
  {% endif %}
  {% if customer and palette_access_string contains 'CATOOL' %}
    {% unless palette_access_string contains 'DIYCATOOL' or palette_access_string contains 'FREEDIYCATOOL' or palette_access_string contains 'CATOOLFREE' %}
      {% assign can_manage_clients = true %}
    {% endunless %}
  {% endif %}
  {% if customer and palette_access_string contains 'TRADE' %}
    {% assign can_manage_clients = true %}
  {% endif %}
  {% if is_trade_july_cohort %}
    {% assign can_manage_clients = true %}
  {% endif %}

  {% assign show_clients_card = false %}
  {% if is_catools_view %}
    {% if can_use_analysis_tool %}
      {% assign show_clients_card = true %}
    {% endif %}
    {% if is_diy_catool or is_free_diy_catool or is_catool_free %}
      {% assign show_clients_card = false %}
    {% endif %}
  {% endif %}

  {% assign has_all_palette_access = false %}
  {% if is_admin or is_trade or is_catool or is_catool_growth %}
    {% assign has_all_palette_access = true %}
  {% endif %}

  {% assign can_access_all_printable_pdfs = false %}
  {% if is_admin or is_trade or palette_access_string contains ',VIP,' %}
    {% assign can_access_all_printable_pdfs = true %}
  {% endif %}

  {% assign has_style_masters_access = false %}
  {% if customer and palette_access_string contains ',VIP,' %}
    {% assign has_style_masters_access = true %}
  {% endif %}
  {% if customer and palette_access_string contains ',STYLEMASTERS,' %}
    {% assign has_style_masters_access = true %}
  {% endif %}
  {% if customer and palette_access_string contains ',STYLE MASTERS,' %}
    {% assign has_style_masters_access = true %}
  {% endif %}
  {% if customer and palette_access_string contains ',STYLEMASTERS_' %}
    {% assign has_style_masters_access = true %}
  {% endif %}

  {% assign has_draping_studio_starter = false %}
{% if palette_access_string contains ',DRAPINGSTUDIOSTARTER,' %}
  {% assign has_draping_studio_starter = true %}
{% endif %}

{% assign has_draping_studio = false %}
{% if palette_access_string contains ',DRAPINGSTUDIO,' %}
  {% assign has_draping_studio = true %}
{% endif %}

{% assign has_draping_studio_access = false %}
{% if has_draping_studio_starter or has_draping_studio %}
  {% assign has_draping_studio_access = true %}
{% endif %}

{% assign is_sample_user = false %}
{% if has_draping_studio_access == false and palette_access_string contains ',SAMPLE,' %}
  {% assign is_sample_user = true %}
{% endif %}

  {% if customer == nil %}
    <div class="ycs-my-palettes__header">
      <p class="ycs-my-palettes__kicker">Your Color Style</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="ycs-my-palettes__intro">Please sign in to view your palettes.</p>
      <div class="ycs-my-palettes__signin">
        <a href="{{ routes.account_login_url }}" class="ycs-my-palettes__signin-button">Sign In</a>
      </div>
    </div>

  {% else %}
    <div id="ycs-tools-tos-overlay" class="ycs-tools-tos-overlay">
  <div class="ycs-tools-tos-modal">
    <h2>Before you continue</h2>

    <p>
      By using Photo Prep, the Photo Draping Studio, and the Color Analysis Tool, you agree to our
      <a href="/pages/terms-of-service" target="_blank">Terms of Service</a>.
    </p>

    <label class="ycs-tools-tos-check">
      <input type="checkbox" id="ycs-tools-tos-checkbox">
      I agree to the Terms
    </label>

    <button type="button" id="ycs-tools-tos-continue" class="ycs-palette-card__button">
      Continue
    </button>
  </div>
</div>

    <div class="ycs-my-palettes__header">
      <p class="ycs-my-palettes__kicker">Your Color Style</p>
      <h1>{% if is_catools_view %}Color Analysis Tools{% else %}My Color Palettes{% endif %}</h1>
      <p class="ycs-my-palettes__intro">{% if is_catools_view %}Open your color analysis tools and client workflow.{% else %}Open your digital color fans below.{% endif %}</p>
      {% if is_catools_view %}
        <p style="font-size:12px;color:#9b8f86;margin-top:8px;">CATools build 20260727-verify</p>
      {% endif %}
    </div>

    {% if actual_is_admin and is_catools_view %}
      <div class="ycs-admin-preview">
        <div>
          <p class="ycs-admin-preview__kicker">Admin testing</p>
          <p class="ycs-admin-preview__copy">
            View the Color Analysis flow as another user type. Your real account stays admin.
          </p>
        </div>
        <label class="ycs-admin-preview__control">
          <span>View as</span>
          <select id="ycs-admin-view-as">
            <option value="" {% if admin_view_as == '' %}selected{% endif %}>Admin</option>
            <option value="trade" {% if admin_view_as == 'trade' %}selected{% endif %}>Trade</option>
            <option value="catool" {% if admin_view_as == 'catool' %}selected{% endif %}>CATOOL</option>
            <option value="catoolgrowth" {% if admin_view_as == 'catoolgrowth' %}selected{% endif %}>CATOOL Growth</option>
            <option value="catoolfree" {% if admin_view_as == 'catoolfree' %}selected{% endif %}>CATOOL Free Trial</option>
            <option value="diycatool" {% if admin_view_as == 'diycatool' %}selected{% endif %}>DIY CATOOL</option>
            <option value="freediycatool" {% if admin_view_as == 'freediycatool' %}selected{% endif %}>Free DIY CATOOL</option>
          </select>
        </label>
      </div>
    {% endif %}

    <div class="ycs-my-palettes__section ycs-my-palettes__section--studio">
      <h2 class="ycs-my-palettes__section-title">Tools</h2>
      <div class="ycs-my-palettes__grid ycs-my-palettes__grid--2">

        {% if is_catools_view and can_use_analysis_tool %}
          <div class="ycs-palette-card ycs-palette-card--admin">
            <div class="ycs-palette-card__top">
              <div
                class="ycs-palette-card__gradient"
                style="background: linear-gradient(to right, #7a5cff, #5fb6ff, #9be7c4);">
              </div>
            </div>

            <div class="ycs-palette-card__content">
              <div class="ycs-palette-card__text">
                <h2>Color Analysis Tool</h2>
                <p class="ycs-palette-card__subtitle">
                  {% if is_diy_catool %}
                    Upload your own photo and use the DIY Color Analysis Tool.
                  {% elsif is_free_diy_catool %}
                    Try the DIY Color Analysis Tool with three preloaded photos.
                  {% elsif is_catool_free %}
                    Try the Color Analysis Tool with three preloaded clients.
                  {% else %}
                  Create client records, prep photos, save analyses, and return to client work anytime.
                  {% endif %}
                </p>
                <p class="ycs-palette-card__admin-label">
                  {% if is_admin %}
  Admin access • Unlimited uploads
{% elsif is_trade %}
  Trade Professional • 15 uploads/month
{% elsif is_catool_growth %}
  Growth Plan • 15 uploads/month • Full client management
{% elsif is_catool %}
  Starter Plan • 5 uploads/month • Client management
{% elsif is_diy_catool %}
  DIY Color Analysis Tool • Self analysis
{% elsif is_free_diy_catool %}
  Free DIY Demo • 3 preloaded photos
{% elsif is_catool_free %}
  Free Trial • 3 preloaded clients
{% endif %}
                </p>
              </div>

              <div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">
                <a href="{% if is_diy_catool or is_free_diy_catool %}/pages/photo-prep?mode=diy&workflow=color-analysis{% elsif is_catool_free %}/pages/photo-prep?mode=trade&workflow=color-analysis&trial=catoolfree{% else %}/pages/photo-prep?mode=trade&workflow=color-analysis{% endif %}" class="ycs-palette-card__button">
                  Open Tool
                </a>
              </div>
            </div>
          </div>

          {% unless is_diy_catool or is_free_diy_catool or is_catool_free %}
            <div class="ycs-palette-card ycs-palette-card--admin">
              <div class="ycs-palette-card__top">
                <div
                  class="ycs-palette-card__gradient"
                  style="background: linear-gradient(to right, #2f2a25, #d94c6a, #f2b880);">
                </div>
              </div>

              <div class="ycs-palette-card__content">
                <div class="ycs-palette-card__text">
                  <h2>My Clients</h2>
                  <p class="ycs-palette-card__subtitle">
                    View and manage your color analysis clients.
                  </p>
                  <p class="ycs-palette-card__admin-label">
                    {% if is_admin %}
                      Admin client management
                    {% elsif is_trade %}
                      Trade client management
                    {% elsif is_catool_growth %}
                      Growth Plan • Full client management
                    {% elsif is_catool %}
                      Starter Plan • Client management
                    {% else %}
                      Client management
                    {% endif %}
                  </p>
                </div>

                <div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">
                  <a href="/pages/my-clients{% if admin_view_as != '' %}?viewAs={{ admin_view_as }}{% endif %}" class="ycs-palette-card__button">
                    View My Clients
                  </a>
                </div>
              </div>
            </div>
          {% endunless %}
        {% endif %}

        {% if false and show_clients_card %}
          <div class="ycs-palette-card ycs-palette-card--admin">
            <div class="ycs-palette-card__top">
              <div
                class="ycs-palette-card__gradient"
                style="background: linear-gradient(to right, #2f2a25, #d94c6a, #f2b880);">
              </div>
            </div>

            <div class="ycs-palette-card__content">
              <div class="ycs-palette-card__text">
                <h2>My Clients</h2>
                <p class="ycs-palette-card__subtitle">
                  View and manage your color analysis clients.
                </p>
                <p class="ycs-palette-card__admin-label">
                  {% if is_admin %}
                    Admin client management
                  {% elsif is_trade %}
                    Trade client management
                  {% elsif is_catool_growth %}
                    Growth Plan • Full client management
                  {% elsif is_catool %}
                    Starter Plan • Client management
                  {% endif %}
                </p>
              </div>

              <div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">
                <a href="/pages/my-clients{% if admin_view_as != '' %}?viewAs={{ admin_view_as }}{% endif %}" class="ycs-palette-card__button">
                  View My Clients
                </a>
              </div>
            </div>
          </div>
        {% endif %}

        {% if false %}
          <div class="ycs-palette-card ycs-palette-card--admin">
            <div class="ycs-palette-card__top">
              <div
                class="ycs-palette-card__gradient"
                style="background: linear-gradient(to right, #2f2a25, #b7835f, #f2d6b3);">
              </div>
            </div>

            <div class="ycs-palette-card__content">
              <div class="ycs-palette-card__text">
                <h2>Training Curriculum</h2>
                <p class="ycs-palette-card__subtitle">
                  Open your color analysis training curriculum.
                </p>
                <p class="ycs-palette-card__admin-label">
                  Trade Professional
                </p>
              </div>

              <div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">
                <a href="https://color-analysis-training.teachery.co/login" class="ycs-palette-card__button" target="_blank" rel="noopener">
                  Open Training
                </a>
              </div>
            </div>
          </div>
        {% endif %}

        {% unless is_catools_view %}
        <div class="ycs-palette-card ycs-palette-card--studio">
          <div class="ycs-palette-card__top">
            <div
              class="ycs-palette-card__gradient ycs-palette-card__gradient--studio"
              style="background: linear-gradient(to right, #d94c6a, #f2b880, #d9d7f1);">
            </div>
          </div>

          <div class="ycs-palette-card__content">
            <div class="ycs-palette-card__text">
              <h2>Photo Draping Studio</h2>
              <p class="ycs-palette-card__subtitle">
                Upload your photo and see your colors on you.
              </p>

              {% if palette_access_string contains ',VIP,' or is_admin %}
                <p class="ycs-palette-card__studio-note ycs-palette-card__studio-note--open">
                  Included with your membership
                </p>
              {% elsif has_draping_studio_starter %}
  <p class="ycs-palette-card__studio-note ycs-palette-card__studio-note--open">
    Starter unlocked • 2 photo uploads
  </p>
{% elsif has_draping_studio %}
  <p class="ycs-palette-card__studio-note ycs-palette-card__studio-note--open">
    Studio unlocked • 5 photo uploads
  </p>
              {% elsif is_sample_user %}
                <p class="ycs-palette-card__studio-note ycs-palette-card__studio-note--open">
                  Your Free Trial • 1 photo upload • Sample colors
                </p>
              {% else %}
                <p class="ycs-palette-card__studio-note">
                  Try it free • 1 photo upload • Sample colors
                </p>
              {% endif %}
            </div>

            <div class="ycs-palette-card__actions ycs-palette-card__actions--stacked">
              <a href="{% if palette_access_string contains ',VIP,' or is_admin or has_draping_studio_access or is_sample_user %}/pages/photo-prep?mode=personal&workflow=photo-draping{% else %}/pages/photo-prep?mode=personal&workflow=photo-draping&trial=sample{% endif %}" class="ycs-palette-card__button">
                {% if palette_access_string contains ',VIP,' or is_admin %}
                  Open Studio
                {% elsif has_draping_studio_access %}
  Open Studio
                {% elsif is_sample_user %}
                  Try Studio
                {% else %}
                  Try Studio Free
                {% endif %}
              </a>
            </div>
          </div>
          
        </div>
        {% endunless %}

      </div>
    </div>

    {% assign show_custom_palette_section = false %}
    {% assign custom_palette_read_only = false %}
    {% if is_catool_growth and is_catools_view %}
      {% assign show_custom_palette_section = true %}
    {% endif %}
    {% if has_style_masters_access %}
      {% unless is_catools_view %}
        {% assign show_custom_palette_section = true %}
        {% assign custom_palette_read_only = true %}
      {% endunless %}
    {% endif %}

    {% if show_custom_palette_section %}
      <div
        class="ycs-my-palettes__section ycs-custom-palettes"
        id="ycs-custom-palettes"
        data-customer-id="{{ customer.id }}"
        data-preview-customer-id="{{ customer.id }}"
        data-view-as="{{ admin_view_as }}"
        data-read-only="{% if custom_palette_read_only %}true{% else %}false{% endif %}"
        data-app-base-url="https://ycs-palette-app.vercel.app"
      >
        <div class="ycs-custom-palettes__header">
          <div>
            <h2 class="ycs-my-palettes__section-title">{% if custom_palette_read_only %}Style Masters Color Palettes{% else %}My Custom Palettes{% endif %}</h2>
            <p class="ycs-custom-palettes__intro">{% if custom_palette_read_only %}Open your shared Style Masters custom color palettes.{% else %}Create and organize palettes using colors from your private custom color collection.{% endif %}</p>
          </div>
          {% unless custom_palette_read_only %}
            <div class="ycs-custom-palettes__actions">
              <button type="button" class="ycs-palette-card__button" data-ycs-custom-action="create-palette">Create Palette</button>
              <button type="button" class="ycs-palette-card__button ycs-palette-card__button--secondary" data-ycs-custom-action="manage-colors">Manage My Colors</button>
            </div>
          {% endunless %}
        </div>

        <div class="ycs-custom-palettes__status" data-ycs-custom-status hidden></div>
        <div class="ycs-custom-palettes__grid" data-ycs-custom-palettes-list></div>

        <div class="ycs-custom-palettes__empty" data-ycs-custom-empty hidden>
          <p>{% if custom_palette_read_only %}No Style Masters custom palettes are available yet.{% else %}You haven’t created any custom palettes yet. Create a palette using colors from your private color collection.{% endif %}</p>
          {% unless custom_palette_read_only %}
            <button type="button" class="ycs-palette-card__button" data-ycs-custom-action="create-palette">Create Custom Palette</button>
          {% endunless %}
        </div>
      </div>

      <div class="ycs-custom-modal" id="ycs-custom-modal" hidden>
        <div class="ycs-custom-modal__backdrop" data-ycs-custom-close></div>
        <div class="ycs-custom-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="ycs-custom-modal-title">
          <div class="ycs-custom-modal__header">
            <h2 id="ycs-custom-modal-title">My Colors</h2>
            <button type="button" class="ycs-custom-icon-button" data-ycs-custom-close aria-label="Close">×</button>
          </div>
          <div class="ycs-custom-modal__body" data-ycs-custom-modal-body></div>
        </div>
      </div>
    {% endif %}

    {% assign owned_count = 0 %}
    {% assign locked_count = 0 %}
    {% assign admin_count = 0 %}

    {% for block in section.blocks %}
      {% assign palette_code = block.settings.palette_code | upcase | strip %}
      {% assign palette_token = ',' | append: palette_code | append: ',' %}
      {% assign visibility = block.settings.visibility | default: 'customer' %}

      {% if visibility == 'admin' %}
        {% if is_admin %}
          {% assign admin_count = admin_count | plus: 1 %}
        {% endif %}
        {% continue %}
      {% endif %}

      {% assign user_owns_palette = false %}

      {% if palette_code == 'SAMPLE' %}
        {% if is_sample_user %}
          {% assign user_owns_palette = true %}
        {% endif %}
      {% else %}
        {% if is_catools_view %}
          {% if has_all_palette_access or palette_access_string contains palette_token %}
            {% assign user_owns_palette = true %}
          {% endif %}
        {% else %}
          {% if palette_access_string contains palette_token %}
            {% assign user_owns_palette = true %}
          {% endif %}
        {% endif %}
      {% endif %}

      {% if user_owns_palette %}
        {% assign owned_count = owned_count | plus: 1 %}
      {% else %}
        {% assign locked_count = locked_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if owned_count == 0 and locked_count == 0 and admin_count == 0 %}
      <div class="ycs-my-palettes__empty">
        No palettes have been added to this page yet.
      </div>
    {% endif %}

    {% if false %}
      <div class="ycs-my-palettes__section ycs-my-palettes__section--admin">
        <h2 class="ycs-my-palettes__section-title">Admin Views</h2>

        <div class="ycs-my-palettes__grid ycs-my-palettes__grid--locked">
          <div class="ycs-palette-card ycs-palette-card--admin">
  <div class="ycs-palette-card__top">
    <div
      class="ycs-palette-card__gradient"
      style="background: linear-gradient(to right, #111111, #8b7d6b, #d94c6a);">
    </div>
  </div>

  <div class="ycs-palette-card__content">
    <div class="ycs-palette-card__text">
