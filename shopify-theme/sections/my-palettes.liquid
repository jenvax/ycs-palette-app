}

.ycs-custom-icon-button {
  width: 36px;
  height: 36px;
  border-radius: 999px;
  border: 1px solid #ead7dc;
  background: #fff8fa;
  color: #9f324d;
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
}

.ycs-custom-form,
.ycs-custom-toolbar {
  display: grid;
  gap: 12px;
  margin-bottom: 16px;
}

.ycs-custom-toolbar--add-colors {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
}

.ycs-custom-bulk-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: flex-end;
}

.ycs-custom-select-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 4px;
  color: #332e2a;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.ycs-custom-select-all input {
  width: auto;
  min-height: 0;
}

.ycs-custom-form label,
.ycs-custom-toolbar label {
  display: grid;
  gap: 6px;
  color: #332e2a;
  font-size: 13px;
  font-weight: 700;
}

.ycs-custom-form input,
.ycs-custom-toolbar input {
  width: 100%;
  min-height: 40px;
  border: 1px solid #d8cbd0;
  border-radius: 10px;
  padding: 9px 11px;
