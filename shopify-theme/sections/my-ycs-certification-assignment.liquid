{% assign certification_access = false %}
{% if customer %}
  {% assign certification_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% if certification_tags contains ',YCSMEMBER_CERTIFICATION,' %}
    {% assign certification_access = true %}
  {% endif %}
{% endif %}

<main class="ycs-certification-assignment">
  {% render 'my-ycs-logo' %}

  {% if customer == nil %}
    <h1>{{ page.title | escape }}</h1>
    <p>Please sign in to access this certification assignment.</p>
    <a class="ycs-certification-assignment__button" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">Sign In</a>
  {% elsif certification_access %}
    <a class="ycs-certification-assignment__back" href="/pages/certification-assignments">Back to Certification Assignments</a>
    <article>
      <p class="ycs-certification-assignment__kicker">YCS Certification</p>
      <h1>{{ page.title | escape }}</h1>
      <div class="ycs-certification-assignment__content rte">{{ page.content }}</div>
    </article>
  {% else %}
    {% render 'my-ycs-locked-access', lock_heading: 'Certification Access Required', lock_body: 'This assignment is available to members currently enrolled in the YCS Certification program.', lock_button_label: 'Back to My YCS', lock_button_url: '/pages/my-ycs' %}
  {% endif %}
</main>

{% style %}
  .shopify-section-header,#shopify-section-header,.site-header,.header-wrapper,.header,#shopify-section-footer,.shopify-section--footer,.site-footer,footer{display:none!important}
  body{margin-top:0!important;padding-top:0!important}
  .ycs-certification-assignment{max-width:980px;margin:0 auto;padding:28px 24px 80px;color:#292832;font-family:Poppins,Arial,Tahoma,Verdana,sans-serif}
  .ycs-certification-assignment__back{display:inline-flex;margin:34px 0 30px;color:#6546ce;font-weight:700;text-decoration:none}
  .ycs-certification-assignment__kicker{margin:0 0 10px;color:#6546ce;font-size:13px;font-weight:700;text-transform:uppercase}
  .ycs-certification-assignment h1{margin:0 0 28px;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:44px;font-weight:400;line-height:1.14;letter-spacing:0}
  .ycs-certification-assignment__content{color:#505868;font-size:18px;line-height:1.7}
  .ycs-certification-assignment__content h2,.ycs-certification-assignment__content h3{color:#12253f;font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:0}
  .ycs-certification-assignment__content a{color:#6546ce}
  .ycs-certification-assignment__button{display:inline-flex;margin-top:18px;padding:12px 24px;border-radius:8px;background:#7b5cff;color:#fff!important;font-weight:700;text-decoration:none}
  @media(max-width:700px){.ycs-certification-assignment{padding:22px 16px 60px}.ycs-certification-assignment h1{font-size:34px}.ycs-certification-assignment__content{font-size:17px}}
{% endstyle %}

{% schema %}{"name":"Certification assignment","settings":[],"presets":[{"name":"Certification assignment"}]}{% endschema %}
