{% assign ycs_member_access = false %}
{% if customer %}
  {% assign ycs_member_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% assign ycs_member_access = true %}
{% endif %}

<section class="ycs-member-hub">
  <div class="ycs-member-hub__topnav">
    {% render 'my-ycs-logo' %}
    <a href="{{ routes.account_url }}" class="ycs-member-hub__back">Back to My Account</a>
    <a href="mailto:support@yourcolorstyle.com" class="ycs-member-hub__back">Contact</a>
  </div>

  {% if customer == nil %}
    <header class="ycs-member-hub__header">
      <p class="ycs-member-hub__kicker">Your Color Style</p>
      <h1>My YCS</h1>
      <p>Please sign in to access your membership.</p>
      <a href="{{ routes.account_login_url }}?return_url=%2Fpages%2Fmy-ycs" class="ycs-member-hub__button">Sign In</a>
    </header>
  {% elsif ycs_member_access == false %}
    <header class="ycs-member-hub__header">
      <p class="ycs-member-hub__kicker">Your Color Style</p>
      <h1>My YCS</h1>
      <p>This membership is not available on your account.</p>
    </header>
  {% else %}
    {% assign ycs_member_first_name = customer.first_name | default: customer.name | split: ' ' | first %}
    <header class="ycs-member-hub__header">
      <p class="ycs-member-hub__kicker">Your Color Style</p>
      <h1>Welcome back, {{ ycs_member_first_name | escape }}</h1>
      <p><em>Everything you need to learn, analyze, create, and grow with Your Color Style.</em></p>
    </header>

    <div class="ycs-member-hub__grid">
      <article class="ycs-member-card ycs-member-card--neutral">
        <div class="ycs-member-card__accent ycs-member-card__accent--learn"></div>
        <div class="ycs-member-card__body">
          <h2>Learn</h2>
          <p class="ycs-member-card__subtitle">Build your color analysis skills with the YCS Learning Library.</p>
          <a href="/pages/learn" class="ycs-member-hub__button">Explore Library</a>
        </div>
      </article>

      <article class="ycs-member-card ycs-member-card--professional">
        <div class="ycs-member-card__accent ycs-member-card__accent--analyze"></div>
        <div class="ycs-member-card__body">
          <h2>Tools</h2>
          <p class="ycs-member-card__subtitle">Analyze clients, manage their results, and access your professional tools.</p>
          <a href="/pages/tools" class="ycs-member-hub__button">Open Tools</a>
        </div>
      </article>

      <article class="ycs-member-card ycs-member-card--personal">
        <div class="ycs-member-card__accent ycs-member-card__accent--create"></div>
        <div class="ycs-member-card__body">
          <h2>Palettes</h2>
          <p class="ycs-member-card__subtitle">Explore YCS color palettes or create custom palettes for your clients.</p>
          <a href="/pages/palettes" class="ycs-member-hub__button">Explore Palettes</a>
        </div>
      </article>

      <article class="ycs-member-card ycs-member-card--professional">
        <div class="ycs-member-card__accent ycs-member-card__accent--grow"></div>
        <div class="ycs-member-card__body">
          <h2>Directory</h2>
          <p class="ycs-member-card__subtitle">Get discovered by potential clients with your Color Analyst Directory listing.</p>
          <a href="/pages/directory" class="ycs-member-hub__button" data-directory-button>Submit My Listing</a>
        </div>
      </article>
    </div>
  {% endif %}
</section>

{% if customer and ycs_member_access %}
  <script>
    (function () {
      var button = document.querySelector('[data-directory-button]');
      if (!button) return;

      fetch('/apps/palette-data?action=colorAnalystDirectory', { headers: { Accept: 'application/json' } })
        .then(function (response) {
          if (!response.ok) throw new Error('Unable to load directory listing');
          return response.json();
        })
        .then(function (data) {
          if (data.listing && data.listing.status === 'published') {
            button.textContent = 'Edit My Listing';
          }
        })
        .catch(function () {});
    })();
  </script>
{% endif %}

{% style %}
  .shopify-section-header,
  #shopify-section-header,
  .site-header,
  .header-wrapper,
  .header,
  nav[role="navigation"] {
    display: none !important;
  }

  #shopify-section-footer,
  .shopify-section--footer,
  .site-footer,
  footer.footer,
  footer[role="contentinfo"] {
    display: none !important;
  }

  body {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  .ycs-member-hub {
    --ycs-dashboard-navy: #12253f;
    --ycs-dashboard-ink: #292832;
    --ycs-dashboard-muted: #505868;
    --ycs-dashboard-border: #ece8e3;
    --ycs-dashboard-shadow: 0 18px 45px rgba(32, 28, 45, .08);
    --ycs-dashboard-pro: #7b5cff;
    --ycs-dashboard-pro-hover: #6546ce;
    --ycs-dashboard-personal: #347fa5;
    --ycs-dashboard-personal-hover: #24678b;
    --ycs-dashboard-neutral: #8057c9;
    --ycs-dashboard-neutral-hover: #6546ce;
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 72px;
    color: var(--ycs-dashboard-ink);
  }

  .ycs-member-hub__topnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 42px;
  }

  .ycs-member-hub__back {
    color: #4b4d55;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }

  .ycs-member-hub__back:hover {
    text-decoration: underline;
  }

  .ycs-member-hub__header {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .ycs-member-hub__kicker {
    margin: 0 0 8px;
    color: #bd315b;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .ycs-member-hub__header h1 {
    margin: 0 0 12px;
    color: #292a30;
    font-size: 42px;
    line-height: 1.14;
    letter-spacing: 0;
  }

  .ycs-member-hub__header > p:not(.ycs-member-hub__kicker) {
    margin: 0;
    color: #686a72;
    font-size: 19px;
    line-height: 1.6;
  }

  .ycs-member-hub__header .ycs-member-hub__button {
    margin-top: 22px;
  }

  .ycs-member-hub__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .ycs-member-card {
    overflow: hidden;
    border: 1px solid var(--ycs-dashboard-border);
    border-radius: 24px;
    background: #fff;
    box-shadow: var(--ycs-dashboard-shadow);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .ycs-member-card__accent {
    height: 5px;
  }

  .ycs-member-card__accent--learn {
    background: var(--ycs-dashboard-neutral);
  }

  .ycs-member-card__accent--analyze {
    background: var(--ycs-dashboard-pro);
  }

  .ycs-member-card__accent--create {
    background: var(--ycs-dashboard-personal);
  }

  .ycs-member-card__accent--grow {
    background: var(--ycs-dashboard-pro);
  }

  .ycs-member-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 52px rgba(32, 28, 45, .12);
  }

  .ycs-member-card__body {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
  }

  .ycs-member-card h2 {
    margin: 0 0 10px;
    color: var(--ycs-dashboard-navy);
    font-size: 24px;
    line-height: 1.32;
    letter-spacing: 0;
  }

  .ycs-member-card__subtitle {
    margin: 0 0 28px;
    color: var(--ycs-dashboard-muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .ycs-member-hub__button {
    display: inline-flex;
    min-height: 46px;
    margin-top: auto;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background: var(--ycs-dashboard-pro);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    padding: 12px 24px;
    text-decoration: none;
    transition: background-color 200ms ease, box-shadow 200ms ease, transform 200ms ease;
  }

  .ycs-member-hub__button:hover {
    background: var(--ycs-dashboard-pro-hover);
    color: #fff;
    transform: translateY(-1px);
  }

  .ycs-member-card--personal .ycs-member-hub__button {
    background: var(--ycs-dashboard-personal);
  }

  .ycs-member-card--personal .ycs-member-hub__button:hover {
    background: var(--ycs-dashboard-personal-hover);
  }

  .ycs-member-card--neutral .ycs-member-hub__button {
    background: #f0ebff;
    color: var(--ycs-dashboard-neutral-hover);
  }

  .ycs-member-card--neutral .ycs-member-hub__button:hover {
    background: #e7deff;
    color: var(--ycs-dashboard-neutral-hover);
  }

  .ycs-member-hub__button:focus-visible {
    outline: 3px solid rgba(77, 161, 255, .55);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ycs-member-card,
    .ycs-member-hub__button {
      transition: none;
    }

    .ycs-member-card:hover,
    .ycs-member-hub__button:hover {
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .ycs-member-hub {
      padding: 22px 16px 52px;
    }

    .ycs-member-hub__topnav {
      margin-bottom: 30px;
    }

    .ycs-member-hub__header h1 {
      font-size: 32px;
    }

    .ycs-member-hub__header > p:not(.ycs-member-hub__kicker) {
      font-size: 17px;
    }

    .ycs-member-hub__grid {
      grid-template-columns: 1fr;
    }

    .ycs-member-card__body {
      min-height: 205px;
      padding: 24px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "My YCS",
  "settings": [],
  "presets": [
    {
      "name": "My YCS"
    }
  ]
}
{% endschema %}
