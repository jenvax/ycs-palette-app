{% assign lesson_access = false %}
{% assign lesson_is_free_member = false %}
{% assign lesson_topic_key = '' %}
{% assign lesson_is_diy = false %}
{% if customer %}
  {% assign lesson_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% if lesson_tags contains ',YCSMEMBER,' or lesson_tags contains ',TRADE,' or lesson_tags contains ',YCS_ADMIN,' %}
    {% assign lesson_access = true %}
  {% else %}
    {% assign lesson_is_free_member = true %}
  {% endif %}
{% endif %}

{% assign lesson_diy_menu = linklists['diy-color-analysis'] %}
{% if lesson_diy_menu != blank %}
  {% for diy_lesson_link in lesson_diy_menu.links %}
    {% if diy_lesson_link.url == request.path %}
      {% assign lesson_is_diy = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if lesson_is_diy and lesson_tags contains ',DIYMEMBER,' %}
  {% assign lesson_access = true %}
{% endif %}
{% assign lesson_action_step = '' %}
{% assign lesson_action_label = '' %}
{% if lesson_is_diy %}
  {% assign lesson_title_downcase = page.title | downcase %}
  {% if page.handle contains 'determine-your-depth' or lesson_title_downcase contains 'determine your depth' %}
    {% assign lesson_action_step = 'depth' %}
    {% assign lesson_action_label = 'Determine My Depth' %}
  {% elsif page.handle contains 'analyze-your-undertones' or lesson_title_downcase contains 'analyze your undertones' %}
    {% assign lesson_action_step = 'undertone' %}
    {% assign lesson_action_label = 'Analyze My Undertones' %}
  {% elsif page.handle contains 'define-your-chroma' or lesson_title_downcase contains 'define your chroma' %}
    {% assign lesson_action_step = 'chroma' %}
    {% assign lesson_action_label = 'Define My Chroma' %}
  {% endif %}
{% endif %}
{% if lesson_is_free_member %}
  {% assign lesson_learning_menu = linklists['ycs-learning-library'] %}
  {% for lesson_topic in lesson_learning_menu.links %}
    {% for lesson_link in lesson_topic.links %}
      {% if lesson_link.url == request.path %}
        {% assign lesson_topic_parts = lesson_topic.title | split: '|' %}
        {% assign lesson_topic_title = lesson_topic_parts.first | strip %}
        {% assign lesson_topic_key = lesson_topic_title | handleize %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  {% if lesson_topic_key == 'start-here' or lesson_topic_key == 'free-color-analysis-training' or lesson_topic_key == 'using-the-ycs-tools' %}
    {% assign lesson_access = true %}
  {% endif %}
{% endif %}

<main class="ycs-lesson">
  <nav class="ycs-lesson__nav">
    {% render 'my-ycs-logo' %}
    <a href="/pages/learn">Back to Learn</a>
    <a href="mailto:support@yourcolorstyle.com">Contact</a>
  </nav>
  {% if customer == nil %}
    <h1>{{ page.title | escape }}</h1>
    <p>Please sign in to access this lesson.</p>
    <a class="ycs-lesson__button" href="{{ routes.account_login_url }}?return_url=%2Fpages%2Fmy-ycs">Sign In</a>
  {% elsif lesson_access %}
    <article>
      <p class="ycs-lesson__kicker">YCS Learning Library</p>
      <h1>{{ page.title | escape }}</h1>
      <div class="ycs-lesson__content rte">{{ page.content }}</div>
      {% if lesson_is_diy and page.handle contains 'take-a-good-photo' %}
        <a class="ycs-lesson__button" href="/pages/diy-photo-prep?mode=diy&amp;returnUrl=%2Fpages%2Fdiy-color-analysis">Upload and Adjust My Photo</a>
      {% endif %}
      {% if lesson_action_step != blank %}
        <a
          class="ycs-lesson__button"
          href="/pages/diy-photo-prep?mode=diy&amp;returnStep={{ lesson_action_step }}"
          data-diy-lesson-action="{{ lesson_action_step }}"
        >{{ lesson_action_label }}</a>
      {% endif %}
    </article>
  {% else %}
    {% render 'my-ycs-locked-access', lock_heading: 'Professional Membership Required', lock_body: 'This lesson is included with YCS Professional Membership, designed for color analysts who work with clients. Explore the professional tools and benefits to see if membership is right for you.' %}
  {% endif %}
</main>

{% if lesson_access and lesson_action_step != blank and customer %}
  <script>
    (function () {
      var button = document.querySelector('[data-diy-lesson-action]');
      if (!button) return;

      var customerId = {{ customer.id | json }};
      var requestedStep = button.getAttribute('data-diy-lesson-action');
      var appBaseUrl = 'https://ycs-palette-app.vercel.app';

      function requiredStep(transform) {
        var saved = transform && typeof transform === 'object' ? transform : {};
        if (requestedStep === 'undertone' && !saved.analysisDepthDecision) return 'depth';
        if (requestedStep === 'chroma') {
          if (!saved.analysisDepthDecision) return 'depth';
          if (!saved.analysisUndertoneDecision) return 'undertone';
        }
        return requestedStep;
      }

      function photoPrepUrl() {
        return '/pages/diy-photo-prep?mode=diy&returnStep=' + encodeURIComponent(requestedStep);
      }

      button.addEventListener('click', function (event) {
        event.preventDefault();
        button.setAttribute('aria-busy', 'true');

        fetch(appBaseUrl + '/api/get-photo?customerId=' + encodeURIComponent(customerId))
          .then(function (response) {
            if (!response.ok) throw new Error('No photo');
            return response.json();
          })
          .then(function (photo) {
            if (!photo || !photo.activePhotoUrl) {
              window.location.assign(photoPrepUrl());
              return;
            }

            var url = new URL('/pages/diy-structured-analysis', window.location.origin);
            url.searchParams.set('mode', 'diy');
            url.searchParams.set('customerId', customerId);
            url.searchParams.set('returnStep', requiredStep(photo.photoTransform));
            if (photo.photoId) url.searchParams.set('photoId', photo.photoId);
            if (photo.photoSource) url.searchParams.set('photoSource', photo.photoSource);
            window.location.assign(url.pathname + url.search);
          })
          .catch(function () {
            window.location.assign(photoPrepUrl());
          });
      });
    })();
  </script>
{% endif %}

{% style %}
  .shopify-section-header,#shopify-section-header,.site-header,.header-wrapper,.header,#shopify-section-footer,.shopify-section--footer,.site-footer,footer{display:none!important}
  body{margin-top:0!important;padding-top:0!important}
  .ycs-lesson{max-width:900px;margin:0 auto;padding:28px 24px 80px;color:#292832;font-family:Poppins,Arial,Tahoma,Verdana,sans-serif}
  .ycs-lesson__nav{display:flex;justify-content:space-between;gap:20px;margin-bottom:52px}
  .ycs-lesson__nav a{color:#4b4d55;font-weight:600;text-decoration:none}
  .ycs-lesson__kicker{margin:0 0 10px;color:#6546ce;font-size:13px;font-weight:700;text-transform:uppercase}
  .ycs-lesson h1{margin:0 0 30px;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:46px;font-weight:400;line-height:1.12;letter-spacing:0}
  .ycs-lesson__content{color:#505868;font-size:18px;line-height:1.7}
  .ycs-lesson__content h2,.ycs-lesson__content h3{margin-top:1.7em;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:0}
  .ycs-lesson__content a{color:#6546ce;text-underline-offset:3px}
  .ycs-lesson__content img{max-width:100%;height:auto;border-radius:16px}
  .ycs-lesson__button{display:inline-flex;margin-top:18px;padding:12px 20px;border-radius:10px;background:#7b5cff;color:#fff;font-weight:700;text-decoration:none;transition:background-color .18s ease,transform .18s ease}
  .ycs-lesson__button:hover{background:#6546ce;transform:translateY(-1px)}
  .ycs-lesson__button:focus-visible,.ycs-lesson__content a:focus-visible{outline:3px solid rgba(123,92,255,.3);outline-offset:3px}
  @media(max-width:700px){.ycs-lesson{padding:22px 16px 60px}.ycs-lesson__nav{margin-bottom:36px}.ycs-lesson h1{font-size:36px}.ycs-lesson__content{font-size:17px}}
  @media(prefers-reduced-motion:reduce){.ycs-lesson__button{transition:none}.ycs-lesson__button:hover{transform:none}}
{% endstyle %}

{% schema %}{"name":"YCS learning lesson","settings":[],"presets":[{"name":"YCS learning lesson"}]}{% endschema %}
