{% assign lesson_access = false %}
{% assign lesson_is_free_member = false %}
{% assign lesson_topic_key = '' %}
{% assign lesson_is_diy = false %}
{% if customer %}
  {% assign lesson_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% if lesson_tags contains ',YCSMEMBER,' or lesson_tags contains ',TRADE,' or lesson_tags contains ',YCS_ADMIN,' %}
    {% assign lesson_access = true %}
  {% else %}
    {% assign lesson_is_free_member = true %}
  {% endif %}
{% endif %}

{% assign lesson_diy_menu = linklists['diy-color-analysis'] %}
{% if lesson_diy_menu != blank %}
  {% for diy_lesson_link in lesson_diy_menu.links %}
    {% if diy_lesson_link.url == request.path %}
      {% assign lesson_is_diy = true %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if lesson_is_diy and lesson_tags contains ',DIYMEMBER,' %}
  {% assign lesson_access = true %}
{% endif %}
{% assign lesson_action_step = '' %}
{% assign lesson_action_label = '' %}
{% if lesson_is_diy %}
  {% assign lesson_title_downcase = page.title | downcase %}
  {% if page.handle contains 'determine-your-depth' or lesson_title_downcase contains 'determine your depth' %}
    {% assign lesson_action_step = 'depth' %}
    {% assign lesson_action_label = 'Determine My Depth' %}
  {% elsif page.handle contains 'analyze-your-undertones' or lesson_title_downcase contains 'analyze your undertones' %}
    {% assign lesson_action_step = 'undertone' %}
    {% assign lesson_action_label = 'Analyze My Undertones' %}
  {% elsif page.handle contains 'define-your-chroma' or lesson_title_downcase contains 'define your chroma' %}
    {% assign lesson_action_step = 'chroma' %}
    {% assign lesson_action_label = 'Define My Chroma' %}
  {% endif %}
{% endif %}
{% if lesson_is_free_member %}
  {% assign lesson_learning_menu = linklists['ycs-learning-library'] %}
  {% for lesson_topic in lesson_learning_menu.links %}
    {% for lesson_link in lesson_topic.links %}
      {% if lesson_link.url == request.path %}
        {% assign lesson_topic_parts = lesson_topic.title | split: '|' %}
        {% assign lesson_topic_title = lesson_topic_parts.first | strip %}
        {% assign lesson_topic_key = lesson_topic_title | handleize %}
      {% endif %}
    {% endfor %}
  {% endfor %}
  {% if lesson_topic_key == 'start-here' or lesson_topic_key == 'free-color-analysis-training' or lesson_topic_key == 'using-the-ycs-tools' %}
    {% assign lesson_access = true %}
  {% endif %}
{% endif %}

<main class="ycs-lesson">
  <nav class="ycs-lesson__nav">
    {% render 'my-ycs-logo' %}
    <a href="/pages/learn">Back to Learn</a>
    <a href="mailto:support@yourcolorstyle.com">Contact</a>
  </nav>
  {% if customer == nil %}
    <h1>{{ page.title | escape }}</h1>
    <p>Please sign in to access this lesson.</p>
    <a class="ycs-lesson__button" href="{{ routes.account_login_url }}?return_url=%2Fpages%2Fmy-ycs">Sign In</a>
  {% elsif lesson_access %}
    <article{% if lesson_is_diy and page.handle == 'step-5-get-your-color-palette' %} data-diy-result-page hidden{% endif %}>
      <p class="ycs-lesson__kicker">YCS Learning Library</p>
      <h1>{{ page.title | escape }}</h1>
      <div class="ycs-lesson__content rte">{{ page.content }}</div>
      {% if lesson_is_diy and page.handle == 'step-5-get-your-color-palette' %}
        <section class="ycs-lesson__mini-palette" data-diy-mini-palette hidden>
          <h2 data-diy-mini-palette-title></h2>
          <img data-diy-mini-palette-image src="" alt="" />
        </section>
        <section class="ycs-lesson__palette-offer" data-diy-palette-offer hidden>
          <p class="ycs-lesson__palette-offer-kicker">Your Next Step</p>
          <h2>Love Your Colors? Take Your Full Palette With You.</h2>
          <p>You've discovered your color type! Your mini palette is just the beginning. Get your complete digital color palette to explore more of your best colors and make confident choices when shopping, getting dressed, and building your wardrobe.</p>
          <p class="ycs-lesson__palette-price"><strong>$24.97</strong><span>One-time purchase</span></p>
          <a class="ycs-lesson__palette-offer-button" data-diy-palette-offer-link href="#"></a>
          <p class="ycs-lesson__palette-offer-note">Your complete palette, available digitally whenever you need it.</p>
        </section>
      {% endif %}
      {% if lesson_is_diy and page.handle contains 'take-a-good-photo' %}
        <a class="ycs-lesson__button" href="/pages/diy-photo-prep?mode=diy&amp;returnUrl=%2Fpages%2Fdiy-color-analysis">Upload and Adjust My Photo</a>
      {% endif %}
      {% if lesson_action_step != blank %}
        <a
          class="ycs-lesson__button"
          href="/pages/diy-photo-prep?mode=diy&amp;returnStep={{ lesson_action_step }}"
          data-diy-lesson-action="{{ lesson_action_step }}"
        >{{ lesson_action_label }}</a>
      {% endif %}
    </article>
  {% else %}
    {% render 'my-ycs-locked-access', lock_heading: 'Professional Membership Required', lock_body: 'This lesson is included with YCS Professional Membership, designed for color analysts who work with clients. Explore the professional tools and benefits to see if membership is right for you.' %}
  {% endif %}
</main>

{% if lesson_access and lesson_action_step != blank and customer %}
  <script>
    (function () {
      var button = document.querySelector('[data-diy-lesson-action]');
      if (!button) return;

      var customerId = {{ customer.id | json }};
      var requestedStep = button.getAttribute('data-diy-lesson-action');
      var appBaseUrl = 'https://ycs-palette-app.vercel.app';

      function requiredStep(transform) {
        var saved = transform && typeof transform === 'object' ? transform : {};
        if (requestedStep === 'undertone' && !saved.analysisDepthDecision) return 'depth';
        if (requestedStep === 'chroma') {
          if (!saved.analysisDepthDecision) return 'depth';
          if (!saved.analysisUndertoneDecision) return 'undertone';
        }
        return requestedStep;
      }

      function photoPrepUrl() {
        return '/pages/diy-photo-prep?mode=diy&returnStep=' + encodeURIComponent(requestedStep);
      }

      button.addEventListener('click', function (event) {
        event.preventDefault();
        button.setAttribute('aria-busy', 'true');

        fetch(appBaseUrl + '/api/get-photo?customerId=' + encodeURIComponent(customerId))
          .then(function (response) {
            if (!response.ok) throw new Error('No photo');
            return response.json();
          })
          .then(function (photo) {
            if (!photo || !photo.activePhotoUrl) {
              window.location.assign(photoPrepUrl());
              return;
            }

            var url = new URL('/pages/diy-structured-analysis', window.location.origin);
            url.searchParams.set('mode', 'diy');
            url.searchParams.set('customerId', customerId);
            url.searchParams.set('returnStep', requiredStep(photo.photoTransform));
            if (photo.photoId) url.searchParams.set('photoId', photo.photoId);
            if (photo.photoSource) url.searchParams.set('photoSource', photo.photoSource);
            window.location.assign(url.pathname + url.search);
          })
          .catch(function () {
            window.location.assign(photoPrepUrl());
          });
      });
    })();
  </script>
{% endif %}

{% if lesson_access and lesson_is_diy and page.handle == 'step-5-get-your-color-palette' and customer %}
  <script>
    (function () {
      var page = document.querySelector('[data-diy-result-page]');
      var wrap = document.querySelector('[data-diy-mini-palette]');
      var title = document.querySelector('[data-diy-mini-palette-title]');
      var image = document.querySelector('[data-diy-mini-palette-image]');
      var offer = document.querySelector('[data-diy-palette-offer]');
      var offerLink = document.querySelector('[data-diy-palette-offer-link]');
      if (!page || !wrap || !title || !image || !offer || !offerLink) return;

      var palettes = {
        LO: {
          label: 'Light Olive',
          image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/light-olive-mini-color-palette.png?v=1791571232',
          variant: '48065993769184'
        },
        MO: {
          label: 'Medium Olive',
          image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/medium-olive-mini-color-palette.png?v=1791571232',
          variant: '48066001633504'
        },
        DO: {
          label: 'Deep Olive',
          image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/deep-olive-mini-color-palette.png?v=1791571232',
          variant: '48065972797664'
        },
        CCL: { label: 'Clear Cool Light', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-cool-light-mini-color-palette.png?v=1696344576', variant: '46767297691872' },
        CCM: { label: 'Clear Cool Medium', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-cool-medium-mini-color-palette.png?v=1696016962', variant: '46765168001248' },
        CCD: { label: 'Clear Cool Deep', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-cool-deep-mini-color-palette.png?v=1696018722', variant: '46735667003616' },
        CWL: { label: 'Clear Warm Light', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-warm-light-mini-color-palette.png?v=1695324121', variant: '46735667036384' },
        CWM: { label: 'Clear Warm Medium', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-warm-medium-mini-color-palette.png?v=1696363890', variant: '46735667101920' },
        CWD: { label: 'Clear Warm Deep', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/bright-warm-deep-mini-color-palette.png?v=1695824315', variant: '46735667167456' },
        SWL: { label: 'Soft Warm Light', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/soft-warm-light-mini-color-palette_9b0861a2-a42f-4eb9-9c97-aad52ab49b38.png?v=1696357080', variant: '46735667298528' },
        SWM: { label: 'Soft Warm Medium', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/soft-warm-medium-mini-color-palette.png?v=1696363004', variant: '46735667364064' },
        SWD: { label: 'Soft Warm Deep', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/soft-warm-deep-mini-color-palette.png?v=1695828206', variant: '46735667429600' },
        SCL: { label: 'Soft Cool Light', variant: '46769541152992' },
        SCM: { label: 'Soft Cool Medium', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/soft-cool-medium-mini-color-palette.png?v=1695837432', variant: '46735667232992' },
        SCD: { label: 'Soft Cool Deep', image: 'https://cdn.shopify.com/s/files/1/0623/6284/5408/files/soft-cool-deep-mini-color-palette.png?v=1695995938', variant: '46735667265760' }
      };

      function codeFromLabel(label) {
        var normalized = String(label || '').trim().toLowerCase();
        var codes = Object.keys(palettes);
        for (var index = 0; index < codes.length; index += 1) {
          if (palettes[codes[index]].label.toLowerCase() === normalized) return codes[index];
        }
        return '';
      }

      function renderPalette(code) {
        var palette = palettes[String(code || '').toUpperCase()];
        if (!palette) return false;
        if (palette.image) {
          title.textContent = palette.label + ' Mini Color Palette';
          image.src = palette.image;
          image.alt = palette.label + ' mini color palette';
          wrap.hidden = false;
        } else {
          wrap.hidden = true;
        }
        offerLink.textContent = 'Get My ' + palette.label + ' Digital Palette';
        offerLink.href = '/products/digital-color-palettes?variant=' + palette.variant + '#order';
        offer.hidden = false;
        page.hidden = false;
        return true;
      }

      var requestedCode = new URLSearchParams(window.location.search).get('result');
      renderPalette(requestedCode);

      fetch('https://ycs-palette-app.vercel.app/api/get-photo?customerId={{ customer.id }}')
        .then(function (response) {
          if (!response.ok) throw new Error('No saved DIY result');
          return response.json();
        })
        .then(function (photo) {
          var transform = photo && photo.photoTransform ? photo.photoTransform : {};
          var savedCode = codeFromLabel(transform.analysisChromaDecision);
          if (savedCode) renderPalette(savedCode);
        })
        .catch(function () {
          /* The result query still renders the palette immediately after selection. */
        });
    })();
  </script>
{% endif %}

{% style %}
  .shopify-section-header,#shopify-section-header,.site-header,.header-wrapper,.header,#shopify-section-footer,.shopify-section--footer,.site-footer,footer{display:none!important}
  body{margin-top:0!important;padding-top:0!important}
  .ycs-lesson{max-width:900px;margin:0 auto;padding:28px 24px 80px;color:#292832;font-family:Poppins,Arial,Tahoma,Verdana,sans-serif}
  .ycs-lesson__nav{display:flex;justify-content:space-between;gap:20px;margin-bottom:52px}
  .ycs-lesson__nav a{color:#4b4d55;font-weight:600;text-decoration:none}
  .ycs-lesson__kicker{margin:0 0 10px;color:#6546ce;font-size:13px;font-weight:700;text-transform:uppercase}
  .ycs-lesson h1{margin:0 0 30px;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:46px;font-weight:400;line-height:1.12;letter-spacing:0}
  .ycs-lesson__content{color:#505868;font-size:18px;line-height:1.7}
  .ycs-lesson__content h2,.ycs-lesson__content h3{margin-top:1.7em;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-weight:400;letter-spacing:0}
  .ycs-lesson__content a{color:#6546ce;text-underline-offset:3px}
  .ycs-lesson__content img{max-width:100%;height:auto;border-radius:16px}
  .ycs-lesson__button{display:inline-flex;margin-top:18px;padding:12px 20px;border-radius:10px;background:#7b5cff;color:#fff;font-weight:700;text-decoration:none;transition:background-color .18s ease,transform .18s ease}
  .ycs-lesson__button:hover{background:#6546ce;color:#fff!important;transform:translateY(-1px)}
  .ycs-lesson__button:focus-visible,.ycs-lesson__content a:focus-visible{outline:3px solid rgba(123,92,255,.3);outline-offset:3px}
  .ycs-lesson__mini-palette{margin-top:34px}
  .ycs-lesson__mini-palette h2{margin:0 0 18px;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:30px;font-weight:400}
  .ycs-lesson__mini-palette img{display:block;width:100%;max-width:760px;height:auto;border-radius:8px}
  .ycs-lesson__palette-offer{margin-top:32px;padding:30px;border:1px solid #ded8ef;border-radius:8px;background:#faf9ff;color:#505868}
  .ycs-lesson__palette-offer-kicker{margin:0 0 10px;color:#6546ce;font-size:13px;font-weight:700;text-transform:uppercase}
  .ycs-lesson__palette-offer h2{margin:0 0 14px;color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:30px;font-weight:400;line-height:1.2}
  .ycs-lesson__palette-offer>p:not(.ycs-lesson__palette-offer-kicker):not(.ycs-lesson__palette-price):not(.ycs-lesson__palette-offer-note){margin:0;font-size:17px;line-height:1.65}
  .ycs-lesson__palette-price{display:flex;align-items:baseline;gap:14px;margin:22px 0 18px}
  .ycs-lesson__palette-price strong{color:#12253f;font-family:Georgia,"Times New Roman",serif;font-size:34px;font-weight:400}
  .ycs-lesson__palette-price span{font-size:15px}
  .ycs-lesson__palette-offer-button{display:flex;justify-content:center;width:100%;padding:14px 20px;border-radius:8px;background:#7b5cff;color:#fff!important;font-weight:700;text-align:center;text-decoration:none;transition:background-color .18s ease,transform .18s ease}
  .ycs-lesson__palette-offer-button:hover{background:#6546ce;color:#fff!important;transform:translateY(-1px)}
  .ycs-lesson__palette-offer-note{margin:18px 0 0;font-size:14px}
  @media(max-width:700px){.ycs-lesson{padding:22px 16px 60px}.ycs-lesson__nav{margin-bottom:36px}.ycs-lesson h1{font-size:36px}.ycs-lesson__content{font-size:17px}.ycs-lesson__palette-offer{padding:22px 18px}.ycs-lesson__palette-offer h2{font-size:26px}}
  @media(prefers-reduced-motion:reduce){.ycs-lesson__button{transition:none}.ycs-lesson__button:hover{transform:none}}
{% endstyle %}

{% schema %}{"name":"YCS learning lesson","settings":[],"presets":[{"name":"YCS learning lesson"}]}{% endschema %}
