{% assign ycs_member_access = false %}
{% assign ycs_free_member = false %}
{% if customer %}
  {% assign ycs_member_tags = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
  {% if ycs_member_tags contains ',YCSMEMBER,' or ycs_member_tags contains ',TRADE,' or ycs_member_tags contains ',FREEMEMBER,' or ycs_member_tags contains ',YCS_ADMIN,' %}
    {% assign ycs_member_access = true %}
  {% endif %}
  {% if ycs_member_tags contains ',FREEMEMBER,' %}
    {% unless ycs_member_tags contains ',YCSMEMBER,' or ycs_member_tags contains ',TRADE,' or ycs_member_tags contains ',YCS_ADMIN,' %}
      {% assign ycs_free_member = true %}
    {% endunless %}
  {% endif %}
{% endif %}

<section class="ycs-learn-hub">
  <nav class="ycs-learn-hub__nav" aria-label="Membership navigation">
    {% render 'my-ycs-logo' %}
    <a href="/pages/my-ycs" class="ycs-learn-hub__link">Back to My YCS</a>
    <a href="mailto:support@yourcolorstyle.com" class="ycs-learn-hub__link">Contact</a>
  </nav>

  <nav class="ycs-learn-topic-nav" aria-label="Topic navigation" data-topic-nav hidden>
    <button type="button" data-close-topic>Back to Learn</button>
    <a href="/pages/learn" class="is-active" aria-current="page" data-topic-current></a>
  </nav>

  {% if customer == nil %}
    <header class="ycs-learn-hub__header">
      <p class="ycs-learn-hub__kicker">Your Color Style</p>
      <h1>Learn</h1>
      <p>Please sign in to access your membership.</p>
      <a href="{{ routes.account_login_url }}" class="ycs-learn-hub__button">Sign In</a>
    </header>
  {% elsif ycs_member_access == false %}
    <header class="ycs-learn-hub__header">
      <p class="ycs-learn-hub__kicker">Your Color Style</p>
      <h1>Learn</h1>
      <p>This membership is not available on your account.</p>
    </header>
  {% else %}
    <header class="ycs-learn-hub__header" data-learn-header>
      <p class="ycs-learn-hub__kicker">My YCS</p>
      <h1>Learn</h1>
    </header>

    {% if ycs_free_member %}
      <div class="ycs-learn-hub__grid">
        <article class="ycs-learn-card">
          <div class="ycs-learn-card__accent"></div>
          <div class="ycs-learn-card__body">
            <h2>Free Color Analysis Training</h2>
            <p><em>Discover how the YCS approach uses depth, undertones and chroma to understand your coloring.</em></p>
            <a href="/products/learn-color-analysis" class="ycs-learn-hub__button">Continue Training &rarr;</a>
          </div>
        </article>
      </div>
    {% else %}
      {% assign learning_menu = section.settings.learning_menu %}
      {% if learning_menu == blank %}
        {% assign learning_menu = linklists['ycs-learning-library'] %}
      {% endif %}
      {% if learning_menu != blank and learning_menu.links.size > 0 %}
        <div class="ycs-learn-hub__grid" data-topic-grid>
          {% for topic in learning_menu.links %}
            {% assign topic_parts = topic.title | split: '|' %}
            {% assign topic_title = topic_parts.first | strip %}
            {% assign topic_description = topic_parts[1] | strip %}
            <article class="ycs-learn-card">
              <div class="ycs-learn-card__accent"></div>
              <div class="ycs-learn-card__body">
                <h2>{{ topic_title | escape }}</h2>
                <p>{% if topic_description != blank %}{{ topic_description | escape }}{% else %}{{ topic.links.size }} lesson{% unless topic.links.size == 1 %}s{% endunless %}{% endif %}</p>
                {% if topic.links.size == 1 %}
                  <a class="ycs-learn-hub__button" href="{{ topic.links.first.url }}">Open Lesson</a>
                {% else %}
                  <button class="ycs-learn-hub__button" type="button" data-open-topic="{{ forloop.index0 }}" data-topic-title="{{ topic_title | escape }}">Explore Topic</button>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>

        {% for topic in learning_menu.links %}
          {% assign topic_parts = topic.title | split: '|' %}
          {% assign topic_title = topic_parts.first | strip %}
          <section class="ycs-learn-topic" data-topic="{{ forloop.index0 }}" hidden>
            <header class="ycs-learn-topic__header">
              <p class="ycs-learn-hub__kicker">YCS Learning Library</p>
              <h1>{{ topic_title | escape }}</h1>
            </header>
            <div class="ycs-learn-hub__grid">
              {% for lesson in topic.links %}
                {% assign lesson_parts = lesson.title | split: '|' %}
                {% assign lesson_title = lesson_parts.first | strip %}
                {% assign lesson_description = lesson_parts[1] | strip %}
                <article class="ycs-learn-card ycs-learn-card--lesson">
                  <div class="ycs-learn-card__body">
                    <h3>{{ lesson_title | escape }}</h3>
                    {% if lesson_description != blank %}<p>{{ lesson_description | escape }}</p>{% endif %}
                    <a class="ycs-learn-hub__button" href="{{ lesson.url }}">Open Lesson</a>
                  </div>
                </article>
              {% else %}
                <p>No lessons have been added to this topic yet.</p>
              {% endfor %}
            </div>
          </section>
        {% endfor %}
      {% elsif ycs_member_tags contains ',YCS_ADMIN,' %}
        <div class="ycs-learn-admin-note">
          Select a navigation menu in the My YCS Learn section settings. Top-level links become topics and nested links become lessons.
        </div>
      {% endif %}
    {% endif %}
  {% endif %}
</section>

<script>
  (function () {
    var grid = document.querySelector('[data-topic-grid]');
    if (!grid) return;
    var topics = Array.from(document.querySelectorAll('[data-topic]'));
    var learnHeader = document.querySelector('[data-learn-header]');
    var topicNav = document.querySelector('[data-topic-nav]');
    var topicCurrent = document.querySelector('[data-topic-current]');
    function showGrid() {
      grid.hidden = false;
      topics.forEach(function (topic) { topic.hidden = true; });
      if (learnHeader) learnHeader.hidden = false;
      if (topicNav) topicNav.hidden = true;
      document.querySelector('.ycs-learn-hub').classList.remove('is-topic-open');
    }
    document.querySelectorAll('[data-open-topic]').forEach(function (button) {
      button.addEventListener('click', function () {
        grid.hidden = true;
        if (learnHeader) learnHeader.hidden = true;
        if (topicNav) topicNav.hidden = false;
        if (topicCurrent) topicCurrent.textContent = button.dataset.topicTitle || '';
        document.querySelector('.ycs-learn-hub').classList.add('is-topic-open');
        topics.forEach(function (topic) {
          topic.hidden = topic.dataset.topic !== button.dataset.openTopic;
        });
      });
    });
    document.querySelectorAll('[data-close-topic]').forEach(function (button) {
      button.addEventListener('click', showGrid);
    });
  })();
</script>

{% style %}
  .shopify-section-header, #shopify-section-header, .site-header, .header-wrapper, .header, #shopify-section-footer, .shopify-section--footer, .site-footer, footer.footer, footer[role="contentinfo"] { display: none !important; }
  body { margin-top: 0 !important; padding-top: 0 !important; }
  .ycs-learn-hub { max-width: 1180px; margin: 0 auto; padding: 28px 24px 72px; color: #313238; }
  .ycs-learn-hub__nav { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 42px; }
  .ycs-learn-topic-nav { position: fixed; top: 76px; right: 0; left: 0; z-index: 10019; display: flex; align-items: center; gap: 28px; min-height: 50px; padding: 0 max(24px, calc((100vw - 1440px) / 2)); border-bottom: 1px solid #e7e3f0; background: #f8f6ff; }
  .ycs-learn-topic-nav button { min-height: 50px; margin: 0; padding: 0 2px; border: 0; background: transparent; color: #55566a; font: inherit; font-size: 14px; font-weight: 650; cursor: pointer; }
  .ycs-learn-topic-nav a { position: relative; display: inline-flex; align-items: center; min-height: 50px; padding: 0 2px; color: #5c31bd; font-size: 14px; font-weight: 650; text-decoration: none; white-space: nowrap; }
  .ycs-learn-topic-nav a::after { position: absolute; right: 0; bottom: 0; left: 0; height: 3px; border-radius: 3px 3px 0 0; background: #6c3ddd; content: ""; }
  .ycs-learn-hub.is-topic-open { padding-top: 78px; }
  .ycs-learn-hub__link { color: #4b4d55; font-size: 15px; font-weight: 600; text-decoration: none; }
  .ycs-learn-hub__link:hover { text-decoration: underline; }
  .ycs-learn-hub__header { max-width: 780px; margin-bottom: 42px; }
  .ycs-learn-hub__kicker { margin: 0 0 8px; color: #bd315b; font-size: 13px; font-weight: 700; letter-spacing: 0; text-transform: uppercase; }
  .ycs-learn-hub__header h1 { margin: 0 0 12px; color: #292a30; font-size: 42px; line-height: 1.14; letter-spacing: 0; }
  .ycs-learn-hub__header > p:not(.ycs-learn-hub__kicker) { margin: 0; color: #686a72; font-size: 19px; line-height: 1.6; }
  .ycs-learn-hub__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .ycs-learn-card { overflow: hidden; border: 1px solid #e7e3df; border-radius: 8px; background: #fff; box-shadow: 0 8px 24px rgba(37, 39, 46, .06); }
  .ycs-learn-card__accent { height: 10px; background: linear-gradient(90deg, #385c7d, #56a3ae, #83c998, #e6bd59); }
  .ycs-learn-card__body { display: flex; min-height: 230px; flex-direction: column; align-items: flex-start; padding: 28px; }
  .ycs-learn-card h2 { margin: 0 0 10px; color: #303139; font-size: 24px; line-height: 1.32; letter-spacing: 0; }
  .ycs-learn-card h3 { margin: 0 0 22px; color: #303139; font-size: 21px; line-height: 1.35; letter-spacing: 0; }
  .ycs-learn-card p { margin: 0 0 28px; color: #686a72; font-size: 17px; line-height: 1.55; }
  .ycs-learn-hub__button { display: inline-flex; min-height: 46px; margin-top: auto; align-items: center; justify-content: center; border-radius: 6px; background: #cf3f65; color: #fff; font-size: 15px; font-weight: 700; line-height: 1.2; padding: 12px 20px; text-decoration: none; }
  .ycs-learn-hub__button:hover { background: #b72f55; color: #fff; }
  button.ycs-learn-hub__button { border: 0; cursor: pointer; }
  .ycs-learn-topic { max-width: 900px; margin: 0 auto; }
  .ycs-learn-topic__header { margin-bottom: 30px; }
  .ycs-learn-topic__header h1 { margin: 0; color: #292a30; font-size: 42px; line-height: 1.15; letter-spacing: 0; }
  .ycs-learn-topic .ycs-learn-hub__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ycs-learn-card--lesson .ycs-learn-card__body { min-height: 180px; }
  .ycs-learn-admin-note { max-width: 760px; padding: 20px; border-left: 4px solid #bd315b; background: #fff3f6; color: #555861; line-height: 1.6; }
  .ycs-learn-hub [hidden] { display: none !important; }
  @media (max-width: 980px) {
    .ycs-learn-hub__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ycs-learn-topic .ycs-learn-hub__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 1100px) {
    .ycs-learn-topic-nav { top: 68px; padding: 0 16px; }
  }
  @media (max-width: 640px) {
    .ycs-learn-hub { padding: 22px 16px 52px; }
    .ycs-learn-hub__nav { margin-bottom: 30px; }
    .ycs-learn-hub__header h1 { font-size: 32px; }
    .ycs-learn-hub__grid { grid-template-columns: 1fr; }
    .ycs-learn-topic .ycs-learn-hub__grid { grid-template-columns: 1fr; }
    .ycs-learn-topic__header h1 { font-size: 32px; }
    .ycs-learn-card__body { min-height: 205px; padding: 24px; }
  }
{% endstyle %}

{% schema %}
{
  "name": "My YCS Learn",
  "settings": [
    {
      "type": "link_list",
      "id": "learning_menu",
      "label": "Learning library menu"
    }
  ],
  "presets": [{ "name": "My YCS Learn" }]
}
{% endschema %}
