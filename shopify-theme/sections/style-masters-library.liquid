<section class="sm-library page-width">
  <div class="ycs-palette-topnav">
    <a href="{{ routes.account_url }}" class="ycs-palette-backlink">← My Account</a>
  </div>

  {% assign customer_tag_string = '' %}
  {% assign is_admin = false %}
  {% assign has_current_membership = false %}
  {% assign has_start_date = false %}
  {% assign sm_start_date = customer.metafields.membership.style_masters_start | default: blank %}
  {% assign sm_start_period = sm_start_date | date: '%Y-%m' %}
  {% assign sm_start_period_key = sm_start_period | remove: '-' | plus: 0 %}
  {% assign recent_periods_csv = ',' %}
  {% assign current_period = 'now' | date: '%Y-%m' %}
  {% assign current_period_key = current_period | remove: '-' | plus: 0 %}

  {% assign current_month_start_s = 'now' | date: '%Y-%m-01' | date: '%s' %}
  {% assign month_seconds = 2678400 %}
  {% for recent_index in (0..6) %}
    {% assign recent_offset = month_seconds | times: recent_index %}
    {% assign recent_s = current_month_start_s | minus: recent_offset %}
    {% assign recent_period = recent_s | date: '%Y-%m' %}
    {% assign recent_needle = ',' | append: recent_period | append: ',' %}
    {% unless recent_periods_csv contains recent_needle %}
      {% assign recent_periods_csv = recent_periods_csv | append: recent_period | append: ',' %}
    {% endunless %}
  {% endfor %}

  {% if customer %}
    {% assign customer_tag_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}

    {% if customer_tag_string contains ',VIP,' %}
      {% assign has_current_membership = true %}
    {% endif %}

    {% if customer_tag_string contains ',YCS_ADMIN,' %}
      {% assign is_admin = true %}
    {% endif %}

    {% if sm_start_date != blank %}
      {% assign has_start_date = true %}
    {% endif %}
  {% endif %}

  {% assign display_count = 0 %}
  {% assign owned_issue_count = 0 %}
  {% assign locked_recent_count = 0 %}
  {% assign missing_product_url_count = 0 %}

  {% if customer %}
    {% for block in section.blocks %}
      {% if block.type == 'download' %}
        {% assign issue_period_str = block.settings.issue_period | default: '' %}
        {% if issue_period_str != '' %}
          {% assign issue_period_key = issue_period_str | remove: '-' | plus: 0 %}
          {% assign issue_year = issue_period_str | slice: 0, 4 %}
          {% assign issue_entitlement = block.settings.entitlement_code | default: '' | strip | upcase %}
          {% if issue_entitlement == blank %}
            {% assign issue_entitlement = 'STYLEMASTERS_' | append: issue_period_str | replace: '-', '_' %}
          {% endif %}
          {% assign issue_period_token = ',' | append: issue_period_str | append: ',' %}

          {% assign owns_issue = false %}
          {% if has_current_membership and has_start_date and issue_period_key >= sm_start_period_key and issue_period_key <= current_period_key %}
            {% assign owns_issue = true %}
          {% elsif has_current_membership and has_start_date == false and issue_year != '2024' and issue_period_key <= current_period_key %}
            {% assign owns_issue = true %}
          {% endif %}

          {% assign is_recent_issue = false %}
          {% if recent_periods_csv contains issue_period_token %}
            {% assign is_recent_issue = true %}
          {% endif %}

          {% if owns_issue or is_recent_issue %}
            {% assign display_count = display_count | plus: 1 %}
          {% endif %}

          {% if owns_issue %}
            {% assign owned_issue_count = owned_issue_count | plus: 1 %}
          {% elsif is_recent_issue %}
            {% assign locked_recent_count = locked_recent_count | plus: 1 %}
            {% if block.settings.product_url == blank %}
              {% assign missing_product_url_count = missing_product_url_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% assign sm_can_view = false %}
  {% if customer %}
    {% if has_current_membership %}
      {% assign sm_can_view = true %}
    {% endif %}
  {% endif %}

  {% if sm_can_view %}

    <h1 class="sm-library__heading">
      {{ section.settings.heading | default: "Style Masters Download Hub " }}
    </h1>

   <nav class="sm-submenu">
  <a href="/pages/style-masters-library" class="sm-submenu__link sm-current">Hub</a>
  <a href="/pages/style-masters-schedule" class="sm-submenu__link">Schedule</a>
  <a href="https://www.facebook.com/groups/colorfulumembers" class="sm-submenu__link" target="_blank" rel="noopener">FB Group</a>
</nav>

    {% if section.settings.intro != blank %}
      <div class="sm-library__intro">
        {{ section.settings.intro }}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 and display_count > 0 %}

      {% if missing_product_url_count > 0 and is_admin %}
        <div class="sm-library__admin-warning">
          {{ missing_product_url_count }} locked recent issue{% if missing_product_url_count != 1 %}s{% endif %} need an individual product URL before customers can unlock them from this Hub.
        </div>
      {% endif %}

      <div class="sm-library__list">
        {% for block in section.blocks %}
          {% if block.type == 'download' %}

            {% assign issue_period_str = block.settings.issue_period | default: '' %}
            {% if issue_period_str != '' %}
              {% assign issue_period_key = issue_period_str | remove: '-' | plus: 0 %}
              {% assign issue_year = issue_period_str | slice: 0, 4 %}
              {% assign issue_entitlement = block.settings.entitlement_code | default: '' | strip | upcase %}
              {% if issue_entitlement == blank %}
                {% assign issue_entitlement = 'STYLEMASTERS_' | append: issue_period_str | replace: '-', '_' %}
              {% endif %}
              {% assign issue_period_token = ',' | append: issue_period_str | append: ',' %}

              {% assign owns_issue = false %}
              {% if has_current_membership and has_start_date and issue_period_key >= sm_start_period_key and issue_period_key <= current_period_key %}
                {% assign owns_issue = true %}
              {% elsif has_current_membership and has_start_date == false and issue_year != '2024' and issue_period_key <= current_period_key %}
                {% assign owns_issue = true %}
              {% endif %}

              {% assign is_recent_issue = false %}
              {% if recent_periods_csv contains issue_period_token %}
                {% assign is_recent_issue = true %}
              {% endif %}

              {% if owns_issue or is_recent_issue %}

                <div class="sm-library__item{% unless owns_issue %} is-locked{% endunless %}" data-issue-id="style-masters-{{ issue_period_str }}" data-entitlement-code="{{ issue_entitlement | escape }}" {{ block.shopify_attributes }}>
                  {% if block.settings.cover_image != blank %}
                    <div class="sm-library__cover-wrap">
                      {{
                        block.settings.cover_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          class: 'sm-library__cover',
                          alt: block.settings.title
                      }}
                    </div>
                  {% endif %}

                  <h2 class="sm-library__item-title">
                    {{ block.settings.title }}
                    {% if forloop.first %}
                      <span class="sm-library__badge">NEW</span>
                    {% endif %}
                    {% unless owns_issue %}
                      <span class="sm-library__badge sm-library__badge--locked">Locked</span>
                    {% endunless %}
                  </h2>

                  {% if owns_issue %}
                    {% if block.settings.description != blank %}
                      <div class="sm-library__item-desc">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    {% assign has_links = false %}

                    {% if block.settings.resource_1_url != blank %}
                      {% assign has_links = true %}
                      <p class="sm-library__item-link">
                        <a href="{{ block.settings.resource_1_url }}"
                           class="sm-btn-primary"
                           target="_blank"
                           rel="noopener noreferrer">
                          {{ block.settings.resource_1_label | default: "Resource 1" }}
                        </a>
                      </p>
                    {% endif %}

                    {% if block.settings.resource_2_url != blank %}
                      {% assign has_links = true %}
                      <p class="sm-library__item-link">
                        <a href="{{ block.settings.resource_2_url }}"
                           class="sm-btn-outline"
                           target="_blank"
                           rel="noopener noreferrer">
                          {{ block.settings.resource_2_label | default: "Resource 2" }}
                        </a>
                      </p>
                    {% endif %}

                    {% if block.settings.resource_3_url != blank %}
                      {% assign has_links = true %}
                      <p class="sm-library__item-link">
                        <a href="{{ block.settings.resource_3_url }}"
                           class="sm-text-link"
                           target="_blank"
                           rel="noopener noreferrer">
                            {{ block.settings.resource_3_label | default: "Resource 3" }}
                        </a>
                      </p>
                    {% endif %}

                    {% unless has_links %}
                      <p><em>No resources linked yet.</em></p>
                    {% endunless %}
                  {% else %}
                    <div class="sm-library__item-desc">
                      <p>Not currently in your library.</p>
                    </div>

                    <div class="sm-library__locked-panel">
                      <p class="sm-library__lock-label">Locked</p>
                      {% if block.settings.product_url != blank %}
                        <a href="{{ block.settings.product_url }}" class="sm-btn-primary sm-btn-primary--locked">
                          Unlock This Issue
                        </a>
                      {% else %}
                        <span class="sm-library__missing-product">
                          Unlock link coming soon.
                        </span>
                        {% if is_admin %}
                          <span class="sm-library__config-error">
                            Missing product URL for {{ issue_entitlement }}.
                          </span>
                        {% endif %}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>

              {% endif %}
            {% endif %}

          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p>You don’t have any downloads added yet. Use the theme editor to add blocks to this section.</p>
    {% endif %}

  {% else %}
    <h1 class="sm-library__heading">
      {{ section.settings.locked_heading | default: "Style Masters Members Only" }}
    </h1>

    <div class="sm-library__locked-message">
      {% if customer %}
        <p>Your account doesn’t currently have access to this library.</p>
        <p>Style Masters Hub access requires an active VIP tag on your customer account.</p>
      {% else %}
        <p>Please log in with a VIP account to access your downloads.</p>
      {% endif %}

      <p>
        <a href="/products/style-masters-magazine" class="btn btn--secondary">
          Learn about Style Masters
        </a>
      </p>
    </div>
  {% endif %}
</section>




<style>
    .ycs-palette-backlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: #555;
    text-decoration: none;
  }

  .ycs-palette-backlink:hover {
    color: #111;
  }
  /* --- Style Masters Submenu --- */
  .sm-submenu {
    margin: .3rem 0 2rem;
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #eee;
  }

  .sm-submenu__link {
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    color: #666;
    padding-bottom: 6px;
    border-bottom: 3px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .sm-submenu__link:hover {
    color: #e8406b;
    border-color: #f7b6c8;
  }

  .sm-submenu__link.sm-current {
    color: #e8406b;
    border-color: #e8406b;
  }

  @media (max-width: 600px) {
    .sm-submenu {
      gap: 1.5rem;
    }
    .sm-submenu__link {
      font-size: 0.9rem;
    }
  }

  .sm-library {
    margin: 1rem auto 4rem;
    max-width: 1200px;
    padding: 0 1.5rem;
  }

  .sm-library__heading {
    font-size: clamp(2rem, 2.4vw, 2.4rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    margin-bottom: 0.25rem;
  }

  .sm-library__intro {
    margin-bottom: 2rem;
    max-width: 52rem;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .sm-library__intro a {
    color: #e8406b;
    font-weight: 600;
    text-decoration: underline;
  }

  .sm-library__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .sm-library__item {
    border-radius: 14px;
    padding: 1.25rem 1.5rem 1.5rem;
    background: #ffffff;
    border: 1px solid #f0f0f0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .sm-library__item.is-locked {
    opacity: 0.9;
  }

  .sm-library__item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    border-color: #f6cad8;
  }

  .sm-library__cover-wrap {
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    background: #f7f7f7;
    margin-bottom: 1rem;
  }

  .sm-library__cover {
    display: block;
    width: 100%;
    height: auto;
  }

  .sm-library__item-title {
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.6rem;
    color: #111111;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .sm-library__badge {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #e8406b;
    color: #ffffff;
    border-radius: 999px;
    padding: 2px 8px;
    font-weight: 700;
  }

  .sm-library__badge--locked {
    background: #f8eef2;
    color: #9b4258;
  }

  .sm-library__item-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 1rem;
  }
.sm-library__item-desc a {
  color: #e8406b !important;
    font-weight: 600;
    text-decoration: underline;
}
.sm-library__item-desc a:hover {
  text-decoration-thickness: 2px;
}
  .sm-library__item-desc p {
    margin: 0 0 0.3rem;
  }

  .sm-library__item-desc strong {
    font-weight: 700;
    color: #111111;
  }

  .sm-library__item-link {
    margin: 0 0 0.5rem;
  }

  .sm-library__item-link:last-of-type {
    margin-bottom: 0;
  }

  .sm-library__item-link a {
    width: 100%;
    text-align: center;
  }

  .sm-btn-primary {
    display: inline-block;
    background-color: #e8406b;
    color: #ffffff;
    padding: 12px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
  }

  .sm-btn-primary:hover {
    background-color: #c52f56;
    color: #ffffff;
  }

  .sm-btn-primary--locked {
    background: #fff6f8;
    color: #b93d59;
    border: 1px solid #efb7c4;
  }

  .sm-btn-primary--locked:hover {
    background: #fdecef;
    color: #a8324d;
    border-color: #e59caf;
  }

  .sm-btn-outline {
    display: inline-block;
    background-color: #ffffff;
    color: #e8406b;
    border: 2px solid #e8406b;
    padding: 10px 20px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sm-btn-outline:hover {
    background-color: #ffe7f0;
  }

  .sm-text-link {
    display: block;
    color: #e8406b;
    text-decoration: underline;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
  }

  .sm-text-link:hover {
    text-decoration-thickness: 2px;
  }

  .sm-library__locked-message {
    max-width: 40rem;
    margin-top: 1rem;
    font-size: 0.97rem;
    line-height: 1.6;
  }

  .sm-library__locked-panel {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .sm-library__lock-label {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #777;
  }

  .sm-library__missing-product,
  .sm-library__config-error {
    display: block;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .sm-library__missing-product {
    color: #777;
  }

  .sm-library__config-error {
    margin-top: 0.45rem;
    color: #a8324d;
    font-weight: 700;
  }

  .sm-library__admin-warning {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border-radius: 10px;
    border: 1px solid #efb7c4;
    background: #fff6f8;
    color: #8a2e45;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .sm-library__item:first-child {
    border-color: #ffd3e0;
    box-shadow: 0 8px 26px rgba(232, 64, 107, 0.08);
  }

  @media (max-width: 749px) {
    .sm-library {
      padding: 0 1rem;
    }

    .sm-library__item {
      padding: 1.1rem 1.2rem 1.3rem;
    }

    .sm-library__item-title {
      font-size: 1.05rem;
    }
  }
</style>

{% schema %}
{
  "name": "Style Masters Library",
  "tag": "section",
  "class": "style-masters-library-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Library heading",
      "default": "Style Masters Download Library"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "locked_heading",
      "label": "Heading for non-members",
      "default": "Style Masters Members Only"
    }
  ],
  "blocks": [
    {
      "type": "download",
      "name": "Monthly issue",
      "settings": [
        {
          "type": "text",
          "id": "issue_period",
          "label": "Issue month (YYYY-MM)",
          "default": "2025-11",
          "info": "Use format YYYY-MM, e.g. 2025-11 for November 2025."
        },
        {
          "type": "text",
          "id": "entitlement_code",
          "label": "Issue entitlement code",
          "info": "Used only as an internal issue identifier. Hub access is controlled by the VIP customer tag."
        },
        {
          "type": "text",
          "id": "issue_product_handle",
          "label": "Individual issue product handle",
          "info": "Used only for issue metadata. Hub access is controlled by the VIP customer tag."
        },
        {
          "type": "url",
          "id": "product_url",
          "label": "Individual issue product URL",
          "info": "Used by locked recent issue cards for the Unlock This Issue button."
        },
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Issue cover image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Month, year & theme",
          "default": "November 2025 – Power of Medium to Dark Neutrals"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description (issue info, password, notes)",
          "default": "<p>Password to watch the replay: purples</p>"
        },
        {
          "type": "header",
          "content": "Resource 1"
        },
        {
          "type": "text",
          "id": "resource_1_label",
          "label": "Button label",
          "default": "Download the Magazine"
        },
        {
          "type": "url",
          "id": "resource_1_url",
          "label": "URL (file or Vimeo link)"
        },
        {
          "type": "header",
          "content": "Resource 2"
        },
        {
          "type": "text",
          "id": "resource_2_label",
          "label": "Button label",
          "default": "Watch the Replay"
        },
        {
          "type": "url",
          "id": "resource_2_url",
          "label": "URL (file or Vimeo link)"
        },
        {
          "type": "header",
          "content": "Resource 3"
        },
        {
          "type": "text",
          "id": "resource_3_label",
          "label": "Link label",
          "default": "Download the Live Call PDF"
        },
        {
          "type": "url",
          "id": "resource_3_url",
          "label": "URL (file or Vimeo link)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Style Masters Library"
    }
  ]
}
{% endschema %}
