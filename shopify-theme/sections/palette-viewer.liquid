{% assign palette_access_string = '' %}

{% if customer %}
  {% assign palette_access_string = customer.tags | join: ',' | upcase | prepend: ',' | append: ',' %}
{% endif %}

{% assign is_trade_july_cohort = false %}
{% assign trade_july_cohort_expires_at = '2026-08-25 00:00:00 -0400' | date: '%s' %}
{% assign current_timestamp = 'now' | date: '%s' %}
{% if palette_access_string contains ',TRADEJULYCOHORT,' and current_timestamp < trade_july_cohort_expires_at %}
  {% assign is_trade_july_cohort = true %}
{% endif %}

{% if customer == nil %}
  <div class="ycs-palette-login">
    <div class="ycs-palette-login__inner">
      <p class="ycs-palette-login__kicker">Your Color Style</p>
      <h1 class="ycs-palette-login__title">Sign in to view your palette</h1>
      <p class="ycs-palette-login__text">
        Please sign in to access your digital color fan.
      </p>
      <a href="{{ routes.account_login_url }}" class="ycs-palette-login__button js-login-return-link">
        Sign In
      </a>
    </div>
  </div>
{% else %}
  <div
    class="ycs-palette-app"
    data-customer-id="{{ customer.id }}"
    data-customer-email="{{ customer.email | escape }}"
    data-default-palette="{{ section.settings.default_palette | escape }}"
    data-palette-access="{{ palette_access_string | escape }}"
    data-app-base-url="https://ycs-palette-app.vercel.app"
    data-is-admin="{% if palette_access_string contains ',YCS_ADMIN,' %}true{% else %}false{% endif %}"
    data-is-trade-july-cohort="{% if is_trade_july_cohort %}true{% else %}false{% endif %}"
    data-is-style-masters="{% if palette_access_string contains ',VIP,' %}true{% else %}false{% endif %}"
  >
    <div id="palette-unauthorized" class="ycs-palette-login" style="display:none;">
      <div class="ycs-palette-login__inner">
        <p class="ycs-palette-login__kicker">Your Color Style</p>
        <h1 class="ycs-palette-login__title">This palette is not available on your account</h1>
        <p class="ycs-palette-login__text">
          Please return to My Color Palettes to open a palette you have access to.
        </p>
        <a href="/pages/my-palettes" class="ycs-palette-login__button">
          Go to My Color Palettes
        </a>
      </div>
    </div>

    <div id="palette-authorized-content">
      <div class="ycs-palette-topnav">
        <a class="ycs-palette-nav-link" href="/pages/my-palettes">My Color Palettes</a>
        <a class="ycs-palette-nav-link" href="/pages/my-wardrobes">My Wardrobes</a>
      </div>

      <div class="ycs-palette-header">
        <p class="ycs-palette-kicker">Your Color Style Digital Color Fan</p>
        <h1 id="palette-title">Loading palette...</h1>
        <p id="palette-subtitle" class="ycs-palette-subtitle"></p>
      </div>

      <div class="ycs-palette-toolbar">
        
        <div id="palette-view-toggle" class="ycs-view-toggle">
          <button
            type="button"
            id="palette-scan-toggle"
            class="ycs-scan-toggle"
            aria-pressed="false"
            aria-label="Toggle scan view"
            title="Toggle scan view">

            <span class="ycs-icon-grid">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              </svg>
            </span>

            <span class="ycs-icon-list">
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <rect x="4" y="5" width="16" height="3" rx="1"></rect>
                <rect x="4" y="10.5" width="16" height="3" rx="1"></rect>
                <rect x="4" y="16" width="16" height="3" rx="1"></rect>
              </svg>
            </span>
          </button>
        </div>
        {% assign has_starter = false %}
{% if palette_access_string contains ',DRAPINGSTUDIOSTARTER,' %}
  {% assign has_starter = true %}
{% endif %}

{% assign has_full = false %}
{% if palette_access_string contains ',DRAPINGSTUDIO,' %}
  {% assign has_full = true %}
{% endif %}

{% assign is_sample = false %}
{% if has_starter == false and has_full == false and palette_access_string contains ',SAMPLE,' %}
  {% assign is_sample = true %}
{% endif %}

{% assign is_vip = false %}
{% if palette_access_string contains ',VIP,' %}
  {% assign is_vip = true %}
{% endif %}

{% assign is_admin = false %}
{% if palette_access_string contains ',YCS_ADMIN,' %}
  {% assign is_admin = true %}
{% endif %}

{% assign has_paid_access = false %}
{% if has_starter or has_full or is_vip or is_admin %}
  {% assign has_paid_access = true %}
{% endif %}
<a
  id="ycs-open-photo-draping"
  class="ycs-open-photo-draping-btn"
  href="{% if has_paid_access %}
/pages/photo-prep?mode=personal&workflow=photo-draping&palette={{ request.params.palette | default: section.settings.default_palette | escape }}
{% else %}
/pages/photo-prep?mode=personal&workflow=photo-draping&trial=sample&palette={{ request.params.palette | default: section.settings.default_palette | escape }}
{% endif %}">
  Draping Studio
</a>
        <div class="ycs-category-nav-wrap">
          <nav id="category-nav" class="ycs-category-nav"></nav>
        </div>
      </div>

      <div id="palette-sections" class="ycs-palette-sections"></div>

      <p id="palette-message" class="ycs-palette-message"></p>
    </div>
  </div>
{% endif %}

