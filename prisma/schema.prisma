// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model PhotoQualityEvaluation {
  id                 String               @id
  photoId            String?
  customerId         String?
  orderReference     String?
  imageUrl           String?
  secureFileReference String?
  uploadedAt         DateTime             @default(now())
  aiStatus           String
  aiScore            Int
  detectedIssuesJson String               @default("[]")
  recommendationsJson String              @default("[]")
  rawChecksJson      String               @default("{}")
  brightnessScore    Int?
  colorCast          String?
  shadowScore        Int?
  faceDetected       Boolean?
  faceCentered       Boolean?
  faceSizePercent    Float?
  glareDetected      Boolean?
  backgroundScore    Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  review             PhotoQualityReview?

  @@index([customerId])
  @@index([photoId])
  @@index([aiStatus])
  @@index([uploadedAt])
}

model PhotoQualityReview {
  id                 String                 @id
  evaluationId       String                 @unique
  photoId            String?
  aiStatus           String
  humanStatus        String?
  adminFeedback      String
  aiIssueTagsJson    String                 @default("[]")
  humanIssueTagsJson String                 @default("[]")
  adminNotes         String                 @default("")
  reviewedBy         String
  reviewedAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  evaluation         PhotoQualityEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@index([humanStatus])
  @@index([adminFeedback])
  @@index([reviewedAt])
}
